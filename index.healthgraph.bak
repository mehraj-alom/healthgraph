<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HealthGraph: your whole health in one dial</title>
<meta name="description" content="HealthGraph keeps sleep, symptoms, medicines, meals, pulse readings, and medical records in one place, then shows what they add up to.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --stage:#0B4A3F;
  --stage-deep:#07332B;
  --card:#FFFFFF;
  --ink:#14201D;
  --body:#3E4F4A;
  --muted:#7A8B85;
  --line:#E4EBE8;
  --wash:#EFF5F2;
  --cta:#0B7A55;
  --cta-pressed:#095F43;
  --teal:#4FD1C5;
  --pulse:#D7263D;
  --fog:#A7B8B2;
  --font:'Poppins',system-ui,-apple-system,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--stage);color:#fff;font-family:var(--font);overflow-x:hidden;-webkit-font-smoothing:antialiased}
::selection{background:var(--teal);color:#052E2A}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
a{color:inherit}

/* nav */
nav{position:fixed;top:0;left:0;right:0;z-index:50;background:rgba(11,74,63,.9);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,.12)}
.nav-in{max-width:1120px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;gap:26px}
.brand{font-weight:700;font-size:19px;display:flex;align-items:center;gap:10px;text-decoration:none}
.brand-mark{width:28px;height:28px;border-radius:50%;border:3px solid var(--teal);position:relative;flex:none}
.brand-mark::after{content:"";position:absolute;inset:7px;border-radius:50%;background:var(--teal)}
.nav-links{display:flex;gap:22px;margin-left:auto;font-size:14px}
.nav-links a{text-decoration:none;color:var(--fog);font-weight:500}
.nav-links a:hover{color:#fff}
.btn{display:inline-block;background:var(--cta);color:#fff;font-weight:600;font-size:15px;padding:14px 30px;border-radius:999px;text-decoration:none;border:0;cursor:pointer;transition:background .15s}
.btn:hover{background:var(--cta-pressed)}
.btn.small{padding:9px 20px;font-size:14px}
.btn.ghost{background:transparent;border:1.5px solid rgba(255,255,255,.35)}
.btn.ghost:hover{border-color:#fff;background:rgba(255,255,255,.08)}
@media(max-width:760px){.nav-links{display:none}}

/* hero */
.hero{position:relative;min-height:100svh;display:flex;align-items:flex-end;overflow:hidden}
.hero-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.45}
.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(11,74,63,.35),rgba(11,74,63,.9) 80%,var(--stage))}
.hero-in{position:relative;z-index:2;padding:140px 24px 90px;width:100%;max-width:1120px;margin:0 auto}
.hero h1{font-size:clamp(46px,8vw,104px);line-height:1.02;font-weight:700;letter-spacing:-2px;max-width:900px}
.hero h1 .ch{display:inline-block;opacity:0}
.ch.from-top{animation:chIn .7s cubic-bezier(.2,.9,.25,1.15) forwards}
.ch.from-bottom{animation:chInB .7s cubic-bezier(.2,.9,.25,1.15) forwards}
.ch.from-left{animation:chInL .7s cubic-bezier(.2,.9,.25,1.15) forwards}
.ch.from-right{animation:chInR .7s cubic-bezier(.2,.9,.25,1.15) forwards}
.ch.from-zoom{animation:chInZ .7s cubic-bezier(.2,.9,.25,1.15) forwards}
@keyframes chIn{from{opacity:0;transform:translateY(-70px) rotate(8deg)}to{opacity:1;transform:none}}
@keyframes chInB{from{opacity:0;transform:translateY(70px) rotate(-8deg)}to{opacity:1;transform:none}}
@keyframes chInL{from{opacity:0;transform:translateX(-80px)}to{opacity:1;transform:none}}
@keyframes chInR{from{opacity:0;transform:translateX(80px)}to{opacity:1;transform:none}}
@keyframes chInZ{from{opacity:0;transform:scale(.2)}to{opacity:1;transform:none}}
.hero-sub{font-size:clamp(16px,2.2vw,20px);line-height:1.65;color:#E4EBE8;max-width:600px;margin:26px 0 0;opacity:0;animation:fadeUp .8s .9s forwards}
.hero-cta{display:flex;gap:14px;margin-top:32px;flex-wrap:wrap;opacity:0;animation:fadeUp .8s 1.1s forwards}
.hero-note{margin-top:22px;font-size:13px;color:var(--fog);opacity:0;animation:fadeUp .8s 1.25s forwards}
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}

/* contents index */
.index{padding:80px 0 20px}
.index h2{font-size:clamp(28px,4vw,44px);letter-spacing:-1px;max-width:640px}
.index p{color:#E4EBE8;margin-top:14px;max-width:560px;line-height:1.7}
.index-list{margin-top:34px;border-top:1px solid rgba(255,255,255,.2)}
.index-list a{display:flex;align-items:baseline;gap:18px;padding:15px 4px;border-bottom:1px solid rgba(255,255,255,.2);text-decoration:none}
.index-list a:hover{background:rgba(255,255,255,.05)}
.index-list .n{font-size:13px;color:var(--teal);font-variant-numeric:tabular-nums;flex:none;width:26px}
.index-list .t{font-size:17px;font-weight:600}
.index-list .d{margin-left:auto;font-size:13px;color:var(--fog);text-align:right}
@media(max-width:640px){.index-list .d{display:none}}

/* scroll graph */
.scroll-graph{height:320vh;position:relative}
.sticky{position:sticky;top:0;height:100vh;display:flex;align-items:center;overflow:hidden}
.sg-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;width:100%}
.sg-copy p.k-label{font-size:14px;color:var(--teal);font-weight:600;margin-bottom:14px}
.sg-copy h2{font-size:clamp(30px,4.5vw,48px);line-height:1.12;letter-spacing:-1px}
.sg-copy p.body{margin-top:16px;color:#E4EBE8;line-height:1.75;font-size:16px;max-width:440px}
.sg-phase{margin-top:22px;display:flex;gap:10px}
.sg-dot{width:34px;height:5px;border-radius:3px;background:rgba(255,255,255,.2);transition:background .3s}
.sg-dot.on{background:var(--teal)}
#dialSvg{width:100%;max-width:440px;height:auto;margin:0 auto;display:block}
#dialSvg text{font-family:var(--font)}
@media(max-width:860px){.sg-grid{grid-template-columns:1fr}.sticky{height:auto;padding:90px 0}.scroll-graph{height:auto}#dialSvg{max-width:320px}}

/* chapters: deliberately varied rhythms */
.chapter{padding:110px 0}
.chapter .wrap{max-width:1120px}
.ch-num{font-size:15px;color:var(--teal);font-weight:600;font-variant-numeric:tabular-nums}
.chapter h2{font-size:clamp(32px,5vw,56px);letter-spacing:-1.5px;line-height:1.06;margin:16px 0 0;max-width:800px}
.chapter .lede{font-size:clamp(16px,2.2vw,20px);line-height:1.7;color:#E4EBE8;max-width:640px;margin-top:20px}
.prose-two{display:grid;grid-template-columns:1fr 1fr;gap:36px;margin-top:36px}
.prose-two p{color:#D8E5E0;line-height:1.8;font-size:15.5px}
.prose-two p+p{margin-top:0}
@media(max-width:860px){.prose-two{grid-template-columns:1fr}.chapter{padding:72px 0}}
.chapter .go{margin-top:30px}

/* full-bleed band */
.band{background:var(--card);color:var(--ink);border-radius:28px;padding:clamp(30px,5vw,64px);margin-top:44px;display:grid;grid-template-columns:1.1fr .9fr;gap:44px;align-items:center}
.band h3{font-size:clamp(24px,3vw,34px);letter-spacing:-.5px}
.band p{color:var(--body);line-height:1.75;margin-top:14px;font-size:15.5px}
.band .facts{margin-top:22px;display:grid;gap:0;border-top:1px solid var(--line)}
.band .facts div{display:flex;justify-content:space-between;gap:16px;padding:13px 2px;border-bottom:1px solid var(--line);font-size:14px}
.band .facts div span:first-child{color:var(--muted)}
.band .facts div span:last-child{font-weight:600;text-align:right}
@media(max-width:860px){.band{grid-template-columns:1fr}}

/* ledger rows */
.ledger{margin-top:40px;border-top:1px solid rgba(255,255,255,.25)}
.ledger-row{display:grid;grid-template-columns:120px 1fr auto;gap:20px;align-items:baseline;padding:22px 4px;border-bottom:1px solid rgba(255,255,255,.25)}
.ledger-row .when{font-size:13px;color:var(--fog);font-variant-numeric:tabular-nums}
.ledger-row .what{font-size:16px;font-weight:600}
.ledger-row .what small{display:block;font-weight:400;color:#D8E5E0;font-size:14px;margin-top:5px;line-height:1.65}
.ledger-row .val{font-size:16px;font-weight:600;font-variant-numeric:tabular-nums;color:var(--teal);white-space:nowrap}
@media(max-width:640px){.ledger-row{grid-template-columns:1fr auto}.ledger-row .when{grid-column:1/-1}}

/* split card + visual */
.split{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:44px;align-items:stretch}
.paper{background:var(--card);color:var(--ink);border-radius:20px;padding:36px}
.paper h3{font-size:24px;letter-spacing:-.5px}
.paper p{color:var(--body);line-height:1.75;margin-top:12px;font-size:15px}
.visual{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:20px;padding:30px;display:flex;align-items:center;justify-content:center;min-height:360px;position:relative;overflow:hidden}
@media(max-width:860px){.split{grid-template-columns:1fr}}

/* widgets */
.mock-phone{width:230px;background:#fff;border-radius:34px;padding:14px;color:var(--ink)}
.mock-screen{background:var(--wash);border-radius:24px;padding:16px;display:grid;gap:10px}
.mock-row{background:#fff;border-radius:12px;padding:10px 12px;font-size:12px;font-weight:600;display:flex;justify-content:space-between;align-items:center}
.mock-row small{color:var(--muted);font-weight:400}
.mock-cta{background:var(--cta);color:#fff;border-radius:999px;text-align:center;font-size:13px;font-weight:600;padding:11px}
.chat-mock{display:grid;gap:10px;width:100%;max-width:320px}
.bubble{border-radius:16px;padding:12px 15px;font-size:13.5px;line-height:1.6;max-width:88%}
.bubble.them{background:#fff;color:var(--ink);border-bottom-left-radius:5px}
.bubble.me{background:var(--cta);color:#fff;justify-self:end;border-bottom-right-radius:5px}
.scan-frame{width:230px;height:290px;border-radius:18px;border:2px dashed rgba(255,255,255,.5);position:relative;overflow:hidden;background:rgba(0,0,0,.25)}
.scan-line{position:absolute;left:8px;right:8px;height:3px;border-radius:2px;background:var(--teal);animation:sweep 2.4s ease-in-out infinite}
@keyframes sweep{0%,100%{top:12px}50%{top:calc(100% - 15px)}}
.scan-tag{position:absolute;bottom:12px;left:0;right:0;text-align:center;font-size:12px;font-weight:600}
.body-mock{display:flex;gap:16px;align-items:center}
.body-fig{width:110px;height:200px;border-radius:60px;background:rgba(255,255,255,.14);border:2px solid rgba(255,255,255,.4);position:relative;flex:none}
.body-fig i{position:absolute;width:16px;height:16px;border-radius:50%;background:var(--pulse)}
.body-fig i:nth-child(1){top:52px;left:30px}.body-fig i:nth-child(2){top:110px;right:24px}
.body-list{display:grid;gap:8px;font-size:13px}
.body-list div{background:#fff;color:var(--ink);border-radius:10px;padding:8px 12px;font-weight:600}
.pulse-line{width:100%;max-width:320px}

/* principles */
.principles{margin-top:40px;display:grid;gap:0;border-top:1px solid rgba(255,255,255,.25)}
.principles div{display:grid;grid-template-columns:1fr 2fr;gap:20px;padding:24px 4px;border-bottom:1px solid rgba(255,255,255,.25)}
.principles b{font-size:16px}
.principles p{color:#D8E5E0;font-size:14.5px;line-height:1.75}
@media(max-width:640px){.principles div{grid-template-columns:1fr}}

/* faq */
.faq{max-width:760px;margin:36px auto 0;display:grid;gap:12px}
.faq-item{background:var(--card);border-radius:16px;overflow:hidden}
.faq-q{width:100%;background:none;border:0;font-family:var(--font);font-size:15px;font-weight:600;color:var(--ink);text-align:left;padding:22px 24px;cursor:pointer;display:flex;justify-content:space-between;gap:12px;align-items:center}
.faq-q span:last-child{color:var(--cta);font-size:20px;flex:none;transition:transform .25s}
.faq-item.open .faq-q span:last-child{transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease}
.faq-a p{padding:0 24px 24px;font-size:14.5px;color:var(--body);line-height:1.8}

/* get */
.get{background:var(--card);color:var(--ink);border-radius:28px;padding:clamp(36px,6vw,64px) clamp(24px,5vw,56px)}
.get h2{font-size:clamp(30px,4.5vw,46px);letter-spacing:-1px;max-width:560px}
.get p.lede{color:var(--body);margin-top:16px;max-width:520px;line-height:1.75}
.get-row{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}
.store{display:inline-flex;align-items:center;gap:10px;background:var(--ink);color:#fff;border-radius:14px;padding:13px 24px;font-weight:600;font-size:15px;text-decoration:none}
.store small{display:block;font-size:10px;font-weight:400;color:#B9C6C1}
.get .fine{margin-top:22px;font-size:13px;color:var(--muted)}
.get .fine a{color:var(--cta);font-weight:600}

footer{padding:48px 0 60px;color:var(--fog);font-size:13px}
footer .cols{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;align-items:flex-start}
footer .disclaimer{max-width:620px;margin-top:16px;line-height:1.7;font-size:12px}
footer .colophon{margin-top:16px;font-size:12px}

/* reveal: opacity only, no sliding furniture */
.rv{opacity:0;transition:opacity .8s ease}
.rv.in{opacity:1}

@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001s !important;transition-duration:.001s !important}
  html{scroll-behavior:auto}
  .hero h1 .ch{opacity:1}
  .hero-sub,.hero-cta,.hero-note{opacity:1}
  .rv{opacity:1}
}
</style>
</head>
<body>

<nav>
  <div class="nav-in">
    <a class="brand" href="#top"><span class="brand-mark"></span>HealthGraph</a>
    <div class="nav-links">
      <a href="#inside">Inside</a><a href="#dial">Dial</a><a href="#promises">Promises</a><a href="#faq">FAQ</a>
    </div>
    <a class="btn small" href="#get" style="margin-left:auto">Get the app</a>
  </div>
</nav>

<header class="hero" id="top">
  <video class="hero-video" autoplay muted loop playsinline>
    <source src="../assets/app-load.mp4" type="video/mp4">
    <source src="frontend/assets/app-load.mp4" type="video/mp4">
  </video>
  <div class="hero-shade"></div>
  <div class="hero-in">
    <h1 id="heroTitle">Your whole health in one dial.</h1>
    <p class="hero-sub">HealthGraph keeps your sleep, symptoms, medicines, meals, pulse readings, and medical records in one place, then shows what they add up to across ten spokes you can scrub back through thirty days. The film playing behind these words is the actual animation the app opens with.</p>
    <div class="hero-cta">
      <a class="btn" href="#get">Get HealthGraph free</a>
      <a class="btn ghost" href="#inside">Look inside first</a>
    </div>
    <p class="hero-note">Free during early access. iOS and Android. Your data stays yours.</p>
  </div>
</header>

<div class="index wrap" id="inside">
  <h2 class="rv">Everything below lives in the app, and all of it reads from the same data.</h2>
  <p class="rv">Log something once and it shows up everywhere it matters: the dial, the timeline, the chat answers, the correlations. The list below is the whole product. Nothing on it is a mockup.</p>
  <div class="index-list rv">
    <a href="#dial"><span class="n">01</span><span class="t">The insight dial</span><span class="d">ten spokes, thirty days of scrub</span></a>
    <a href="#food"><span class="n">02</span><span class="t">Food scan</span><span class="d">a photo becomes a logged meal in about forty seconds</span></a>
    <a href="#chat"><span class="n">03</span><span class="t">Health chat</span><span class="d">answers quoted from your own records</span></a>
    <a href="#record"><span class="n">04</span><span class="t">Daily log and timeline</span><span class="d">sixty seconds of logging, a lifetime ledger</span></a>
    <a href="#pulse"><span class="n">05</span><span class="t">Pulse check</span><span class="d">fingertip or face, live trace included</span></a>
    <a href="#treatment"><span class="n">06</span><span class="t">Meds and symptom map</span><span class="d">schedules plus a body you can tap</span></a>
    <a href="#evidence"><span class="n">07</span><span class="t">3D body, graph, records</span><span class="d">walk through your own data</span></a>
  </div>
</div>

<div class="scroll-graph" id="dial">
  <div class="sticky">
    <div class="wrap sg-grid">
      <div class="sg-copy">
        <p class="k-label">01 · The insight dial</p>
        <h2>One ring. Ten signals. Your call what it shows next.</h2>
        <p class="body" id="sgText">Sleep, energy, water, stress, movement, wellbeing, pain, meals, heart, and doses each get a spoke, and each spoke sits inside its healthy band or steps outside it where you can see it happen.</p>
        <div class="sg-phase"><span class="sg-dot on"></span><span class="sg-dot"></span><span class="sg-dot"></span></div>
      </div>
      <svg id="dialSvg" viewBox="0 0 400 400" role="img" aria-label="Health dial drawing itself">
        <circle cx="200" cy="200" r="150" fill="none" stroke="rgba(255,255,255,.2)" stroke-width="26"/>
        <circle id="dialBand" cx="200" cy="200" r="150" fill="none" stroke="#4FD1C5" stroke-width="26" stroke-linecap="round" transform="rotate(-90 200 200)"/>
        <circle cx="200" cy="200" r="104" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="1.5"/>
        <circle cx="200" cy="200" r="60" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="1.5"/>
        <g id="dialSpokes" stroke="#4FD1C5" stroke-width="3" stroke-linecap="round"></g>
        <g id="dialDots" fill="#FFFFFF"></g>
        <text id="dialCenter" x="200" y="196" text-anchor="middle" fill="#fff" font-size="34" font-weight="700">8</text>
        <text x="200" y="220" text-anchor="middle" fill="#A7B8B2" font-size="13">steady</text>
      </svg>
    </div>
  </div>
</div>

<div class="chapter wrap" id="food">
  <span class="ch-num rv">02 · Food scan</span>
  <h2 class="rv">Dinner first, arithmetic second.</h2>
  <p class="lede rv">Nobody keeps a food diary for long when every entry means typing ingredients into tiny boxes. So the diary works the other way here. You frame the plate, tap once, and about forty seconds later the meal is sitting in your log with calories and macros attached, ready for you to correct.</p>
  <div class="band rv">
    <div>
      <h3>How a photo becomes a number you can trust enough to log</h3>
      <p>Vision AI names each food on the plate and judges portions against the plate itself, then a nutrition database fills in calories, protein, carbs, and fat per hundred grams. Because a photo is evidence, not measurement, the answer arrives as a range with a confidence note, and every item carries gram steppers so a heavy pour of rice takes two taps to fix. The whole exchange runs through the same authenticated backend as everything else, and logging works offline and syncs when you reconnect.</p>
      <div class="facts">
        <div><span>Typical analysis time</span><span>About 40 seconds</span></div>
        <div><span>Portion adjustment</span><span>10 gram steps, totals rescale live</span></div>
        <div><span>Nutrition source</span><span>USDA FoodData Central</span></div>
        <div><span>When unsure</span><span>A range, never a fake exact figure</span></div>
      </div>
    </div>
    <div class="visual" style="background:rgba(0,0,0,.2)">
      <div class="scan-frame"><div class="scan-line"></div><div class="scan-tag">Rice and stew · 420 to 520 kcal</div></div>
    </div>
  </div>
</div>

<div class="chapter wrap" id="chat">
  <span class="ch-num rv">03 · Health chat</span>
  <h2 class="rv">Ask the week what happened.</h2>
  <div class="prose-two">
    <p class="rv">The assistant reads before it speaks. When you ask how sleep went, it has already pulled the week of sleep points, the energy curve beside it, and anything your records say that bears on the question. Answers arrive as streamed sentences with the receipts attached: quoted lines from your own documents and, where anatomy is involved, a button that jumps straight to the structure in the 3D body.</p>
    <p class="rv">It also knows what it should not do. Doses and diagnoses are off limits, uncertainty is stated instead of smoothed over, and every reply ends with two or three follow-up questions it genuinely expects, which means most second questions cost two taps instead of a paragraph of typing.</p>
  </div>
  <div class="split">
    <div class="visual rv"><div class="chat-mock">
      <div class="bubble them">Your sleep averaged 7h 10m this week, up from 6h 20m last week. Energy followed it upward on four of seven days.</div>
      <div class="bubble me">Has my stress changed too?</div>
      <div class="bubble them">Down a full point since Monday. The timeline has the daily entries if you want them.</div>
    </div></div>
    <div class="paper rv">
      <h3>Built for the question after the question</h3>
      <p>Most health questions arrive in pairs, and the second one depends on the first answer. The chat keeps the thread, keeps the sources visible, and keeps a Stop button under your thumb the whole time a reply is generating, because a wrong-looking answer should be stoppable, not watchable.</p>
    </div>
  </div>
</div>

<div class="chapter wrap" id="record">
  <span class="ch-num rv">04 · Daily log and timeline</span>
  <h2 class="rv">Sixty seconds in, a lifetime ledger out.</h2>
  <p class="lede rv">The daily sheet is sliders and chips, almost no keyboard: mood, sleep, water, meals, activity, pain, vitals, and a notes line for anything the sliders cannot say. It validates as you go and saves locally first, so a dead zone never eats an entry. The timeline is where all of it lands, mixed with medication events and uploaded records on one chronological ledger of white day cards.</p>
  <div class="ledger rv">
    <div class="ledger-row"><span class="when">Today</span><span class="what">Evening log<small>Mood 4, pain 2, water 1.8 litres, notes about the headache after lunch.</small></span><span class="val">Saved</span></div>
    <div class="ledger-row"><span class="when">Yesterday</span><span class="what">Amtiva 5g, morning dose<small>Taken at 8:04, four minutes after the reminder.</small></span><span class="val">Taken</span></div>
    <div class="ledger-row"><span class="when">Sep 14</span><span class="what">Lipid panel, uploaded PDF<small>Extraction finished overnight. Two values flagged in place.</small></span><span class="val">Ready</span></div>
    <div class="ledger-row"><span class="when">Sep 12</span><span class="what">Face pulse check<small>72 bpm, good quality, thirty second scan.</small></span><span class="val">72</span></div>
  </div>
</div>

<div class="chapter wrap" id="pulse">
  <span class="ch-num rv">05 · Pulse check</span>
  <h2 class="rv">Two ways to take a pulse, zero wearables required.</h2>
  <div class="prose-two">
    <p class="rv">The fingertip method is the classic one: cover the camera, hold still, and watch the live waveform draw itself while the quality meter decides whether the reading counts. The face method needs nothing but light. It reads the pulse remotely from skin tone changes over about thirty seconds, which makes it the option you will actually use on an ordinary Tuesday.</p>
    <p class="rv">Both end in the same place. Results carry a quality score and heart rate variability where the signal supports it, then land on the dial as the heart spoke and in the timeline as a dated entry. A bad reading is discarded with an explanation instead of being filed as fact.</p>
  </div>
  <div class="band rv">
    <div>
      <h3>The trace is the truth serum</h3>
      <p>Any app can print a number. The live waveform is what lets you believe it, because you can see a shaky hold ruin the signal in real time and fix your grip before the result commits. That is why the trace stays on screen the whole way through instead of hiding behind a spinner.</p>
    </div>
    <div class="visual" style="background:transparent;border:0;min-height:0">
      <svg class="pulse-line" viewBox="0 0 300 90"><path id="pulsePath" d="M0 45 H70 L85 45 L95 15 L108 72 L118 30 L126 45 H300" fill="none" stroke="#4FD1C5" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>
</div>

<div class="chapter wrap" id="treatment">
  <span class="ch-num rv">06 · Meds and symptom map</span>
  <h2 class="rv">The treatment half of the record.</h2>
  <div class="split">
    <div class="paper rv">
      <h3>Schedules that survive real life</h3>
      <p>You define each medicine once with its dose, times, and days, and the day view reduces the rest to a single decision per row: taken or not. One tap stamps the time. Adherence becomes a spoke on the dial, which turns out to motivate more reliably than any reminder sentence, though the reminders stay.</p>
    </div>
    <div class="paper rv">
      <h3>A body you can point at</h3>
      <p>Thirty seven regions across front and back views, each tappable, each with a severity slider for the days a spot flares. A thirty day replay strip shows how each place behaved over the month, which is the difference between telling your doctor the shoulder hurts and showing them the four weeks it hurt.</p>
    </div>
  </div>
  <div class="split">
    <div class="visual rv"><div class="mock-phone"><div class="mock-screen">
      <div class="mock-row">Amtiva 5g <small>8:00 AM, taken</small></div>
      <div class="mock-row">Vitamin D <small>due 1:00 PM</small></div>
      <div class="mock-cta">Mark taken</div>
    </div></div></div>
    <div class="visual rv"><div class="body-mock">
      <div class="body-fig"><i></i><i></i></div>
      <div class="body-list"><div>Shoulder · 4/10</div><div>Lower back · 6/10</div><div>Knee · 2/10</div></div>
    </div></div>
  </div>
</div>

<div class="chapter wrap" id="evidence">
  <span class="ch-num rv">07 · 3D body, graph, records</span>
  <h2 class="rv">Your body of evidence, walkable.</h2>
  <p class="lede rv">Metrics become a rotatable anatomical model and a living knowledge graph, and the chat links straight into whichever structure an answer is about. Records arrive the unglamorous way, as PDFs and photos you upload, and leave as extracted values filed into the timeline with the originals one tap away in the profile drawer. Everything connects because everything reads from the same store.</p>
  <div class="go rv"><a class="btn" href="#get">Open it all in the app</a></div>
</div>

<div class="chapter wrap" id="promises">
  <span class="ch-num rv">Promises</span>
  <h2 class="rv">What we refuse to do.</h2>
  <div class="principles">
    <div class="rv"><b>No invented precision</b><p>An estimate ships with its range and its confidence, or it does not ship. Missing days show as missing days. A blank is always more honest than a plausible number.</p></div>
    <div class="rv"><b>No medical cosplay</b><p>The app spots patterns and keeps records organized. It does not diagnose, does not prescribe, and says plainly when a question belongs with a clinician.</p></div>
    <div class="rv"><b>No data market</b><p>Your logs sync to your private account for backup and are never sold. Uploaded documents are processed only to build your timeline. Sign out keeps local data on the device.</p></div>
    <div class="rv"><b>No dead ends offline</b><p>Logging, meds, the dial, and history work without a connection and sync quietly when one returns. Anything needing the network says so instead of spinning.</p></div>
  </div>
</div>

<div class="chapter wrap" id="faq" style="padding-top:20px">
  <span class="ch-num rv">Questions</span>
  <h2 class="rv">Asked often, answered plainly.</h2>
  <div class="faq">
    <div class="faq-item rv"><button class="faq-q">Is HealthGraph free?<span>+</span></button><div class="faq-a"><p>Yes, the whole app is free during early access, including food scanning, both pulse methods, and the chat. A Premium tier with deeper history and family sharing is planned for later, and early users will keep a founding discount when it arrives.</p></div></div>
    <div class="faq-item rv"><button class="faq-q">How does the food scanner estimate portions from a flat photo?<span>+</span></button><div class="faq-a"><p>It compares the food against the plate and utensils in the frame, using a standard plate size as the reference, then converts volume to grams with a density table. That is estimation, which is why every result carries a range and a confidence note, and why the gram steppers sit right under each item before you log.</p></div></div>
    <div class="faq-item rv"><button class="faq-q">Which phones can measure pulse?<span>+</span></button><div class="faq-a"><p>Any phone with a camera and flash handles fingertip readings. The face scan needs only a front camera and decent light, and takes about thirty seconds. Both show a live quality meter, and a reading that fails it is discarded with an explanation instead of being saved.</p></div></div>
    <div class="faq-item rv"><button class="faq-q">What happens to my data if I stop using the app?<span>+</span></button><div class="faq-a"><p>Signing out leaves your local data on the device, and uninstalling removes it. Your synced account keeps the backup until you ask for deletion from the account screen. Nothing is retained for advertising under any circumstance, because there is no advertising.</p></div></div>
    <div class="faq-item rv"><button class="faq-q">Can it replace my doctor?<span>+</span></button><div class="faq-a"><p>No, and it will tell you so inside the app as well. HealthGraph exists to make the patterns visible and the records organized so your appointments go further. Diagnosis and treatment stay with qualified clinicians.</p></div></div>
  </div>
</div>

<div class="chapter wrap" id="get" style="padding-top:20px">
  <div class="get rv">
    <h2>Get HealthGraph while it is free.</h2>
    <p class="lede">One account across iOS and Android, with history everywhere you sign in. Tap below and an email opens, addressed and ready. Send it and we reply with your invite link.</p>
    <div class="get-row">
      <a class="store" href="mailto:hello@healthgraph.app?subject=HealthGraph%20early%20access"><span><small>Get it on</small>App Store</span></a>
      <a class="store" href="mailto:hello@healthgraph.app?subject=HealthGraph%20early%20access"><span><small>Get it on</small>Google Play</span></a>
    </div>
    <p class="fine">One email from you, one invite back from us. No newsletter, no drip campaign, unsubscribe by replying stop.</p>
  </div>
</div>

<footer>
  <div class="wrap">
    <div class="cols">
      <a class="brand" href="#top"><span class="brand-mark"></span>HealthGraph</a>
      <div class="colophon">Set in Poppins. One HTML file, no trackers, no cookies.<br>© <span id="year">2026</span> HealthGraph.</div>
    </div>
    <p class="disclaimer">HealthGraph is a wellness companion, not a medical device. Everything on this page and in the app is informational only and never medical advice, diagnosis, or treatment. Consult a qualified clinician about any health concern.</p>
  </div>
</footer>

<script>
// hero: characters arrive from different sides, one orchestrated moment
(function(){
  var h = document.getElementById('heroTitle');
  var text = h.textContent;
  h.textContent = '';
  var dirs = ['from-top','from-bottom','from-left','from-right','from-zoom'];
  for (var i = 0; i < text.length; i++) {
    var c = text[i];
    if (c === ' ') { h.appendChild(document.createTextNode(' ')); continue; }
    var s = document.createElement('span');
    s.className = 'ch ' + dirs[(i * 7 + 3) % dirs.length];
    s.style.animationDelay = (0.05 + i * 0.028) + 's';
    s.textContent = c;
    h.appendChild(s);
  }
})();

// reveal: opacity only
(function(){
  var els = document.querySelectorAll('.rv');
  if (!('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('in'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
    });
  }, { threshold: 0.1 });
  els.forEach(function(e){ io.observe(e); });
})();

// scroll-driven dial
(function(){
  var section = document.querySelector('.scroll-graph');
  var band = document.getElementById('dialBand');
  var spokesG = document.getElementById('dialSpokes');
  var dotsG = document.getElementById('dialDots');
  var center = document.getElementById('dialCenter');
  var sgText = document.getElementById('sgText');
  var dots = document.querySelectorAll('.sg-dot');
  var C = 2 * Math.PI * 150;
  band.style.strokeDasharray = C;
  band.style.strokeDashoffset = C;
  var N = 10, built = false;
  function build(){
    if (built) return; built = true;
    for (var i = 0; i < N; i++) {
      var a = -Math.PI / 2 + (2 * Math.PI * i) / N;
      var x1 = 200 + 104 * Math.cos(a), y1 = 200 + 104 * Math.sin(a);
      var r = 104 + [46, 30, 52, 22, 40, 48, 18, 36, 44, 28][i] * 0.9;
      var x2 = 200 + Math.min(r, 148) * Math.cos(a), y2 = 200 + Math.min(r, 148) * Math.sin(a);
      var ln = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      ln.setAttribute('x1', x1); ln.setAttribute('y1', y1);
      ln.setAttribute('x2', x2); ln.setAttribute('y2', y2);
      var len = Math.hypot(x2 - x1, y2 - y1);
      ln.style.strokeDasharray = len; ln.style.strokeDashoffset = len;
      ln.dataset.len = len;
      spokesG.appendChild(ln);
      var c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('cx', x2); c.setAttribute('cy', y2); c.setAttribute('r', 6);
      c.style.opacity = 0;
      dotsG.appendChild(c);
    }
  }
  var phases = [
    'Sleep, energy, water, stress, movement, wellbeing, pain, meals, heart, and doses each get a spoke, and each spoke sits inside its healthy band or steps outside it where you can see it happen.',
    'Scroll and the ring draws itself. Every spoke lands where the latest logs would put it. The count in the middle is simply how many spokes sit inside their bands right now.',
    'This is the same dial that lives in the app, replaying any of the last thirty days from the slider under it. The chapters below walk through everything feeding it.'
  ];
  function onScroll(){
    var rect = section.getBoundingClientRect();
    var total = section.offsetHeight - window.innerHeight;
    var p = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
    build();
    band.style.strokeDashoffset = C * (1 - Math.min(1, p * 1.6));
    var sp = Math.min(1, Math.max(0, (p - 0.15) / 0.6));
    var lines = spokesG.childNodes, cs = dotsG.childNodes;
    for (var i = 0; i < lines.length; i++) {
      var q = Math.min(1, Math.max(0, sp * lines.length - i));
      lines[i].style.strokeDashoffset = lines[i].dataset.len * (1 - q);
      cs[i].style.opacity = q;
    }
    center.textContent = Math.round(4 + p * 4);
    var ph = Math.min(2, Math.floor(p * 3));
    if (sgText.dataset.ph !== String(ph)) {
      sgText.dataset.ph = ph;
      sgText.textContent = phases[ph];
      dots.forEach(function(d, j){ d.classList.toggle('on', j === ph); });
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();

// pulse line draw loop
(function(){
  var p = document.getElementById('pulsePath');
  if (!p) return;
  var len = p.getTotalLength();
  p.style.strokeDasharray = len;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { p.style.strokeDashoffset = 0; return; }
  var t0 = null;
  function tick(t){
    if (!t0) t0 = t;
    p.style.strokeDashoffset = len * (1 - (((t - t0) % 2600) / 2600));
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();

// faq accordion: one open at a time
document.querySelectorAll('.faq-item').forEach(function(item){
  var q = item.querySelector('.faq-q'), a = item.querySelector('.faq-a');
  q.addEventListener('click', function(){
    var open = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(function(o){
      o.classList.remove('open'); o.querySelector('.faq-a').style.maxHeight = null;
    });
    if (!open) { item.classList.add('open'); a.style.maxHeight = a.scrollHeight + 'px'; }
  });
});

document.getElementById('year').textContent = new Date().getFullYear();
</script>
</body>
</html>
