# HealthGraph production environment template → /opt/healthgraph/backend.env
#
# HOW TO USE (on the VPS, never in git):
#   1. cp deploy/backend.env.example /opt/healthgraph/backend.env
#   2. Fill every YOUR_* value. Generate secrets with:
#        python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   3. chmod 600 /opt/healthgraph/backend.env && chown deploy:deploy ...
#   4. Place Firebase service-account JSON at
#      /opt/healthgraph/firebase_credentials.json (0600).
# NEVER commit the filled file. NEVER echo secrets into shell history —
# paste via an editor, and keep this template free of real values.

# --- Application ---
APP_ENV="production"
GOOGLE_CLOUD_PROJECT="YOUR_GCP_PROJECT_ID"
secret_key="YOUR_SECRET_KEY_48B64"
DOC_ENCRYPTION_KEY="YOUR_BASE64_32B_KEY"
RATE_LIMIT_TRUST_PROXY_HEADERS="False"
PORT="8000"

# --- Firebase Admin SDK (file path; JSON lives at the ro mount) ---
FIREBASE_CREDENTIALS_PATH="/app/firebase_credentials.json"
# FIREBASE_CREDENTIALS_JSON intentionally unset (file delivery).

# --- HealthGraph PostgreSQL (SEPARATE container, never analytics-db-1) ---
POSTGRES_USER="healthgraph"
POSTGRES_PASSWORD="YOUR_PG_PASSWORD_32"
POSTGRES_DB="healthgraph"
DATABASE_URL="postgresql://healthgraph:YOUR_PG_PASSWORD_32@db:5432/healthgraph?sslmode=disable"
ASYNC_DATABASE_URL="postgresql+asyncpg://healthgraph:YOUR_PG_PASSWORD_32@db:5432/healthgraph"

# --- Celery / Redis (internal service names, no ports published) ---
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# --- Neo4j Aura (external, managed) ---
NEO4J_URI="neo4j+s://YOUR_HOST.databases.neo4j.io:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="YOUR_NEO4J_PASSWORD"

# --- Qdrant Cloud (external) — omit to run degraded (search off) ---
QDRANT_URL="https://YOUR_QDRANT_CLOUD_URL:6333"
QDRANT_API_KEY="YOUR_QDRANT_API_KEY"
QDRANT_COLLECTION_NAME="healthgraph-collection"

# --- LLMs (omit any to degrade that feature to 503; API still boots) ---
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="z-ai/glm-5.2:free"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_API_BASE="https://api.aicredits.in/v1"
EMBEDDING_BASE_URL="https://api.aicredits.in/v1"
AICREDITS_API_KEY="YOUR_AICREDITS_API_KEY"
AICREDITS_BASE_URL="https://api.aicredits.in/v1"
AICREDITS_MODEL="openai/gpt-4o"
USDA_API_KEY="YOUR_USDA_API_KEY"

# --- Document OCR / extraction (pin dated models in production) ---
VISION_AGENT_API_KEY="YOUR_VISION_AGENT_API_KEY"
LANDINGAI_API_KEY="YOUR_LANDINGAI_API_KEY"
ADE_CLASSIFY_MODEL="classify-latest"
ADE_EXTRACTION_MODEL="dpt-3-pro-latest"
EXTRACTION_PROMPT_HASH=""
GRAPH_CONCEPT_EDGES_ENABLED="false"

# --- CORS (browser clients only; mobile ignores it) ---
# Comma-separated https origins that may call the API, or empty for deny-all.
CORS_ORIGINS=""

# --- Storage scratch (ephemeral; durable bytes live in PostgreSQL) ---
STORAGE_DIR="/app/storage/documents"

# --- Pakeet STT sidecar (Phase 5 voice transport) ---
# Internal compose-network URL only (the sidecar publishes no ports).
# Default in core/config.py is http://pakeet:8477; set only to point at an
# equivalent non-public sidecar.
# PAKEET_URL="http://pakeet:8477"
