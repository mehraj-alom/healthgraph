      "html": "<style>\n  :root{\n    --page-bg:#eef1ef;\n    --screen-bg:#fbfbf9;\n    --text-primary:#1c231f;\n    --text-secondary:#68716b;\n    --text-tertiary:#9aa39c;\n    --divider:#e6e8e4;\n\n    --accent:#0f8f72;        /* primary teal-green */\n    --accent-soft:#e4f4ee;   /* pale teal tint */\n    --accent-dark:#0b6c56;\n    --warn:#d97b3f;          /* warm terracotta for over-budget */\n    --card-bg:#f1f3ef;\n\n    --radius-lg:26px;\n    --radius-md:18px;\n    --radius-pill:999px;\n\n    --font-sans: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    background:var(--page-bg);\n    font-family:var(--font-sans);\n    display:flex;\n    justify-content:center;\n    padding:40px 16px 64px;\n    min-height:100vh;\n    color:var(--text-primary);\n  }\n\n  .phone-shell{\n    width:100%;\n    max-width:430px;\n    background:var(--screen-bg);\n    border-radius:44px;\n    padding:0 0 28px;\n    box-shadow:0 30px 60px -20px rgba(20,30,25,0.25), 0 0 0 10px #101512;\n    overflow:hidden;\n    position:relative;\n  }\n\n  /* Status bar */\n  .status-bar{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:18px 26px 6px;\n    font-size:15px;\n    font-weight:600;\n    letter-spacing:0.2px;\n  }\n  .status-icons{display:flex;align-items:center;gap:6px;}\n  .status-icons svg{display:block;}\n\n  /* Nav row */\n  .nav-row{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:10px 18px 12px;\n  }\n  .icon-btn{\n    width:36px;height:36px;\n    border-radius:50%;\n    border:none;\n    background:transparent;\n    color:var(--accent);\n    display:flex;align-items:center;justify-content:center;\n    cursor:pointer;\n    flex:0 0 auto;\n  }\n  .nav-row h1{\n    margin:0;\n    font-size:19px;\n    font-weight:700;\n    letter-spacing:-0.2px;\n  }\n\n  /* Hero photo */\n  .hero-photo{\n    position:relative;\n    width:100%;\n    aspect-ratio:1/0.92;\n    background:#e8dcc4 url('https://images.unsplash.com/photo-1640767485112-02da9fd009c6?q=80&w=800') center/cover no-repeat;\n    overflow:hidden;\n  }\n  .plate,.toast,.berry-pile{ display:none; }\n  .plate{\n    position:absolute;\n    left:50%; top:52%;\n    width:78%; aspect-ratio:1/1;\n    transform:translate(-50%,-50%);\n    border-radius:50%;\n    background:\n      radial-gradient(circle at 50% 50%, #ffffff 0%, #ffffff 62%, #f1efe9 64%, #ffffff 66%, #ffffff 100%);\n    box-shadow:0 18px 40px -16px rgba(40,30,10,0.35);\n  }\n  .toast{\n    position:absolute;\n    left:50%; top:66%;\n    width:64%; height:34%;\n    transform:translate(-50%,-50%);\n    background:linear-gradient(160deg,#e0ac66,#c98f45);\n    border-radius:50% 50% 46% 46% / 60% 60% 40% 40%;\n    box-shadow:inset 0 -6px 10px rgba(120,70,15,0.25);\n  }\n  .berry-pile{\n    position:absolute;\n    left:50%; top:36%;\n    width:52%; height:26%;\n    transform:translate(-50%,-50%);\n    background:radial-gradient(circle at 30% 30%, #6a3b8f, transparent 55%),\n               radial-gradient(circle at 60% 55%, #7d4aa3, transparent 55%),\n               radial-gradient(circle at 45% 70%, #5a3178, transparent 55%);\n    border-radius:50%;\n    filter:saturate(1.1);\n  }\n  .cam-btn{\n    position:absolute;\n    right:20px; bottom:20px;\n    width:52px;height:52px;\n    border-radius:50%;\n    background:rgba(28,35,31,0.55);\n    backdrop-filter:blur(4px);\n    display:flex;align-items:center;justify-content:center;\n    color:#fff;\n    border:1.5px solid rgba(255,255,255,0.5);\n  }\n\n  /* Macro summary row */\n  .macro-row{\n    display:flex;\n    padding:22px 20px 18px;\n    gap:6px;\n  }\n  .macro-item{\n    flex:1;\n    text-align:center;\n  }\n  .macro-item .val{\n    font-size:21px;\n    font-weight:800;\n    letter-spacing:-0.3px;\n  }\n  .macro-item .lbl{\n    margin-top:4px;\n    font-size:13px;\n    color:var(--text-secondary);\n    font-weight:500;\n  }\n\n  /* Food item list */\n  .food-list{\n    padding:2px 20px 6px;\n  }\n  .food-row{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:16px 0;\n    border-bottom:1px solid var(--divider);\n  }\n  .food-row:last-child{border-bottom:none;}\n  .food-main h3{\n    margin:0 0 4px;\n    font-size:17px;\n    font-weight:700;\n  }\n  .food-main p{\n    margin:0;\n    font-size:13.5px;\n    color:var(--text-secondary);\n  }\n  .food-cal{\n    display:flex;\n    align-items:center;\n    gap:6px;\n    flex:0 0 auto;\n    padding-left:12px;\n  }\n  .food-cal span{\n    font-size:16px;\n    font-weight:700;\n    color:var(--text-primary);\n    white-space:nowrap;\n  }\n  .food-cal svg{color:var(--text-tertiary);}\n\n  /* Nutrition facts */\n  .section-heading{\n    margin:20px 20px 12px;\n    font-size:21px;\n    font-weight:800;\n    letter-spacing:-0.3px;\n  }\n  .facts-card{\n    margin:0 20px 8px;\n    background:var(--card-bg);\n    border-radius:var(--radius-lg);\n    padding:22px 20px 26px;\n    position:relative;\n  }\n  .fact-row{margin-bottom:22px;}\n  .fact-row:last-child{margin-bottom:0;}\n  .fact-top{\n    display:flex;\n    justify-content:space-between;\n    align-items:baseline;\n    margin-bottom:9px;\n    font-size:15.5px;\n  }\n  .fact-top .name{font-weight:600;color:var(--text-primary);}\n  .fact-top .amt{font-weight:600;color:var(--text-secondary);}\n  .fact-top .amt b{color:var(--text-primary);font-weight:700;}\n  .bar-track{\n    width:100%;\n    height:9px;\n    border-radius:var(--radius-pill);\n    background:#e2e5e0;\n    overflow:hidden;\n  }\n  .bar-fill{\n    height:100%;\n    border-radius:var(--radius-pill);\n    background:var(--accent);\n  }\n  .bar-fill.over{background:var(--warn);}\n\n  /* Floating CTA */\n  .fab-wrap{\n    position:relative;\n    padding:6px 20px 0;\n  }\n  .fab{\n    position:relative;\n    margin-top:-38px;\n    width:100%;\n    border:none;\n    background:var(--accent);\n    color:#fff;\n    font-family:inherit;\n    font-size:17px;\n    font-weight:700;\n    padding:17px 0;\n    border-radius:var(--radius-pill);\n    box-shadow:0 14px 26px -10px rgba(15,143,114,0.55);\n    cursor:pointer;\n    display:block;\n  }\n</style>\n<style>\n  /* iOS gallery frame normalization — pins the device frame to a uniform size. */\n  html, body { min-height: 100vh; }\n  body > div {\n    box-sizing: border-box !important;\n    width: 430px !important;\n    min-width: 430px !important;\n    max-width: 430px !important;\n    height: 932px !important;\n    min-height: 932px !important;\n    max-height: 932px !important;\n    aspect-ratio: auto !important;\n    overflow: hidden !important;\n    flex: 0 0 auto !important;\n    flex-shrink: 0 !important;\n    /* Flatten the device bezel so the screenshot is a clean square with no\n       rounded-corner black wedges — the gallery UI adds the rounding. */\n    border: 0 !important;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n  }\n</style>\n\n<div class=\"phone-shell\" data-kid=\"0\">\n\n  \n  <div class=\"status-bar\" data-kid=\"1\">\n    <span data-kid=\"2\">9:41</span>\n    <div class=\"status-icons\" data-kid=\"3\">\n      <svg width=\"18\" height=\"12\" viewBox=\"0 0 18 12\" fill=\"none\" data-kid=\"4\"><rect x=\"0\" y=\"7\" width=\"3\" height=\"5\" rx=\"0.8\" fill=\"currentColor\" data-kid=\"5\"></rect><rect x=\"5\" y=\"5\" width=\"3\" height=\"7\" rx=\"0.8\" fill=\"currentColor\" data-kid=\"6\"></rect><rect x=\"10\" y=\"3\" width=\"3\" height=\"9\" rx=\"0.8\" fill=\"currentColor\" data-kid=\"7\"></rect><rect x=\"15\" y=\"0\" width=\"3\" height=\"12\" rx=\"0.8\" fill=\"currentColor\" data-kid=\"8\"></rect></svg>\n      <svg width=\"17\" height=\"12\" viewBox=\"0 0 17 12\" fill=\"none\" data-kid=\"9\"><path d=\"M8.5 10.6c.66 0 1.2-.53 1.2-1.2 0-.66-.54-1.2-1.2-1.2-.67 0-1.2.54-1.2 1.2 0 .67.53 1.2 1.2 1.2Z\" fill=\"currentColor\" data-kid=\"10\"></path><path d=\"M5.4 7.2a4.7 4.7 0 0 1 6.2 0\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" data-kid=\"11\"></path><path d=\"M2.8 4.5a8.5 8.5 0 0 1 11.4 0\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" data-kid=\"12\"></path></svg>\n      <svg width=\"25\" height=\"12\" viewBox=\"0 0 25 12\" fill=\"none\" data-kid=\"13\"><rect x=\"1\" y=\"1\" width=\"20\" height=\"10\" rx=\"2.5\" stroke=\"currentColor\" stroke-width=\"1\" data-kid=\"14\"></rect><rect x=\"2.5\" y=\"2.5\" width=\"16\" height=\"7\" rx=\"1.2\" fill=\"currentColor\" data-kid=\"15\"></rect><rect x=\"22\" y=\"4\" width=\"1.6\" height=\"4\" rx=\"0.8\" fill=\"currentColor\" data-kid=\"16\"></rect></svg>\n    </div>\n  </div>\n\n  \n  <div class=\"nav-row\" data-kid=\"17\">\n    <button class=\"icon-btn\" aria-label=\"Back\" data-kid=\"18\">\n      <svg width=\"12\" height=\"20\" viewBox=\"0 0 12 20\" fill=\"none\" data-kid=\"19\"><path d=\"M10.5 1.5 1.5 10l9 8.5\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"20\"></path></svg>\n    </button>\n    <h1 data-kid=\"21\">Breakfast</h1>\n    <button class=\"icon-btn\" aria-label=\"Edit entry\" data-kid=\"22\">\n      <svg width=\"19\" height=\"19\" viewBox=\"0 0 19 19\" fill=\"none\" data-kid=\"23\"><path d=\"M13.4 1.9 17 5.5 6.3 16.2 1.8 17.1l.9-4.5L13.4 1.9Z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\" data-kid=\"24\"></path></svg>\n    </button>\n  </div>\n\n  \n  <div class=\"hero-photo\" role=\"img\" aria-label=\"Bowl of oatmeal with berries — Cosmin Ursea on Unsplash\" data-kid=\"25\">\n    <div class=\"plate\" data-kid=\"26\"></div>\n    <div class=\"berry-pile\" data-kid=\"27\"></div>\n    <div class=\"toast\" data-kid=\"28\"></div>\n    <div class=\"cam-btn\" data-kid=\"29\">\n      <svg width=\"22\" height=\"19\" viewBox=\"0 0 22 19\" fill=\"none\" data-kid=\"30\"><path d=\"M7.5 1.5h7l1.3 2.3H19a1.5 1.5 0 0 1 1.5 1.5v11.2A1.5 1.5 0 0 1 19 18H3a1.5 1.5 0 0 1-1.5-1.5V5.3A1.5 1.5 0 0 1 3 3.8h3.2L7.5 1.5Z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\" data-kid=\"31\"></path><circle cx=\"11\" cy=\"10.5\" r=\"4\" stroke=\"currentColor\" stroke-width=\"1.6\" data-kid=\"32\"></circle></svg>\n    </div>\n  </div>\n\n  \n  <div class=\"macro-row\" data-kid=\"33\">\n    <div class=\"macro-item\" data-kid=\"34\">\n      <div class=\"val\" data-kid=\"35\">410 Cal</div>\n      <div class=\"lbl\" data-kid=\"36\">Calories</div>\n    </div>\n    <div class=\"macro-item\" data-kid=\"37\">\n      <div class=\"val\" data-kid=\"38\">61 g</div>\n      <div class=\"lbl\" data-kid=\"39\">Carbs</div>\n    </div>\n    <div class=\"macro-item\" data-kid=\"40\">\n      <div class=\"val\" data-kid=\"41\">10.4 g</div>\n      <div class=\"lbl\" data-kid=\"42\">Protein</div>\n    </div>\n    <div class=\"macro-item\" data-kid=\"43\">\n      <div class=\"val\" data-kid=\"44\">15.2 g</div>\n      <div class=\"lbl\" data-kid=\"45\">Fat</div>\n    </div>\n  </div>\n\n  \n  <div class=\"food-list\" data-kid=\"46\">\n    <div class=\"food-row\" data-kid=\"47\">\n      <div class=\"food-main\" data-kid=\"48\">\n        <h3 data-kid=\"49\">Steel-Cut Oats</h3>\n        <p data-kid=\"50\">1 cup, cooked (240 g)</p>\n      </div>\n      <div class=\"food-cal\" data-kid=\"51\">\n        <span data-kid=\"52\">260 Cal</span>\n        <svg width=\"7\" height=\"12\" viewBox=\"0 0 7 12\" fill=\"none\" data-kid=\"53\"><path d=\"M1 1l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"54\"></path></svg>\n      </div>\n    </div>\n    <div class=\"food-row\" data-kid=\"55\">\n      <div class=\"food-main\" data-kid=\"56\">\n        <h3 data-kid=\"57\">Almond Butter</h3>\n        <p data-kid=\"58\">2 tbsp (32 g)</p>\n      </div>\n      <div class=\"food-cal\" data-kid=\"59\">\n        <span data-kid=\"60\">150 Cal</span>\n        <svg width=\"7\" height=\"12\" viewBox=\"0 0 7 12\" fill=\"none\" data-kid=\"61\"><path d=\"M1 1l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"62\"></path></svg>\n      </div>\n    </div>\n  </div>\n\n  \n  <h2 class=\"section-heading\" data-kid=\"63\">Nutrition Facts</h2>\n  <div class=\"facts-card\" data-kid=\"64\">\n    <div class=\"fact-row\" data-kid=\"65\">\n      <div class=\"fact-top\" data-kid=\"66\"><span class=\"name\" data-kid=\"67\">Calories</span><span class=\"amt\" data-kid=\"68\"><b data-kid=\"69\">410</b> / 520 Cal</span></div>\n      <div class=\"bar-track\" data-kid=\"70\"><div class=\"bar-fill\" style=\"width:79%\" data-kid=\"71\"></div></div>\n    </div>\n    <div class=\"fact-row\" data-kid=\"72\">\n      <div class=\"fact-top\" data-kid=\"73\"><span class=\"name\" data-kid=\"74\">Carbs</span><span class=\"amt\" data-kid=\"75\"><b data-kid=\"76\">61</b> / 55 g</span></div>\n      <div class=\"bar-track\" data-kid=\"77\"><div class=\"bar-fill over\" style=\"width:100%\" data-kid=\"78\"></div></div>\n    </div>\n    <div class=\"fact-row\" data-kid=\"79\">\n      <div class=\"fact-top\" data-kid=\"80\"><span class=\"name\" data-kid=\"81\">Protein</span><span class=\"amt\" data-kid=\"82\"><b data-kid=\"83\">10</b> / 30 g</span></div>\n      <div class=\"bar-track\" data-kid=\"84\"><div class=\"bar-fill\" style=\"width:33%\" data-kid=\"85\"></div></div>\n    </div>\n    <div class=\"fact-row\" data-kid=\"86\">\n      <div class=\"fact-top\" data-kid=\"87\"><span class=\"name\" data-kid=\"88\">Fat</span><span class=\"amt\" data-kid=\"89\"><b data-kid=\"90\">15</b> / 20 g</span></div>\n      <div class=\"bar-track\" data-kid=\"91\"><div class=\"bar-fill\" style=\"width:75%\" data-kid=\"92\"></div></div>\n    </div>\n  </div>\n\n  \n  <div class=\"fab-wrap\" data-kid=\"93\">\n    <button class=\"fab\" data-kid=\"94\">Add more</button>\n  </div>\n\n</div>\n",
