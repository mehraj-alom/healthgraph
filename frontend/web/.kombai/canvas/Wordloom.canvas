      "html": "<style>\n  :root{\n    --ink:#1c1b1f;\n    --page-bg:#e9e5f2;\n    --sheet-bg:#f3e7de;\n    --card-bg:#ffffff;\n    --primary:#6c5ce7;\n    --primary-soft:#ded7fb;\n    --primary-line:#4a3fc4;\n    --accent-flame:#ff7a45;\n    --accent-flame-soft:#ffd9c6;\n    --muted:#a39da8;\n    --muted-bg:#e7e3ec;\n    --border:#1c1b1f;\n    --radius-lg:28px;\n    --radius-md:22px;\n    --radius-sm:16px;\n    --shadow-x:5px;\n    --shadow-y:6px;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    background:\n      radial-gradient(circle at 15% 10%, #f4f1fa 0%, transparent 45%),\n      radial-gradient(circle at 85% 90%, #e0d9f5 0%, transparent 50%),\n      var(--page-bg);\n    min-height:100vh;\n    display:flex;\n    align-items:flex-start;\n    justify-content:center;\n    padding:40px 16px;\n    color:var(--ink);\n    -webkit-font-smoothing:antialiased;\n  }\n\n  .device{\n    width:100%;\n    max-width:430px;\n    background:#cfc9dd;\n    border-radius:52px;\n    padding:14px;\n    box-shadow:0 30px 60px -20px rgba(28,27,31,0.35);\n  }\n\n  .screen{\n    background:var(--sheet-bg);\n    border-radius:40px;\n    overflow:hidden;\n    position:relative;\n    min-height:640px;\n  }\n\n  /* status bar */\n  .statusbar{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:18px 30px 6px;\n    font-weight:700;\n    font-size:17px;\n    letter-spacing:-0.2px;\n  }\n  .statusbar .icons{display:flex; align-items:center; gap:6px;}\n\n  /* sheet header */\n  .sheet-top{\n    background:var(--sheet-bg);\n    border-radius:0 0 32px 32px;\n    padding:18px 22px 26px;\n    position:relative;\n  }\n  .close-btn{\n    width:44px;height:44px;border-radius:50%;\n    background:#fbf5ee;\n    border:2px solid var(--border);\n    display:flex;align-items:center;justify-content:center;\n    position:absolute; top:18px; left:20px;\n    box-shadow: 3px 3px 0 var(--border);\n  }\n  .sheet-title{\n    text-align:center;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size:30px;\n    font-weight:700;\n    padding-top:10px;\n    letter-spacing:-0.3px;\n  }\n\n  .content{\n    padding:16px 18px 26px;\n    display:flex;\n    flex-direction:column;\n    gap:16px;\n  }\n\n  .card{\n    background:var(--card-bg);\n    border:2px solid var(--border);\n    border-radius:var(--radius-md);\n    box-shadow: var(--shadow-x) var(--shadow-y) 0 var(--border);\n  }\n\n  /* score row card */\n  .score-card{\n    display:flex;\n    align-items:center;\n    gap:16px;\n    padding:16px 18px;\n    cursor:pointer;\n  }\n  .score-icon{\n    width:52px;height:52px;\n    flex-shrink:0;\n    display:flex;align-items:center;justify-content:center;\n  }\n  .score-text{flex:1;}\n  .score-main{\n    font-size:22px;\n    font-weight:800;\n    line-height:1.1;\n  }\n  .score-sub{\n    font-size:15px;\n    color:#3a3640;\n    margin-top:2px;\n  }\n  .score-sub .date{color:var(--muted); font-weight:500;}\n  .chev{flex-shrink:0; opacity:0.55;}\n\n  /* streak card */\n  .streak-card{\n    padding:18px 18px 20px;\n  }\n  .streak-head{\n    display:flex;\n    align-items:center;\n    gap:14px;\n  }\n  .flame-wrap{\n    position:relative;\n    width:64px;height:64px;\n    flex-shrink:0;\n    display:flex;align-items:center;justify-content:center;\n  }\n  .flame-num{\n    position:absolute;\n    font-size:19px;\n    font-weight:800;\n    color:var(--ink);\n    top:52%;\n    transform:translateY(-38%);\n  }\n  .streak-title{\n    font-size:21px;\n    font-weight:800;\n    flex:1;\n  }\n  .streak-actions{display:flex; gap:14px; align-items:center; color:#8a8590;}\n\n  .streak-days{\n    display:grid;\n    grid-template-columns:repeat(7,1fr);\n    gap:8px;\n    margin-top:16px;\n    text-align:center;\n  }\n  .day-col{display:flex; flex-direction:column; align-items:center; gap:8px;}\n  .day-label{font-size:13px; font-weight:700; color:var(--ink);}\n  .day-label.dim{color:var(--muted); font-weight:600;}\n  .day-badge{\n    width:38px;height:38px;\n    border-radius:50%;\n    display:flex;align-items:center;justify-content:center;\n  }\n  .day-badge.done{\n    background:var(--primary-soft);\n    border:2px solid var(--primary-line);\n    color:var(--primary-line);\n  }\n  .day-badge.pending{\n    background:var(--muted-bg);\n  }\n\n  /* 2x2 stat grid */\n  .stat-grid{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    gap:14px;\n  }\n  .stat-card{\n    padding:20px 18px 18px;\n    display:flex;\n    flex-direction:column;\n    gap:26px;\n  }\n  .stat-top{\n    display:flex;\n    align-items:flex-start;\n    justify-content:space-between;\n  }\n  .stat-num{\n    font-size:28px;\n    font-weight:800;\n  }\n  .stat-label{\n    font-size:15px;\n    color:#3a3640;\n    font-weight:600;\n  }\n\n  /* rank card */\n  .rank-card{\n    padding:22px 20px 26px;\n  }\n  .rank-title{\n    font-size:23px;\n    font-weight:800;\n    line-height:1.25;\n    max-width:85%;\n  }\n  .rank-sub{\n    font-size:15px;\n    color:#4a4550;\n    margin-top:6px;\n  }\n  .bell-wrap{\n    margin-top:18px;\n    position:relative;\n  }\n  .bell-wrap svg{width:100%; height:auto; display:block;}\n  .cta-btn{\n    display:block;\n    width:100%;\n    margin-top:18px;\n    padding:16px 0;\n    text-align:center;\n    background:var(--primary);\n    color:#fff;\n    font-size:17px;\n    font-weight:800;\n    border:2px solid var(--border);\n    border-radius:999px;\n    box-shadow: 4px 5px 0 var(--border);\n    cursor:pointer;\n  }\n\n  @media (max-width:400px){\n    .sheet-title{font-size:26px;}\n    .rank-title{font-size:20px; max-width:100%;}\n  }\n</style>\n<style>\n  /* iOS gallery frame normalization — pins the device frame to a uniform size. */\n  html, body { min-height: 100vh; }\n  body > div {\n    box-sizing: border-box !important;\n    width: 430px !important;\n    min-width: 43