      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Instrument+Serif:ital@1&display=swap');\n:root{\n  --stage:#0B4A3F; --stage-deep:#07332B; --card:#FFFFFF; --ink:#14201D; --body:#3E4F4A;\n  --muted:#7A8B85; --line:#E4EBE8; --wash:#EFF5F2; --cta:#0B7A55; --teal:#4FD1C5;\n  --pulse:#D7263D; --fog:#A7B8B2; --serif:'Instrument Serif','Times New Roman',serif; --sans:'Poppins',system-ui,sans-serif;\n}\n.hg-page,.hg-page *{box-sizing:border-box}\n.hg-page{background:var(--stage);color:#fff;font-family:var(--sans);font-size:15px;line-height:1.6;overflow:hidden;-webkit-font-smoothing:antialiased}\n.hg-page a{color:inherit;text-decoration:none}.hg-page button{font:inherit}.hg-page img,.hg-page video{display:block;max-width:100%}\n.hg-wrap{width:min(1120px,calc(100% - 48px));margin:0 auto}\n.hg-nav{position:sticky;top:0;z-index:20;background:rgba(11,74,63,.94);border-bottom:1px solid rgba(255,255,255,.16);backdrop-filter:blur(16px)}\n.hg-nav-in{min-height:70px;display:flex;align-items:center;gap:28px}\n.hg-brand{display:inline-flex;align-items:center;gap:10px;font-size:16px;font-weight:600;letter-spacing:-.02em;white-space:nowrap}\n.hg-mark{width:24px;height:24px;border:2px solid var(--teal);border-radius:50%;position:relative;display:inline-block;flex:none}.hg-mark:after{content:'';position:absolute;width:7px;height:7px;left:6.5px;top:6.5px;background:var(--teal);border-radius:50%}\n.hg-nav-links{display:flex;gap:22px;margin-left:auto;color:var(--fog);font-size:13px}.hg-nav-links a{transition:color .2s ease}.hg-nav-links a:hover,.hg-nav-links a:focus-visible{color:#fff}\n.hg-nav-cta{background:#fff;color:var(--ink);border:0;padding:10px 15px;border-radius:6px;font-size:13px;font-weight:600;box-shadow:inset 0 1px 0 rgba(255,255,255,.9)}\n.hg-nav-cta:hover{background:#e9f3ef}.hg-nav-cta:focus-visible,.hg-text-link:focus-visible,.hg-phase:focus-visible,.hg-faq-q:focus-visible{outline:3px solid var(--teal);outline-offset:3px}\n.hg-hero{position:relative;min-height:720px;padding:88px 0 64px;display:grid;grid-template-columns:minmax(0,1fr) 1.04fr;gap:62px;align-items:center;border-bottom:1px solid rgba(255,255,255,.14);overflow:hidden}\n.hg-hero:after{content:'';position:absolute;width:460px;height:460px;border:1px solid rgba(255,255,255,.08);border-radius:50%;right:37%;top:116px;pointer-events:none}.hg-hero:before{content:'';position:absolute;width:310px;height:310px;border:1px solid rgba(255,255,255,.08);border-radius:50%;right:42%;top:190px;pointer-events:none}\n.hg-hero-watermark{position:absolute;left:-14px;top:86px;color:rgba(255,255,255,.07);font-size:clamp(190px,24vw,350px);font-weight:600;line-height:.8;letter-spacing:-.13em;pointer-events:none}\n.hg-hero-copy{position:relative;z-index:1;padding:32px 0 38px}.hg-kicker{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--teal);font-variant-numeric:tabular-nums}.hg-rule-kicker{display:flex;align-items:center;gap:12px}.hg-rule-kicker:after{content:'';width:92px;height:1px;background:rgba(79,209,197,.65)}\n.hg-hero h1{font-size:clamp(46px,6vw,76px);line-height:1.04;letter-spacing:-.065em;font-weight:600;max-width:650px;margin:24px 0 22px}.hg-hero h1 em,.hg-section-title em{font-family:var(--serif);font-weight:400;font-style:italic;color:var(--teal);letter-spacing:-.02em}\n.hg-hero-lede{max-width:535px;color:#E4EBE8;font-size:16px;line-height:1.75}.hg-actions{display:flex;align-items:center;gap:22px;margin-top:30px;flex-wrap:wrap}.hg-primary{background:#fff;color:var(--ink);border:0;border-radius:7px;padding:14px 19px;font-weight:600;font-size:14px}.hg-primary:hover{background:#e8f1ee}.hg-text-link{display:inline-flex;align-items:center;gap:8px;color:#fff;text-decoration:underline;text-underline-offset:5px;font-size:14px}.hg-text-link span{font-size:18px;line-height:1;transition:transform .2s ease}.hg-text-link:hover span{transform:translateY(3px)}.hg-note{font-size:12px;color:var(--fog);margin-top:17px}\n.hg-film-figure{position:relative;z-index:1;margin:0}.hg-film-window{position:relative;background:#062e28;border:1px solid rgba(255,255,255,.28);padding:11px;box-shadow:0 0 0 12px rgba(255,255,255,.03)}.hg-film-window video{width:100%;aspect-ratio:16/10;object-fit:cover;background:#0c3b32;filter:saturate(.72) contrast(1.03);opacity:.92}.hg-film-ui{position:absolute;left:27px;right:27px;bottom:28px;display:flex;justify-content:space-between;align-items:flex-end;pointer-events:none}.hg-film-caption{font-size:11px;color:#fff;letter-spacing:.03em;background:rgba(7,51,43,.84);padding:8px 10px;border-left:2px solid var(--teal)}.hg-film-score{text-align:right;background:rgba(7,51,43,.84);padding:8px 10px}.hg-film-score strong{display:block;color:#fff;font-size:21px;line-height:1}.hg-film-score small{color:var(--fog);font-size:10px}.hg-film-figure figcaption{display:flex;justify-content:space-between;gap:12px;margin-top:13px;color:var(--fog);font-size:11px;letter-spacing:.03em}.hg-film-figure figcaption span:last-child{color:var(--teal)}\n.hg-record-act{background:var(--card);color:var(--ink);padding:104px 0 112px}.hg-record-grid{display:grid;grid-template-columns:170px minmax(0,1fr);gap:66px}.hg-margin-index{position:sticky;top:98px;align-self:start}.hg-margin-index .hg-index-title{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:18px}.hg-margin-index a{display:flex;gap:11px;align-items:baseline;padding:8px 0;color:var(--muted);font-size:12px;border-top:1px solid var(--line)}.hg-margin-index a:last-child{border-bottom:1px solid var(--line)}.hg-margin-index a:hover,.hg-margin-index a:focus-visible{color:var(--cta)}.hg-margin-index b{font-variant-numeric:tabular-nums;color:var(--cta);font-weight:500}.hg-record-copy .hg-kicker{color:var(--cta)}.hg-record-copy .hg-section-title{color:var(--ink)}\n.hg-section-title{font-size:clamp(31px,4.3vw,55px);font-weight:600;line-height:1.07;letter-spacing:-.055em;margin:16px 0 0;max-width:760px}.hg-record-lede{max-width:640px;margin-top:20px;color:var(--body);font-size:16px;line-height:1.75}.hg-record-head{display:flex;justify-content:space-between;gap:28px;align-items:end}.hg-side-note{font-size:12px;color:var(--muted);max-width:180px;line-height:1.55;text-align:right}.hg-side-note strong{color:var(--cta);font-weight:600;display:block;margin-bottom:4px}.hg-ledger{border-top:1px solid #becbc6;margin-top:43px}.hg-ledger-row{display:grid;grid-template-columns:110px minmax(0,1fr) 90px;gap:24px;align-items:start;padding:22px 4px;border-bottom:1px solid #becbc6;transition:border-color .2s ease,background .2s ease}.hg-ledger-row:hover,.hg-ledger-row:focus-within{border-color:var(--teal);background:#f7fbf9}.hg-ledger-row .when{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums;padding-top:2px}.hg-ledger-row .what{font-size:16px;font-weight:600;line-height:1.35}.hg-ledger-row .what small{display:block;color:var(--body);font-size:13.5px;font-weight:400;line-height:1.6;margin-top:6px}.hg-ledger-row .val{text-align:right;color:var(--cta);font-size:13px;font-weight:600}.hg-ledger-row .val span{display:inline-block;transition:transform .2s ease}.hg-ledger-row:hover .val span,.hg-ledger-row:focus-within .val span{transform:translateX(4px)}\n.hg-dial-act{background:var(--stage);color:#fff;padding:120px 0 128px;position:relative;overflow:hidden}.hg-dial-act:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,51,43,.65),transparent 58%);pointer-events:none}.hg-dial-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(260px,.8fr) minmax(430px,1.2fr);gap:30px;align-items:center}.hg-dial-copy .hg-kicker{color:var(--teal)}.hg-dial-copy .hg-section-title{max-width:430px}.hg-dial-copy p:not(.hg-kicker){max-width:445px;color:#E4EBE8;font-size:15.5px;line-height:1.8;margin-top:22px}.hg-dial-phases{display:flex;gap:0;margin-top:27px;border-top:1px solid rgba(255,255,255,.25);max-width:430px}.hg-phase{border:0;border-top:2px solid transparent;background:none;color:var(--fog);padding:10px 17px 0 0;margin-right:20px;font-size:12px;cursor:pointer}.hg-phase[aria-selected='true']{color:#fff;border-color:var(--teal)}.hg-phase:first-child{padding-left:0}.hg-dial-wrap{display:flex;justify-content:center;position:relative}.hg-dial-wrap:after{content:'';position:absolute;width:440px;height:440px;border:1px solid rgba(255,255,255,.07);border-radius:50%;z-index:-1}.hg-dial-svg{width:min(100%,500px);height:auto;overflow:visible}.hg-dial-svg text{font-family:var(--sans)}.hg-dial-center{font-weight:600;font-size:42px;fill:#fff}.hg-dial-sub{fill:var(--fog);font-size:13px}.hg-dial-spoke{stroke:var(--teal);stroke-width:3;stroke-linecap:round}.hg-dial-dot{fill:#fff}.hg-phase-copy{font-size:13px;color:var(--fog);max-width:450px;margin-top:14px;min-height:42px}\n.hg-white-act{background:var(--card);color:var(--ink);padding:110px 0}.hg-chapter-head{display:flex;justify-content:space-between;gap:30px;align-items:end;border-bottom:1px solid var(--line);padding-bottom:27px}.hg-chapter-head .hg-kicker{color:var(--cta)}.hg-chapter-head .hg-section-title{max-width:760px}.hg-chapter-head p{max-width:360px;color:var(--body);font-size:14px;line-height:1.7;margin:0 0 4px}\n.hg-food-grid{display:grid;grid-template-columns:1.03fr .97fr;gap:54px;padding:64px 0 92px;border-bottom:1px solid var(--line);align-items:center}.hg-photo-frame{background:var(--wash);padding:12px;position:relative}.hg-photo-frame img{width:100%;aspect-ratio:4/3;object-fit:cover;filter:saturate(.78) contrast(.98)}.hg-photo-caption{display:flex;justify-content:space-between;gap:10px;font-size:11px;color:var(--muted);padding:11px 2px 0}.hg-photo-caption span:last-child{color:var(--cta)}.hg-fact-sheet h3{font-size:28px;line-height:1.18;letter-spacing:-.04em;font-weight:600}.hg-fact-sheet>p{color:var(--body);font-size:15px;line-height:1.8;margin-top:16px}.hg-facts{border-top:1px solid var(--line);margin-top:23px}.hg-facts div{display:flex;justify-content:space-between;gap:24px;padding:12px 0;border-bottom:1px solid var(--line);font-size:13px}.hg-facts span:first-child{color:var(--muted)}.hg-facts span:last-child{font-weight:600;text-align:right}\n.hg-pulse-strip{background:var(--stage-deep);color:#fff;margin:0 calc((1120px - 100vw)/2);padding:76px max(24px,calc((100vw - 1120px)/2)) 80px;display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.9fr);gap:60px;align-items:center}.hg-pulse-strip h3{font-size:31px;line-height:1.15;letter-spacing:-.04em}.hg-pulse-strip p{color:#D8E5E0;line-height:1.8;font-size:15px;margin-top:15px;max-width:560px}.hg-pulse-strip img{width:100%;height:180px;object-fit:cover;opacity:.66;filter:grayscale(.2) saturate(.7)}.hg-pulse-visual{position:relative}.hg-pulse-visual svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.hg-pulse-visual:after{content:'LIVE TRACE · QUALITY FIRST';position:absolute;left:16px;bottom:12px;color:#fff;background:rgba(7,51,43,.82);font-size:10px;letter-spacing:.08em;padding:6px 8px;border-left:2px solid var(--teal)}\n.hg-treatment{padding:90px 0 0}.hg-treatment-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.hg-paper{background:var(--wash);padding:31px 32px;min-height:205px}.hg-paper h3{font-size:22px;line-height:1.2;letter-spacing:-.03em}.hg-paper p{color:var(--body);font-size:14px;line-height:1.75;margin-top:12px}.hg-mocks{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}.hg-mock-stage{min-height:290px;background:var(--stage);display:flex;align-items:center;justify-content:center;overflow:hidden}.hg-phone{width:190px;background:#fff;border-radius:27px;padding:10px;color:var(--ink)}.hg-phone-screen{background:var(--wash);border-radius:19px;padding:13px;display:grid;gap:9px}.hg-phone-row{background:#fff;border:1px solid var(--line);border-radius:10px;padding:9px;font-size:11px;font-weight:600}.hg-phone-row small{display:block;color:var(--muted);font-weight:400;font-size:9px;margin-top:4px}.hg-phone-cta{background:var(--cta);color:#fff;border-radius:99px;text-align:center;font-size:11px;padding:9px;font-weight:600}.hg-body-mock{display:flex;gap:17px;align-items:center}.hg-body-fig{width:87px;height:174px;border:2px solid rgba(255,255,255,.5);border-radius:50px;position:relative}.hg-body-fig i{position:absolute;width:13px;height:13px;background:var(--pulse);border-radius:50%}.hg-body-fig i:first-child{top:46px;left:23px}.hg-body-fig i:last-child{top:101px;right:17px}.hg-body-list{display:grid;gap:7px;font-size:11px}.hg-body-list div{background:#fff;color:var(--ink);border-radius:7px;padding:7px 9px;font-weight:600}\n.hg-details-act{background:var(--stage);color:#fff;padding:112px 0 120px}.hg-details-act .hg-kicker{color:var(--teal)}.hg-chat-layout{display:grid;grid-template-columns:1fr .82fr;gap:18px;margin-top:45px}.hg-transcript{border-top:1px solid rgba(255,255,255,.22)}.hg-transcript-row{display:grid;grid-template-columns:84px 1fr;gap:20px;padding:22px 0;border-bottom:1px solid rgba(255,255,255,.22)}.hg-transcript-row .speaker{font-size:11px;color:var(--teal);text-transform:uppercase;letter-spacing:.08em}.hg-transcript-row p{font-size:15px;line-height:1.75;color:#F1F6F4}.hg-transcript-row.me p{color:var(--fog)}.hg-evidence-card{background:#fff;color:var(--ink);padding:30px 31px;align-self:start}.hg-evidence-card .hg-kicker{color:var(--cta)}.hg-evidence-card blockquote{border-top:3px solid var(--teal);margin:19px 0 0;padding-top:14px;font-family:var(--serif);font-style:italic;font-size:24px;line-height:1.14;color:var(--ink)}.hg-evidence-card p{color:var(--body);font-size:13px;line-height:1.7;margin-top:16px}.hg-evidence-card small{display:block;color:var(--muted);font-size:11px;margin-top:20px;border-top:1px solid var(--line);padding-top:11px}.hg-evidence-wide{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;border-top:1px solid rgba(255,255,255,.22);margin-top:84px;padding-top:72px}.hg-evidence-wide p{color:#D8E5E0;line-height:1.8;max-width:600px}.hg-graph-motif{height:210px;position:relative;display:flex;align-items:center;justify-content:center}.hg-graph-motif:before,.hg-graph-motif:after{content:'';position:absolute;border:1px solid rgba(79,209,197,.6);border-radius:50%}.hg-graph-motif:before{width:160px;height:160px}.hg-graph-motif:after{width:92px;height:92px}.hg-graph-lines{position:absolute;width:220px;height:1px;background:var(--teal);transform:rotate(34deg)}.hg-graph-lines:after{content:'';position:absolute;width:1px;height:160px;background:var(--teal);left:50%;top:-79px;transform:rotate(55deg)}.hg-graph-dot{width:12px;height:12px;border-radius:50%;background:var(--teal);position:relative;z-index:1;box-shadow:0 0 0 7px rgba(79,209,197,.13)}\n.hg-limits-act{background:var(--stage);color:#fff;padding:0 0 116px}.hg-limits-head{border-top:1px solid rgba(255,255,255,.22);padding-top:82px}.hg-limits-head .hg-section-title{max-width:650px}.hg-limits{border-top:1px solid rgba(255,255,255,.22);margin-top:47px}.hg-limit-row{display:grid;grid-template-columns:1fr 2fr;gap:30px;padding:25px 4px;border-bottom:1px solid rgba(255,255,255,.22)}.hg-limit-row h3{font-size:16px;font-weight:600}.hg-limit-row p{color:#D8E5E0;line-height:1.75;font-size:14px}.hg-limit-row.safety h3:before{content:'';display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--pulse);margin:0 9px 2px 0}\n.hg-faq-act{background:var(--card);color:var(--ink);padding:102px 0 112px}.hg-faq-act .hg-kicker{color:var(--cta)}.hg-faq-list{max-width:820px;margin:42px auto 0;border-top:1px solid var(--line)}.hg-faq-item{border-bottom:1px solid var(--line)}.hg-faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:20px;border:0;background:none;color:var(--ink);text-align:left;padding:20px 2px;font-weight:600;font-size:15px;cursor:pointer}.hg-faq-q span{font-size:22px;font-weight:400;color:var(--cta);line-height:1;transition:transform .2s ease}.hg-faq-item.open .hg-faq-q span{transform:rotate(45deg)}.hg-faq-answer{max-height:0;overflow:hidden;transition:max-height .32s ease}.hg-faq-answer p{color:var(--body);font-size:14px;line-height:1.75;padding:0 34px 22px 2px}.hg-faq-item.open .hg-faq-answer{max-height:220px}\n.hg-access-act{background:var(--stage);color:#fff;padding:0 0 70px}.hg-access-sheet{background:#fff;color:var(--ink);padding:57px 60px;border-radius:2px}.hg-access-sheet .hg-kicker{color:var(--cta)}.hg-access-sheet h2{font-size:clamp(31px,4.4vw,51px);line-height:1.08;letter-spacing:-.055em;max-width:610px;margin-top:15px}.hg-access-sheet h2 em{font-family:var(--serif);font-style:italic;font-weight:400;color:var(--cta)}.hg-access-sheet p{color:var(--body);max-width:550px;font-size:15px;line-height:1.75;margin-top:17px}.hg-store-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:27px}.hg-store{display:inline-flex;flex-direction:column;background:var(--ink);color:#fff;border-radius:9px;padding:11px 18px;min-width:144px;font-weight:600;font-size:14px}.hg-store small{font-size:9px;color:#B9C6C1;font-weight:400}.hg-fine{font-size:12px!important;color:var(--muted)!important;margin-top:19px!important}.hg-footer{color:var(--fog);padding:32px 0 66px;border-top:1px solid rgba(255,255,255,.15);font-size:12px}.hg-footer-top{display:flex;align-items:flex-start;justify-content:space-between;gap:30px;flex-wrap:wrap}.hg-footer .hg-brand{font-size:14px}.hg-disclaimer{max-width:700px;line-height:1.7;margin-top:17px;color:var(--fog)}\n@media (max-width:900px){.hg-nav-links{display:none}.hg-hero{grid-template-columns:1fr;gap:30px;padding-top:58px}.hg-hero-copy{padding-bottom:0}.hg-film-figure{max-width:720px}.hg-record-grid{grid-template-columns:1fr;gap:34px}.hg-margin-index{position:static;display:flex;gap:15px;overflow:auto;border-bottom:1px solid var(--line);padding-bottom:12px}.hg-margin-index .hg-index-title{display:none}.hg-margin-index a{border:0;white-space:nowrap;padding:0}.hg-margin-index a:last-child{border:0}.hg-side-note{display:none}.hg-dial-grid,.hg-food-grid,.hg-chat-layout,.hg-evidence-wide{grid-template-columns:1fr}.hg-pulse-strip{margin:0 -24px;padding-left:24px;padding-right:24px}.hg-evidence-card{max-width:600px}.hg-graph-motif{order:-1}.hg-limit-row{grid-template-columns:1fr;gap:8px}}\n@media (max-width:600px){.hg-wrap{width:min(100% - 34px,1120px)}.hg-nav-in{min-height:62px}.hg-nav-cta{padding:9px 11px}.hg-hero{min-height:auto;padding:56px 0 44px}.hg-hero-watermark{top:63px;left:-8px;font-size:168px}.hg-hero h1{font-size:44px}.hg-hero-lede{font-size:15px}.hg-film-window{padding:7px;box-shadow:none}.hg-film-ui{left:16px;right:16px;bottom:17px}.hg-film-figure figcaption{display:block}.hg-film-figure figcaption span{display:block;margin-top:3px}.hg-record-act,.hg-white-act,.hg-faq-act{padding:74px 0}.hg-record-grid{gap:24px}.hg-record-head{display:block}.hg-record-lede{font-size:15px}.hg-ledger-row{grid-template-columns:1fr auto;gap:7px 15px;padding:18px 2px}.hg-ledger-row .when{grid-column:1/-1}.hg-ledger-row .what{font-size:15px}.hg-ledger-row .what small{font-size:13px}.hg-dial-act{padding:78px 0 82px}.hg-dial-grid{grid-template-columns:1fr}.hg-dial-wrap{margin-top:15px}.hg-dial-wrap:after{width:290px;height:290px}.hg-dial-svg{width:100%}.hg-dial-phases{overflow:auto}.hg-phase{min-width:max-content}.hg-chapter-head{display:block}.hg-chapter-head p{margin-top:18px}.hg-food-grid{padding:40px 0 70px;gap:35px}.hg-fact-sheet h3{font-size:25px}.hg-pulse-strip{display:block;padding-top:50px;padding-bottom:53px}.hg-pulse-visual{margin-top:24px}.hg-pulse-strip img{height:135px}.hg-treatment{padding-top:65px}.hg-treatment-grid,.hg-mocks{grid-template-columns:1fr}.hg-mock-stage{min-height:250px}.hg-details-act{padding:75px 0 82px}.hg-chat-layout{margin-top:30px}.hg-transcript-row{grid-template-columns:1fr;gap:6px}.hg-evidence-wide{margin-top:60px;padding-top:50px}.hg-limits-head{padding-top:66px}.hg-limits{margin-top:34px}.hg-limit-row{padding:21px 2px}.hg-access-sheet{padding:38px 25px}.hg-access-sheet h2{font-size:36px}.hg-footer-top{display:block}.hg-footer-top .hg-brand{margin-bottom:12px}}\n@media (prefers-reduced-motion:reduce){.hg-page *{scroll-behavior:auto!important;transition:none!important}.hg-film-window video{animation:none}.hg-faq-answer{transition:none}}\n</style>\n<div class=\"hg-page\" data-kid=\"1\" id=\"top\">\n    <nav aria-label=\"Primary navigation\" class=\"hg-nav\" data-kid=\"1-1\">\n        <div class=\"hg-wrap hg-nav-in\" data-kid=\"1-1-1\">\n            <a aria-label=\"HealthGraph home\" class=\"hg-brand\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <span aria-hidden=\"true\" class=\"hg-mark\" data-kid=\"1-1-1-1-1\">\n                </span>\n                HealthGraph\n            </a>\n            <div class=\"hg-nav-links\" data-kid=\"1-1-1-2\">\n                <a data-kid=\"1-1-1-2-1\" href=\"#record\">\n                    Record\n                </a>\n                <a data-kid=\"1-1-1-2-2\" href=\"#dial\">\n                    See patterns\n                </a>\n                <a data-kid=\"1-1-1-2-3\" href=\"#chat\">\n                    Ask\n                </a>\n                <a data-kid=\"1-1-1-2-4\" href=\"#promises\">\n                    Limits\n                </a>\n                <a data-kid=\"1-1-1-2-5\" href=\"#faq\">\n                    Questions\n                </a>\n            </div>\n            <a class=\"hg-nav-cta\" data-kid=\"1-1-1-3\" href=\"#get\">\n                Get the app\n            </a>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\">\n        <section aria-labelledby=\"hero-title\" class=\"hg-hero hg-wrap\" data-kid=\"1-2-1\">\n            <div aria-hidden=\"true\" class=\"hg-hero-watermark\" data-kid=\"1-2-1-1\">\n                00\n            </div>\n            <div class=\"hg-hero-copy\" data-kid=\"1-2-1-2\">\n                <div class=\"hg-rule-kicker hg-kicker\" data-kid=\"1-2-1-2-1\">\n                    The personal record, made readable\n                </div>\n                <h1 data-kid=\"1-2-1-2-2\" id=\"hero-title\">\n                    Your whole health in\n                    <em data-kid=\"1-2-1-2-2-1\">\n                        one dial.\n                    </em>\n                </h1>\n                <p class=\"hg-hero-lede\" data-kid=\"1-2-1-2-3\">\n                    HealthGraph keeps your sleep, symptoms, medicines, meals, pulse readings, and medical records in one place, then shows what they add up to across ten spokes you can scrub back through thirty days.\n                </p>\n                <div class=\"hg-actions\" data-kid=\"1-2-1-2-4\">\n                    <a class=\"hg-primary\" data-kid=\"1-2-1-2-4-1\" href=\"#get\">\n                        Get HealthGraph free\n                    </a>\n                    <a class=\"hg-text-link\" data-kid=\"1-2-1-2-4-2\" href=\"#record\">\n                        Look inside first\n                        <span aria-hidden=\"true\" data-kid=\"1-2-1-2-4-2-1\">\n                            ↓\n                        </span>\n                    </a>\n                </div>\n                <p class=\"hg-note\" data-kid=\"1-2-1-2-5\">\n                    Free during early access. iOS and Android. Your data stays yours.\n                </p>\n            </div>\n            <figure class=\"hg-film-figure\" data-kid=\"1-2-1-3\">\n                <div class=\"hg-film-window\" data-kid=\"1-2-1-3-1\">\n                    <video aria-label=\"HealthGraph app evidence window\" autoplay=\"\" data-kid=\"1-2-1-3-1-1\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/photos/7889065/pexels-photo-7889065.jpeg?auto=compress&cs=tinysrgb&w=1100&q=80\" preload=\"metadata\">\n                        <source data-kid=\"1-2-1-3-1-1-1\" src=\"../assets/app-load.mp4\" type=\"video/mp4\"/>\n                        <source data-kid=\"1-2-1-3-1-1-2\" src=\"frontend/assets/app-load.mp4\" type=\"video/mp4\"/>\n                    </video>\n                    <div class=\"hg-film-ui\" data-kid=\"1-2-1-3-1-2\">\n                        <span class=\"hg-film-caption\" data-kid=\"1-2-1-3-1-2-1\">\n                            HealthGraph / 30-day record\n                            <br data-kid=\"1-2-1-3-1-2-1-1\"/>\n                            <span data-kid=\"1-2-1-3-1-2-1-2\" style=\"color:var(--teal)\">\n                                latest logs connected\n                            </span>\n                        </span>\n                        <span class=\"hg-film-score\" data-kid=\"1-2-1-3-1-2-2\">\n                            <strong data-kid=\"1-2-1-3-1-2-2-1\">\n                                8\n                            </strong>\n                            <small data-kid=\"1-2-1-3-1-2-2-2\">\n                                steady\n                            </small>\n                        </span>\n                    </div>\n                </div>\n                <figcaption data-kid=\"1-2-1-3-2\">\n                    <span data-kid=\"1-2-1-3-2-1\">\n                        Sleep · Symptoms · Meds · Meals · Pulse · Records\n                    </span>\n                    <span data-kid=\"1-2-1-3-2-2\">\n                        FIG. 00 / APP EVIDENCE WINDOW\n                    </span>\n                </figcaption>\n            </figure>\n        </section>\n        <section aria-labelledby=\"record-title\" class=\"hg-record-act\" data-kid=\"1-2-2\" id=\"record\">\n            <div class=\"hg-wrap hg-record-grid\" data-kid=\"1-2-2-1\">\n                <aside aria-label=\"Section index\" class=\"hg-margin-index\" data-kid=\"1-2-2-1-1\">\n                    <span class=\"hg-index-title\" data-kid=\"1-2-2-1-1-1\">\n                        On this page\n                    </span>\n                    <a data-kid=\"1-2-2-1-1-2\" href=\"#record\">\n                        <b data-kid=\"1-2-2-1-1-2-1\">\n                            01\n                        </b>\n                        The record\n                    </a>\n                    <a data-kid=\"1-2-2-1-1-3\" href=\"#dial\">\n                        <b data-kid=\"1-2-2-1-1-3-1\">\n                            02\n                        </b>\n                        The pattern\n                    </a>\n                    <a data-kid=\"1-2-2-1-1-4\" href=\"#food\">\n                        <b data-kid=\"1-2-2-1-1-4-1\">\n                            03\n                        </b>\n                        Capture\n                    </a>\n                    <a data-kid=\"1-2-2-1-1-5\" href=\"#chat\">\n                        <b data-kid=\"1-2-2-1-1-5-1\">\n                            04\n                        </b>\n                        Explanation\n                    </a>\n                    <a data-kid=\"1-2-2-1-1-6\" href=\"#promises\">\n                        <b data-kid=\"1-2-2-1-1-6-1\">\n                            05\n                        </b>\n                        Limits\n                    </a>\n                    <a data-kid=\"1-2-2-1-1-7\" href=\"#faq\">\n                        <b data-kid=\"1-2-2-1-1-7-1\">\n                            06\n                        </b>\n                        Questions\n                    </a>\n                </aside>\n                <div class=\"hg-record-copy\" data-kid=\"1-2-2-1-2\">\n                    <div class=\"hg-record-head\" data-kid=\"1-2-2-1-2-1\">\n                        <div data-kid=\"1-2-2-1-2-1-1\">\n                            <div class=\"hg-kicker\" data-kid=\"1-2-2-1-2-1-1-1\">\n                                01 · The record\n                            </div>\n                            <h2 class=\"hg-section-title\" data-kid=\"1-2-2-1-2-1-1-2\" id=\"record-title\">\n                                Sixty seconds in,\n                                <em data-kid=\"1-2-2-1-2-1-1-2-1\">\n                                    a lifetime ledger\n                                </em>\n                                out.\n                            </h2>\n                            <p class=\"hg-record-lede\" data-kid=\"1-2-2-1-2-1-1-3\">\n                                The daily sheet is sliders and chips, almost no keyboard: mood, sleep, water, meals, activity, pain, vitals, and a notes line for anything the sliders cannot say. It validates as you go and saves locally first, so a dead zone never eats an entry. The timeline is where all of it lands, mixed with medication events and uploaded records on one chronological ledger of white day cards.\n                            </p>\n                        </div>\n                        <p class=\"hg-side-note\" data-kid=\"1-2-2-1-2-1-2\">\n                            <strong data-kid=\"1-2-2-1-2-1-2-1\">\n                                Same store.\n                            </strong>\n                            These entries feed the same dial.\n                        </p>\n                    </div>\n                    <div aria-label=\"HealthGraph timeline\" class=\"hg-ledger\" data-kid=\"1-2-2-1-2-2\">\n                        <a class=\"hg-ledger-row\" data-kid=\"1-2-2-1-2-2-1\" href=\"#dial\">\n                            <span class=\"when\" data-kid=\"1-2-2-1-2-2-1-1\">\n                                Today\n                            </span>\n                            <span class=\"what\" data-kid=\"1-2-2-1-2-2-1-2\">\n                                Evening log\n                                <small data-kid=\"1-2-2-1-2-2-1-2-1\">\n                                    Mood 4, pain 2, water 1.8 litres, notes about the headache after lunch.\n                                </small>\n                            </span>\n                            <span class=\"val\" data-kid=\"1-2-2-1-2-2-1-3\">\n                                Saved\n                                <span aria-hidden=\"true\" data-kid=\"1-2-2-1-2-2-1-3-1\">\n                                    →\n                                </span>\n                            </span>\n                        </a>\n                        <a class=\"hg-ledger-row\" data-kid=\"1-2-2-1-2-2-2\" href=\"#treatment\">\n                            <span class=\"when\" data-kid=\"1-2-2-1-2-2-2-1\">\n                                Yesterday\n                            </span>\n                            <span class=\"what\" data-kid=\"1-2-2-1-2-2-2-2\">\n                                Amtiva 5g, morning dose\n                                <small data-kid=\"1-2-2-1-2-2-2-2-1\">\n                                    Taken at 8:04, four minutes after the reminder.\n                                </small>\n                            </span>\n                            <span class=\"val\" data-kid=\"1-2-2-1-2-2-2-3\">\n                                Taken\n                                <span aria-hidden=\"true\" data-kid=\"1-2-2-1-2-2-2-3-1\">\n                                    →\n                                </span>\n                            </span>\n                        </a>\n                        <a class=\"hg-ledger-row\" data-kid=\"1-2-2-1-2-2-3\" href=\"#evidence\">\n                            <span class=\"when\" data-kid=\"1-2-2-1-2-2-3-1\">\n                                Sep 14\n                            </span>\n                            <span class=\"what\" data-kid=\"1-2-2-1-2-2-3-2\">\n                                Lipid panel, uploaded PDF\n                                <small data-kid=\"1-2-2-1-2-2-3-2-1\">\n                                    Extraction finished overnight. Two values flagged in place.\n                                </small>\n                            </span>\n                            <span class=\"val\" data-kid=\"1-2-2-1-2-2-3-3\">\n                                Ready\n                                <span aria-hidden=\"true\" data-kid=\"1-2-2-1-2-2-3-3-1\">\n                                    →\n                                </span>\n                            </span>\n                        </a>\n                        <a class=\"hg-ledger-row\" data-kid=\"1-2-2-1-2-2-4\" href=\"#pulse\">\n                            <span class=\"when\" data-kid=\"1-2-2-1-2-2-4-1\">\n                                Sep 12\n                            </span>\n                            <span class=\"what\" data-kid=\"1-2-2-1-2-2-4-2\">\n                                Face pulse check\n                                <small data-kid=\"1-2-2-1-2-2-4-2-1\">\n                                    72 bpm, good quality, thirty second scan.\n                                </small>\n                            </span>\n                            <span class=\"val\" data-kid=\"1-2-2-1-2-2-4-3\">\n                                72\n                                <span aria-hidden=\"true\" data-kid=\"1-2-2-1-2-2-4-3-1\">\n                                    →\n                                </span>\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"dial-title\" class=\"hg-dial-act\" data-kid=\"1-2-3\" id=\"dial\">\n            <div class=\"hg-wrap hg-dial-grid\" data-kid=\"1-2-3-1\">\n                <div class=\"hg-dial-copy\" data-kid=\"1-2-3-1-1\">\n                    <div class=\"hg-kicker\" data-kid=\"1-2-3-1-1-1\">\n                        02 · The pattern\n                    </div>\n                    <h2 class=\"hg-section-title\" data-kid=\"1-2-3-1-1-2\" id=\"dial-title\">\n                        One ring. Ten signals.\n                        <em data-kid=\"1-2-3-1-1-2-1\">\n                            Your call\n                        </em>\n                        what it shows next.\n                    </h2>\n                    <p data-kid=\"1-2-3-1-1-3\" id=\"dial-copy\">\n                        Sleep, energy, water, stress, movement, wellbeing, pain, meals, heart, and doses each get a spoke, and each spoke sits inside its healthy band or steps outside it where you can see it happen.\n                    </p>\n                    <div aria-label=\"Dial explanation phases\" class=\"hg-dial-phases\" data-kid=\"1-2-3-1-1-4\" role=\"tablist\">\n                        <button aria-selected=\"true\" class=\"hg-phase\" data-kid=\"1-2-3-1-1-4-1\" data-phase=\"0\" role=\"tab\" type=\"button\">\n                            signals\n                        </button>\n                        <button aria-selected=\"false\" class=\"hg-phase\" data-kid=\"1-2-3-1-1-4-2\" data-phase=\"1\" role=\"tab\" type=\"button\">\n                            current view\n                        </button>\n                        <button aria-selected=\"false\" class=\"hg-phase\" data-kid=\"1-2-3-1-1-4-3\" data-phase=\"2\" role=\"tab\" type=\"button\">\n                            thirty-day replay\n                        </button>\n                    </div>\n                    <p aria-live=\"polite\" class=\"hg-phase-copy\" data-dynamic=\"true\" data-kid=\"1-2-3-1-1-5\" data-name=\"dial explanation phase text\" data-reason=\"text content replaced by click script\" id=\"dial-phase-copy\">\n                        Sleep, energy, water, stress, movement, wellbeing, pain, meals, heart, and doses each get a spoke, and each spoke sits inside its healthy band or steps outside it where you can see it happen.\n                    </p>\n                </div>\n                <div class=\"hg-dial-wrap\" data-kid=\"1-2-3-1-2\">\n                    <svg aria-label=\"HealthGraph ten-spoke insight dial\" class=\"hg-dial-svg\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-1\" data-name=\"ten-spoke insight dial svg\" data-reason=\"dial center value and band dashoffset updated by click script\" role=\"img\" viewbox=\"0 0 500 500\">\n                        <circle cx=\"250\" cy=\"250\" fill=\"none\" r=\"185\" stroke=\"rgba(255,255,255,.2)\" stroke-width=\"28\">\n                        </circle>\n                        <circle cx=\"250\" cy=\"250\" fill=\"none\" id=\"dial-band\" r=\"185\" stroke=\"var(--teal)\" stroke-dasharray=\"1162\" stroke-dashoffset=\"160\" stroke-linecap=\"round\" stroke-width=\"28\" transform=\"rotate(-90 250 250)\">\n                        </circle>\n                        <circle cx=\"250\" cy=\"250\" fill=\"none\" r=\"132\" stroke=\"rgba(255,255,255,.18)\" stroke-width=\"1.5\">\n                        </circle>\n                        <circle cx=\"250\" cy=\"250\" fill=\"none\" r=\"78\" stroke=\"rgba(255,255,255,.18)\" stroke-width=\"1.5\">\n                        </circle>\n                        <g class=\"hg-dial-spoke\">\n                            <line x1=\"250\" x2=\"250\" y1=\"118\" y2=\"74\">\n                            </line>\n                            <line x1=\"328\" x2=\"366\" y1=\"143\" y2=\"117\">\n                            </line>\n                            <line x1=\"376\" x2=\"422\" y1=\"208\" y2=\"195\">\n                            </line>\n                            <line x1=\"376\" x2=\"416\" y1=\"292\" y2=\"312\">\n                            </line>\n                            <line x1=\"328\" x2=\"354\" y1=\"357\" y2=\"395\">\n                            </line>\n                            <line x1=\"250\" x2=\"250\" y1=\"382\" y2=\"430\">\n                            </line>\n                            <line x1=\"172\" x2=\"142\" y1=\"357\" y2=\"393\">\n                            </line>\n                            <line x1=\"124\" x2=\"79\" y1=\"292\" y2=\"306\">\n                            </line>\n                            <line x1=\"124\" x2=\"83\" y1=\"208\" y2=\"193\">\n                            </line>\n                            <line x1=\"172\" x2=\"140\" y1=\"143\" y2=\"111\">\n                            </line>\n                        </g>\n                        <g class=\"hg-dial-dot\">\n                            <circle cx=\"250\" cy=\"74\" r=\"6\">\n                            </circle>\n                            <circle cx=\"366\" cy=\"117\" r=\"6\">\n                            </circle>\n                            <circle cx=\"422\" cy=\"195\" r=\"6\">\n                            </circle>\n                            <circle cx=\"416\" cy=\"312\" r=\"6\">\n                            </circle>\n                            <circle cx=\"354\" cy=\"395\" r=\"6\">\n                            </circle>\n                            <circle cx=\"250\" cy=\"430\" r=\"6\">\n                            </circle>\n                            <circle cx=\"142\" cy=\"393\" r=\"6\">\n                            </circle>\n                            <circle cx=\"79\" cy=\"306\" r=\"6\">\n                            </circle>\n                            <circle cx=\"83\" cy=\"193\" r=\"6\">\n                            </circle>\n                            <circle cx=\"140\" cy=\"111\" r=\"6\">\n                            </circle>\n                        </g>\n                        <text class=\"hg-dial-center\" id=\"dial-center\" text-anchor=\"middle\" x=\"250\" y=\"250\">\n                            8\n                        </text>\n                        <text class=\"hg-dial-sub\" text-anchor=\"middle\" x=\"250\" y=\"278\">\n                            steady\n                        </text>\n                    </svg>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"capture-title\" class=\"hg-white-act\" data-kid=\"1-2-4\" id=\"food\">\n            <div class=\"hg-wrap\" data-kid=\"1-2-4-1\">\n                <div class=\"hg-chapter-head\" data-kid=\"1-2-4-1-1\">\n                    <div data-kid=\"1-2-4-1-1-1\">\n                        <div class=\"hg-kicker\" data-kid=\"1-2-4-1-1-1-1\">\n                            03 · Ways the record gets made\n                        </div>\n                        <h2 class=\"hg-section-title\" data-kid=\"1-2-4-1-1-1-2\" id=\"capture-title\">\n                            Dinner first,\n                            <em data-kid=\"1-2-4-1-1-1-2-1\">\n                                arithmetic\n                            </em>\n                            second.\n                        </h2>\n                    </div>\n                    <p data-kid=\"1-2-4-1-1-2\">\n                        Capture methods stay close to real life: a plate, a pulse, a dose, a note.\n                    </p>\n                </div>\n                <div class=\"hg-food-grid\" data-kid=\"1-2-4-1-2\">\n                    <figure class=\"hg-photo-frame\" data-kid=\"1-2-4-1-2-1\">\n                        <img alt=\"Hands adjusting a homemade meal at a real kitchen table — Nour Alhoda on Pexels\" data-kid=\"1-2-4-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/34590137/pexels-photo-34590137.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80\"/>\n                        <figcaption class=\"hg-photo-caption\" data-kid=\"1-2-4-1-2-1-2\">\n                            <span data-kid=\"1-2-4-1-2-1-2-1\">\n                                Food scan / photo input\n                            </span>\n                            <span data-kid=\"1-2-4-1-2-1-2-2\">\n                                RANGE, NOT A GUESS\n                            </span>\n                        </figcaption>\n                    </figure>\n                    <div class=\"hg-fact-sheet\" data-kid=\"1-2-4-1-2-2\">\n                        <h3 data-kid=\"1-2-4-1-2-2-1\">\n                            How a photo becomes a number you can trust enough to log\n                        </h3>\n                        <p data-kid=\"1-2-4-1-2-2-2\">\n                            Nobody keeps a food diary for long when every entry means typing ingredients into tiny boxes. So the diary works the other way here. You frame the plate, tap once, and about forty seconds later the meal is sitting in your log with calories and macros attached, ready for you to correct.\n                        </p>\n                        <p data-kid=\"1-2-4-1-2-2-3\">\n                            Vision AI names each food on the plate and judges portions against the plate itself, then the USDA nutrition database fills in calories, protein, carbs, and fat per hundred grams. Because a photo is evidence rather than measurement, the answer arrives as a range with a confidence note, and every item carries gram steppers so a heavy pour of rice takes two taps to fix. Logging works offline and syncs when you reconnect.\n                        </p>\n                        <div class=\"hg-facts\" data-kid=\"1-2-4-1-2-2-4\">\n                            <div data-kid=\"1-2-4-1-2-2-4-1\">\n                                <span data-kid=\"1-2-4-1-2-2-4-1-1\">\n                                    Typical analysis time\n                                </span>\n                                <span data-kid=\"1-2-4-1-2-2-4-1-2\">\n                                    About 40 seconds\n                                </span>\n                            </div>\n                            <div data-kid=\"1-2-4-1-2-2-4-2\">\n                                <span data-kid=\"1-2-4-1-2-2-4-2-1\">\n                                    Portion adjustment\n                                </span>\n                                <span data-kid=\"1-2-4-1-2-2-4-2-2\">\n                                    10 gram steps, totals rescale live\n                                </span>\n                            </div>\n                            <div data-kid=\"1-2-4-1-2-2-4-3\">\n                                <span data-kid=\"1-2-4-1-2-2-4-3-1\">\n                                    Nutrition source\n                                </span>\n                                <span data-kid=\"1-2-4-1-2-2-4-3-2\">\n                                    USDA FoodData Central\n                                </span>\n                            </div>\n                            <div data-kid=\"1-2-4-1-2-2-4-4\">\n                                <span data-kid=\"1-2-4-1-2-2-4-4-1\">\n                                    When unsure\n                                </span>\n                                <span data-kid=\"1-2-4-1-2-2-4-4-2\">\n                                    A range, never a fake exact figure\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"hg-pulse-strip\" data-kid=\"1-2-4-1-3\" id=\"pulse\">\n                    <div data-kid=\"1-2-4-1-3-1\">\n                        <div class=\"hg-kicker\" data-kid=\"1-2-4-1-3-1-1\">\n                            05 · Pulse check\n                        </div>\n                        <h3 data-kid=\"1-2-4-1-3-1-2\">\n                            Two ways to take a pulse,\n                            <span data-kid=\"1-2-4-1-3-1-2-1\" style=\"font-family:var(--serif);font-style:italic;color:var(--teal);font-weight:400\">\n                                zero wearables\n                            </span>\n                            required.\n                        </h3>\n                        <p data-kid=\"1-2-4-1-3-1-3\">\n                            The fingertip method is the classic one: cover the camera, hold still, and watch the live waveform draw itself while the quality meter decides whether the reading counts. The face method needs nothing but light. It reads the pulse remotely from skin tone changes over about thirty seconds, which makes it the option you will actually use on an ordinary Tuesday.\n                        </p>\n                        <p data-kid=\"1-2-4-1-3-1-4\">\n                            Both end in the same place. Results carry a quality score and heart rate variability where the signal supports it, then land on the dial as the heart spoke and in the timeline as a dated entry. A bad reading is discarded with an explanation instead of being filed as fact.\n                        </p>\n                    </div>\n                    <div class=\"hg-pulse-visual\" data-kid=\"1-2-4-1-3-2\">\n                        <img alt=\"Adult using a phone for a pulse reading in natural window light — Tima Miroshnichenko on Pexels\" data-kid=\"1-2-4-1-3-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8376172/pexels-photo-8376172.jpeg?auto=compress&cs=tinysrgb&w=850&q=80\"/>\n                        <svg aria-hidden=\"true\" data-kid=\"1-2-4-1-3-2-2\" viewbox=\"0 0 520 180\">\n                            <path d=\"M0 90 H120 L146 90 L165 31 L187 143 L205 60 L220 90 H520\" fill=\"none\" stroke=\"var(--teal)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"4\">\n                            </path>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"hg-treatment\" data-kid=\"1-2-4-1-4\" id=\"treatment\">\n                    <div class=\"hg-kicker\" data-kid=\"1-2-4-1-4-1\" style=\"color:var(--cta)\">\n                        06 · Meds and symptom map\n                    </div>\n                    <div class=\"hg-treatment-grid\" data-kid=\"1-2-4-1-4-2\">\n                        <article class=\"hg-paper\" data-kid=\"1-2-4-1-4-2-1\">\n                            <h3 data-kid=\"1-2-4-1-4-2-1-1\">\n                                Schedules that survive real life\n                            </h3>\n                            <p data-kid=\"1-2-4-1-4-2-1-2\">\n                                You define each medicine once with its dose, times, and days, and the day view reduces the rest to a single decision per row: taken or not. One tap stamps the time. Adherence becomes a spoke on the dial, which turns out to motivate more reliably than any reminder sentence, though the reminders stay.\n                            </p>\n                        </article>\n                        <article class=\"hg-paper\" data-kid=\"1-2-4-1-4-2-2\">\n                            <h3 data-kid=\"1-2-4-1-4-2-2-1\">\n                                A body you can point at\n                            </h3>\n                            <p data-kid=\"1-2-4-1-4-2-2-2\">\n                                Thirty seven regions across front and back views, each tappable, each with a severity slider for the days a spot flares. A thirty day replay strip shows how each place behaved over the month, which is the difference between telling your doctor the shoulder hurts and showing them the four weeks it hurt.\n                            </p>\n                        </article>\n                    </div>\n                    <div class=\"hg-mocks\" data-kid=\"1-2-4-1-4-3\">\n                        <div class=\"hg-mock-stage\" data-kid=\"1-2-4-1-4-3-1\">\n                            <div class=\"hg-phone\" data-kid=\"1-2-4-1-4-3-1-1\">\n                                <div class=\"hg-phone-screen\" data-kid=\"1-2-4-1-4-3-1-1-1\">\n                                    <div class=\"hg-phone-row\" data-kid=\"1-2-4-1-4-3-1-1-1-1\">\n                                        Amtiva 5g\n                                        <small data-kid=\"1-2-4-1-4-3-1-1-1-1-1\">\n                                            8:00 AM, taken\n                                        </small>\n                                    </div>\n                                    <div class=\"hg-phone-row\" data-kid=\"1-2-4-1-4-3-1-1-1-2\">\n                                        Vitamin D\n                                        <small data-kid=\"1-2-4-1-4-3-1-1-1-2-1\">\n                                            due 1:00 PM\n                                        </small>\n                                    </div>\n                                    <div class=\"hg-phone-cta\" data-kid=\"1-2-4-1-4-3-1-1-1-3\">\n                                        Mark taken\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"hg-mock-stage\" data-kid=\"1-2-4-1-4-3-2\">\n                            <div class=\"hg-body-mock\" data-kid=\"1-2-4-1-4-3-2-1\">\n                                <div class=\"hg-body-fig\" data-kid=\"1-2-4-1-4-3-2-1-1\">\n                                    <i data-kid=\"1-2-4-1-4-3-2-1-1-1\">\n                                    </i>\n                                    <i data-kid=\"1-2-4-1-4-3-2-1-1-2\">\n                                    </i>\n                                </div>\n                                <div class=\"hg-body-list\" data-kid=\"1-2-4-1-4-3-2-1-2\">\n                                    <div data-kid=\"1-2-4-1-4-3-2-1-2-1\">\n                                        Shoulder · 4/10\n                                    </div>\n                                    <div data-kid=\"1-2-4-1-4-3-2-1-2-2\">\n                                        Lower back · 6/10\n                                    </div>\n                                    <div data-kid=\"1-2-4-1-4-3-2-1-2-3\">\n                                        Knee · 2/10\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"details-title\" class=\"hg-details-act\" data-kid=\"1-2-5\" id=\"chat\">\n            <div class=\"hg-wrap\" data-kid=\"1-2-5-1\">\n                <div class=\"hg-kicker\" data-kid=\"1-2-5-1-1\">\n                    04 · Ways the record gets read\n                </div>\n                <h2 class=\"hg-section-title\" data-kid=\"1-2-5-1-2\" id=\"details-title\">\n                    Ask the week\n                    <em data-kid=\"1-2-5-1-2-1\">\n                        what happened.\n                    </em>\n                </h2>\n                <div class=\"hg-chat-layout\" data-kid=\"1-2-5-1-3\">\n                    <div aria-label=\"Health chat transcript\" class=\"hg-transcript\" data-kid=\"1-2-5-1-3-1\">\n                        <div class=\"hg-transcript-row\" data-kid=\"1-2-5-1-3-1-1\">\n                            <span class=\"speaker\" data-kid=\"1-2-5-1-3-1-1-1\">\n                                HealthGraph\n                            </span>\n                            <p data-kid=\"1-2-5-1-3-1-1-2\">\n                                Your sleep averaged 7h 10m this week, up from 6h 20m last week. Energy followed it upward on four of seven days.\n                            </p>\n                        </div>\n                        <div class=\"hg-transcript-row me\" data-kid=\"1-2-5-1-3-1-2\">\n                            <span class=\"speaker\" data-kid=\"1-2-5-1-3-1-2-1\">\n                                You\n                            </span>\n                            <p data-kid=\"1-2-5-1-3-1-2-2\">\n                                Has my stress changed too?\n                            </p>\n                        </div>\n                        <div class=\"hg-transcript-row\" data-kid=\"1-2-5-1-3-1-3\">\n                            <span class=\"speaker\" data-kid=\"1-2-5-1-3-1-3-1\">\n                                HealthGraph\n                            </span>\n                            <p data-kid=\"1-2-5-1-3-1-3-2\">\n                                Down a full point since Monday. The timeline has the daily entries if you want them.\n                            </p>\n                        </div>\n                    </div>\n                    <aside class=\"hg-evidence-card\" data-kid=\"1-2-5-1-3-2\">\n                        <div class=\"hg-kicker\" data-kid=\"1-2-5-1-3-2-1\">\n                            Record excerpt\n                        </div>\n                        <blockquote data-kid=\"1-2-5-1-3-2-2\">\n                            “Mood 4, pain 2, water 1.8 litres...”\n                        </blockquote>\n                        <p data-kid=\"1-2-5-1-3-2-3\">\n                            The assistant reads before it speaks. Answers arrive with the receipts attached: quoted lines from your own documents and, where anatomy is involved, a button that jumps straight to the structure in the 3D body.\n                        </p>\n                        <small data-kid=\"1-2-5-1-3-2-4\">\n                            Sources stay visible. A stop control stays on screen while a reply generates.\n                        </small>\n                    </aside>\n                </div>\n                <div class=\"hg-evidence-wide\" data-kid=\"1-2-5-1-4\" id=\"evidence\">\n                    <div data-kid=\"1-2-5-1-4-1\">\n                        <div class=\"hg-kicker\" data-kid=\"1-2-5-1-4-1-1\">\n                            07 · 3D body, graph, records\n                        </div>\n                        <h3 class=\"hg-section-title\" data-kid=\"1-2-5-1-4-1-2\">\n                            Your body of evidence,\n                            <em data-kid=\"1-2-5-1-4-1-2-1\">\n                                walkable.\n                            </em>\n                        </h3>\n                        <p data-kid=\"1-2-5-1-4-1-3\" style=\"margin-top:21px\">\n                            Metrics become a rotatable anatomical model and a living knowledge graph, and the chat links straight into whichever structure an answer is about. Records arrive the unglamorous way, as PDFs and photos you upload, and leave as extracted values filed into the timeline with the originals one tap away in the profile drawer. Everything connects because everything reads from the same store.\n                        </p>\n                    </div>\n                    <div aria-label=\"Connected evidence motif\" class=\"hg-graph-motif\" data-kid=\"1-2-5-1-4-2\">\n                        <span class=\"hg-graph-lines\" data-kid=\"1-2-5-1-4-2-1\">\n                        </span>\n                        <span class=\"hg-graph-dot\" data-kid=\"1-2-5-1-4-2-2\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"limits-title\" class=\"hg-limits-act\" data-kid=\"1-2-6\" id=\"promises\">\n            <div class=\"hg-wrap\" data-kid=\"1-2-6-1\">\n                <div class=\"hg-limits-head\" data-kid=\"1-2-6-1-1\">\n                    <div class=\"hg-kicker\" data-kid=\"1-2-6-1-1-1\">\n                        05 · Promises\n                    </div>\n                    <h2 class=\"hg-section-title\" data-kid=\"1-2-6-1-1-2\" id=\"limits-title\">\n                        What we\n                        <em data-kid=\"1-2-6-1-1-2-1\">\n                            refuse\n                        </em>\n                        to do.\n                    </h2>\n                </div>\n                <div class=\"hg-limits\" data-kid=\"1-2-6-1-2\">\n                    <article class=\"hg-limit-row\" data-kid=\"1-2-6-1-2-1\">\n                        <h3 data-kid=\"1-2-6-1-2-1-1\">\n                            No invented precision\n                        </h3>\n                        <p data-kid=\"1-2-6-1-2-1-2\">\n                            An estimate ships with its range and its confidence, or it does not ship. Missing days show as missing days. A blank is always more honest than a plausible number.\n                        </p>\n                    </article>\n                    <article class=\"hg-limit-row safety\" data-kid=\"1-2-6-1-2-2\">\n                        <h3 data-kid=\"1-2-6-1-2-2-1\">\n                            No medical cosplay\n                        </h3>\n                        <p data-kid=\"1-2-6-1-2-2-2\">\n                            The app spots patterns and keeps records organized. It does not diagnose, does not prescribe, and says plainly when a question belongs with a clinician.\n                        </p>\n                    </article>\n                    <article class=\"hg-limit-row\" data-kid=\"1-2-6-1-2-3\">\n                        <h3 data-kid=\"1-2-6-1-2-3-1\">\n                            No data market\n                        </h3>\n                        <p data-kid=\"1-2-6-1-2-3-2\">\n                            Your logs sync to your private account for backup and are never sold. Uploaded documents are processed only to build your timeline. Sign out keeps local data on the device.\n                        </p>\n                    </article>\n                    <article class=\"hg-limit-row\" data-kid=\"1-2-6-1-2-4\">\n                        <h3 data-kid=\"1-2-6-1-2-4-1\">\n                            No dead ends offline\n                        </h3>\n                        <p data-kid=\"1-2-6-1-2-4-2\">\n                            Logging, meds, the dial, and history work without a connection and sync quietly when one returns. Anything needing the network says so instead of spinning.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"faq-title\" class=\"hg-faq-act\" data-kid=\"1-2-7\" id=\"faq\">\n            <div class=\"hg-wrap\" data-kid=\"1-2-7-1\">\n                <div class=\"hg-kicker\" data-kid=\"1-2-7-1-1\">\n                    06 · Questions\n                </div>\n                <h2 class=\"hg-section-title\" data-kid=\"1-2-7-1-2\" id=\"faq-title\">\n                    Asked often,\n                    <em data-kid=\"1-2-7-1-2-1\">\n                        answered plainly.\n                    </em>\n                </h2>\n                <div class=\"hg-faq-list\" data-kid=\"1-2-7-1-3\">\n                    <div class=\"hg-faq-item\" data-kid=\"1-2-7-1-3-1\">\n                        <button aria-expanded=\"false\" class=\"hg-faq-q\" data-kid=\"1-2-7-1-3-1-1\" type=\"button\">\n                            Is HealthGraph free?\n                            <span aria-hidden=\"true\" data-kid=\"1-2-7-1-3-1-1-1\">\n                                +\n                            </span>\n                        </button>\n                        <div class=\"hg-faq-answer\" data-dynamic=\"true\" data-kid=\"1-2-7-1-3-1-2\" data-name=\"faq answer container\" data-reason=\"max-height and visibility managed by script on click\">\n                            <p data-kid=\"1-2-7-1-3-1-2-1\">\n                                Yes, the whole app is free during early access, including food scanning, both pulse methods, and the chat. A Premium tier with deeper history and family sharing is planned for later, and early users will keep a founding discount when it arrives.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"hg-faq-item\" data-kid=\"1-2-7-1-3-2\">\n                        <button aria-expanded=\"false\" class=\"hg-faq-q\" data-kid=\"1-2-7-1-3-2-1\" type=\"button\">\n                            How does the food scanner estimate portions from a flat photo?\n                            <span aria-hidden=\"true\" data-kid=\"1-2-7-1-3-2-1-1\">\n                                +\n                            </span>\n                        </button>\n                        <div class=\"hg-faq-answer\" data-dynamic=\"true\" data-kid=\"1-2-7-1-3-2-2\" data-name=\"faq answer container\" data-reason=\"max-height and visibility managed by script on click\">\n                            <p data-kid=\"1-2-7-1-3-2-2-1\">\n                                It compares the food against the plate and utensils in the frame, using a standard plate size as the reference, then converts volume to grams with a density table. That is estimation, which is why every result carries a range and a confidence note, and why the gram steppers sit right under each item before you log.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"hg-faq-item\" data-kid=\"1-2-7-1-3-3\">\n                        <button aria-expanded=\"false\" class=\"hg-faq-q\" data-kid=\"1-2-7-1-3-3-1\" type=\"button\">\n                            Which phones can measure pulse?\n                            <span aria-hidden=\"true\" data-kid=\"1-2-7-1-3-3-1-1\">\n                                +\n                            </span>\n                        </button>\n                        <div class=\"hg-faq-answer\" data-dynamic=\"true\" data-kid=\"1-2-7-1-3-3-2\" data-name=\"faq answer container\" data-reason=\"max-height and visibility managed by script on click\">\n                            <p data-kid=\"1-2-7-1-3-3-2-1\">\n                                Any phone with a camera and flash handles fingertip readings. The face scan needs only a front camera and decent light, and takes about thirty seconds. Both show a live quality meter, and a reading that fails it is discarded with an explanation instead of being saved.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"hg-faq-item\" data-kid=\"1-2-7-1-3-4\">\n                        <button aria-expanded=\"false\" class=\"hg-faq-q\" data-kid=\"1-2-7-1-3-4-1\" type=\"button\">\n                            What happens to my data if I stop using the app?\n                            <span aria-hidden=\"true\" data-kid=\"1-2-7-1-3-4-1-1\">\n                                +\n                            </span>\n                        </button>\n                        <div class=\"hg-faq-answer\" data-dynamic=\"true\" data-kid=\"1-2-7-1-3-4-2\" data-name=\"faq answer container\" data-reason=\"max-height and visibility managed by script on click\">\n                            <p data-kid=\"1-2-7-1-3-4-2-1\">\n                                Signing out leaves your local data on the device, and uninstalling removes it. Your synced account keeps the backup until you ask for deletion from the account screen. Nothing is retained for advertising under any circumstance, because there is no advertising.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"hg-faq-item open\" data-kid=\"1-2-7-1-3-5\">\n                        <button aria-expanded=\"true\" class=\"hg-faq-q\" data-kid=\"1-2-7-1-3-5-1\" type=\"button\">\n                            Can it replace my doctor?\n                            <span aria-hidden=\"true\" data-kid=\"1-2-7-1-3-5-1-1\">\n                                +\n                            </span>\n                        </button>\n                        <div class=\"hg-faq-answer\" data-dynamic=\"true\" data-kid=\"1-2-7-1-3-5-2\" data-name=\"faq answer container\" data-reason=\"max-height and visibility managed by script on click\">\n                            <p data-kid=\"1-2-7-1-3-5-2-1\">\n                                No, and it will tell you so inside the app as well. HealthGraph exists to make the patterns visible and the records organized so your appointments go further. Diagnosis and treatment stay with qualified clinicians.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"get-title\" class=\"hg-access-act\" data-kid=\"1-2-8\" id=\"get\">\n            <div class=\"hg-wrap\" data-kid=\"1-2-8-1\">\n                <div class=\"hg-access-sheet\" data-kid=\"1-2-8-1-1\">\n                    <div class=\"hg-kicker\" data-kid=\"1-2-8-1-1-1\">\n                        Early access / iOS + Android\n                    </div>\n                    <h2 data-kid=\"1-2-8-1-1-2\" id=\"get-title\">\n                        Get HealthGraph while it is\n                        <em data-kid=\"1-2-8-1-1-2-1\">\n                            free.\n                        </em>\n                    </h2>\n                    <p data-kid=\"1-2-8-1-1-3\">\n                        One account across iOS and Android, with history everywhere you sign in. Tap below and an email opens, addressed and ready. Send it and we reply with your invite link.\n                    </p>\n                    <div class=\"hg-store-row\" data-kid=\"1-2-8-1-1-4\">\n                        <a class=\"hg-store\" data-kid=\"1-2-8-1-1-4-1\" href=\"mailto:hello@healthgraph.app?subject=HealthGraph%20early%20access\">\n                            <small data-kid=\"1-2-8-1-1-4-1-1\">\n                                Get it on\n                            </small>\n                            App Store\n                        </a>\n                        <a class=\"hg-store\" data-kid=\"1-2-8-1-1-4-2\" href=\"mailto:hello@healthgraph.app?subject=HealthGraph%20early%20access\">\n                            <small data-kid=\"1-2-8-1-1-4-2-1\">\n                                Get it on\n                            </small>\n                            Google Play\n                        </a>\n                    </div>\n                    <p class=\"hg-fine\" data-kid=\"1-2-8-1-1-5\">\n                        One email from you, one invite back from us. No newsletter, no drip campaign, unsubscribe by replying stop.\n                    </p>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"hg-footer\" data-kid=\"1-3\">\n        <div class=\"hg-wrap\" data-kid=\"1-3-1\">\n            <div class=\"hg-footer-top\" data-kid=\"1-3-1-1\">\n                <a class=\"hg-brand\" data-kid=\"1-3-1-1-1\" href=\"#top\">\n                    <span aria-hidden=\"true\" class=\"hg-mark\" data-kid=\"1-3-1-1-1-1\">\n                    </span>\n                    HealthGraph\n                </a>\n                <span data-kid=\"1-3-1-1-2\">\n                    Set in Poppins, with an italic serif for emphasis. One HTML file, no trackers, no cookies.\n                    <br data-kid=\"1-3-1-1-2-1\"/>\n                    © 2026 HealthGraph.\n                </span>\n            </div>\n            <p class=\"hg-disclaimer\" data-kid=\"1-3-1-2\">\n                HealthGraph is a wellness companion, not a medical device. Everything on this page and in the app is informational only and never medical advice, diagnosis, or treatment. Consult a qualified clinician about any health concern.\n            </p>\n        </div>\n    </footer>\n</div>\n<script>\n    (function(){\n  var phaseCopy=[\n    'Sleep, energy, water, stress, movement, wellbeing, pain, meals, heart, and doses each get a spoke, and each spoke sits inside its healthy band or steps outside it where you can see it happen.',\n    'Scroll and the ring draws itself. Every spoke lands where the latest logs would put it. The count in the middle is simply how many spokes sit inside their bands right now.',\n    'This is the same dial that lives in the app, replaying any of the last thirty days from the slider under it. The chapters below walk through everything feeding it.'\n  ];\n  var phases=document.querySelectorAll('.hg-phase'), copy=document.getElementById('dial-phase-copy'), center=document.getElementById('dial-center'), band=document.getElementById('dial-band');\n  phases.forEach(function(btn){btn.addEventListener('click',function(){var p=Number(btn.dataset.phase);phases.forEach(function(b){b.setAttribute('aria-selected',b===btn?'true':'false')});copy.textContent=phaseCopy[p];center.textContent=String(6+p);band.style.strokeDashoffset=String(280-p*90)})});\n  var faqButtons=document.querySelectorAll('.hg-faq-q');\n  faqButtons.forEach(function(btn){btn.addEventListener('click',function(){var item=btn.parentElement, open=item.classList.contains('open');document.querySelectorAll('.hg-faq-item.open').forEach(function(other){other.classList.remove('open');other.querySelector('.hg-faq-q').setAttribute('aria-expanded','false')});if(!open){item.classList.add('open');btn.setAttribute('aria-expanded','true')}})});\n  if('IntersectionObserver' in window){var dial=document.getElementById('dial');var observer=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(entry.isIntersecting){dial.classList.add('is-visible');observer.disconnect()}})},{threshold:.2});observer.observe(dial)}\n})();\n</script>\n",
      "comments": [],
      "created": "2026-09-18T14:15:33.595017+00:00",
      "modified": "2026-09-18T14:16:39.600892+00:00",
      "id": "var_4db6641baa81",
      "viewportScrollY": 0
    },
    "var_58679708ff11": {
      "type": "variant",
      "label": "Field Journal — HealthGraph",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&family=Poppins:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n:root{--stage:#0B4A3F;--stage-deep:#07332B;--paper:#fff;--ink:#14201D;--body:#3E4F4A;--muted:#7A8B85;--line:#DDE7E2;--wash:#EFF5F2;--cta:#0B7A55;--teal:#4FD1C5;--pulse:#D7263D;--fog:#A7B8B2;--font:'Poppins',system-ui,-apple-system,sans-serif;--serif:'Instrument Serif',Georgia,serif}\n@layer base{*,*::before,*::after{box-sizing:border-box}}\nhtml{scroll-behavior:smooth}\nbody{margin:0;background:var(--stage);color:#fff;font-family:var(--font);-webkit-font-smoothing:antialiased;overflow-x:hidden}\na{color:inherit;text-decoration:none}\nbutton{font:inherit}\n::selection{background:var(--teal);color:var(--stage-deep)}\n.shell{max-width:1180px;margin:0 auto;padding:0 28px}\n.rule{border-top:1px solid rgba(255,255,255,.2)}\n.eyebrow{font-size:12px;line-height:1.3;letter-spacing:.08em;text-transform:uppercase;color:var(--teal);font-weight:600}\n.serif{font-family:var(--serif);font-style:italic;font-weight:400}\nnav{position:sticky;top:0;z-index:50;background:rgba(11,74,63,.94);border-bottom:1px solid rgba(255,255,255,.14);backdrop-filter:blur(14px)}\n.nav-inner{min-height:70px;display:flex;align-items:center;gap:20px}\n.brand{display:inline-flex;align-items:center;gap:10px;font-size:16px;font-weight:600;letter-spacing:-.03em;white-space:nowrap}\n.mark{width:25px;height:25px;border:2px solid var(--teal);border-radius:50%;position:relative;display:inline-block}\n.mark:before{content:\"\";position:absolute;inset:5px;border:1px solid var(--teal);border-radius:50%}.mark:after{content:\"\";position:absolute;inset:9px;background:var(--teal);border-radius:50%}\n.nav-links{display:flex;gap:22px;margin-left:auto;color:#D7E7E1;font-size:13px}.nav-links a{position:relative;padding:7px 0}.nav-links a:after{content:\"\";position:absolute;left:0;right:100%;bottom:1px;height:1px;background:var(--teal);transition:right .25s ease}.nav-links a:hover:after,.nav-links a:focus-visible:after{right:0}\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;cursor:pointer;min-height:44px;padding:0 20px;border-radius:999px;font-size:13px;font-weight:600;transition:background .25s ease,color .25s ease,border-color .25s ease,transform .25s ease}.btn:focus-visible,.text-link:focus-visible,.phase:focus-visible,.faq-q:focus-visible{outline:3px solid rgba(79,209,197,.72);outline-offset:4px}\n.btn-white{background:#fff;color:var(--ink)}.btn-white:hover{background:var(--teal);transform:translateY(-1px)}\n.btn-green{background:var(--cta);color:#fff}.btn-green:hover{background:#095F43;transform:translateY(-1px)}\n.text-link{display:inline-flex;align-items:center;gap:8px;color:#fff;text-decoration:underline;text-underline-offset:4px;font-size:13px;font-weight:500}.text-link i{font-size:16px;transition:transform .25s ease}.text-link:hover i{transform:translateX(4px)}\n.hero{min-height:720px;display:grid;grid-template-columns:minmax(0,1.08fr) minmax(360px,.72fr);gap:64px;align-items:center;padding:72px 0 78px;position:relative;overflow:hidden}.hero:before{content:\"\";position:absolute;width:520px;height:520px;border:1px solid rgba(255,255,255,.08);border-radius:50%;right:31%;top:96px;pointer-events:none}.hero-copy{position:relative;z-index:1}.hero-kicker{display:flex;align-items:center;gap:10px;padding-bottom:17px;border-bottom:1px solid rgba(79,209,197,.55);max-width:510px;color:#E0ECE8;font-size:12px}.hero-kicker span{display:inline-block;width:7px;height:7px;background:var(--teal);border-radius:50%}.hero h1{font-size:clamp(50px,6.4vw,82px);line-height:1.02;letter-spacing:-.065em;font-weight:600;max-width:780px;margin:31px 0 22px}.hero h1 .serif{color:var(--teal);font-size:1.06em;letter-spacing:-.02em}.hero-lede{font-size:16px;line-height:1.75;color:#DCEAE5;max-width:565px}.hero-actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:32px}.hero-note{font-size:12px;color:var(--fog);margin-top:17px}.hero-media{height:530px;background:var(--stage-deep);position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.2);border-radius:4px}.hero-media video{width:100%;height:100%;object-fit:cover;opacity:.66;display:block}.hero-media:after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,51,43,.08),rgba(7,51,43,.7))}.media-caption{position:absolute;z-index:2;bottom:20px;left:20px;right:20px;font-size:11px;color:#E6F1ED;line-height:1.5;border-top:1px solid rgba(255,255,255,.3);padding-top:10px}.media-caption b{color:var(--teal);font-weight:500}\n.intro{padding:18px 0 92px}.reading-grid{display:grid;grid-template-columns:170px minmax(0,1fr);gap:54px;align-items:start}.toc{position:sticky;top:96px;padding-top:2px}.toc-title{color:var(--fog);font-size:11px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:17px}.toc a{display:flex;gap:9px;align-items:baseline;color:#C9DDD6;font-size:12px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.1)}.toc a span{font-variant-numeric:tabular-nums;color:var(--teal);font-size:11px}.toc a:hover{color:#fff}.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:24px}.section-head h2{font-size:clamp(32px,4.5vw,54px);line-height:1.08;letter-spacing:-.05em;margin:0;font-weight:600}.section-head h2 .serif{color:var(--teal)}.head-note{max-width:190px;text-align:right;color:var(--fog);font-size:11px;line-height:1.5}.lede{color:#D7E6E0;font-size:16px;line-height:1.75;max-width:650px;margin:18px 0 0}.paper{background:var(--paper);color:var(--ink);border-radius:22px;padding:clamp(28px,4vw,52px)}\n.ledger-sheet{margin-top:34px}.ledger{margin-top:30px;border-top:1px solid var(--line)}.ledger-row{display:grid;grid-template-columns:112px minmax(0,1fr) auto;gap:20px;align-items:baseline;padding:21px 4px;border-bottom:1px solid var(--line)}.ledger-row .when{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}.ledger-row .what{font-size:15px;font-weight:600}.ledger-row .what small{display:block;font-size:13px;line-height:1.6;font-weight:400;color:var(--body);margin-top:4px}.ledger-row .val{font-size:13px;font-weight:600;color:var(--cta);white-space:nowrap}.ledger-row a{color:inherit}.ledger-row:hover{border-bottom-color:var(--teal)}\n.dial-section{padding:110px 0 122px;background:var(--stage-deep);border-top:1px solid rgba(255,255,255,.12);border-bottom:1px solid rgba(255,255,255,.12)}.dial-grid{display:grid;grid-template-columns:minmax(0,.75fr) minmax(390px,1fr);gap:52px;align-items:center}.dial-copy h2{font-size:clamp(34px,4.6vw,58px);line-height:1.07;letter-spacing:-.055em;margin:15px 0 0}.dial-copy h2 .serif{color:var(--teal)}.dial-copy p{max-width:440px;color:#D2E3DC;line-height:1.75;font-size:15px;margin:20px 0 0}.dial-legend{display:flex;gap:0;margin-top:30px;border-top:1px solid rgba(255,255,255,.25);border-bottom:1px solid rgba(255,255,255,.25);max-width:440px}.phase{border:0;background:transparent;color:var(--fog);text-align:left;padding:13px 13px 12px 0;margin-right:18px;cursor:pointer;font-size:11px;position:relative}.phase:after{content:\"\";position:absolute;left:0;right:100%;bottom:-1px;height:2px;background:var(--teal);transition:right .25s ease}.phase[aria-pressed=\"true\"]{color:var(--teal)}.phase[aria-pressed=\"true\"]:after{right:0}.dial-visual{min-height:470px;display:flex;align-items:center;justify-content:center;position:relative}.dial-visual:after{content:\"\";position:absolute;width:440px;height:440px;border:1px solid rgba(255,255,255,.07);border-radius:50%}.dial-svg{width:min(100%,510px);position:relative;z-index:1}.dial-svg text{font-family:var(--font)}\n.chapter{padding:112px 0;border-bottom:1px solid rgba(255,255,255,.12)}.chapter h2{font-size:clamp(34px,5vw,62px);letter-spacing:-.06em;line-height:1.06;font-weight:600;max-width:820px;margin:15px 0 0}.chapter h2 .serif{color:var(--teal)}.chapter .chapter-lede{font-size:17px;color:#D7E6E0;line-height:1.8;max-width:730px;margin-top:22px}.feature-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:22px;margin-top:46px}.food-sheet{display:grid;grid-template-columns:.82fr 1.18fr;gap:34px;align-items:stretch}.figure{position:relative;min-height:390px;border-radius:14px;overflow:hidden;background:var(--stage-deep)}.figure img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.84) contrast(.95)}.figure:after{content:\"\";position:absolute;inset:12px;border:1px solid rgba(255,255,255,.6);pointer-events:none}.figure-caption{position:absolute;z-index:2;bottom:12px;left:12px;right:12px;background:rgba(7,51,43,.9);color:#fff;padding:10px 12px;font-size:11px;line-height:1.45}.fact-copy h3,.paper h3{font-size:clamp(22px,2.8vw,32px);line-height:1.15;letter-spacing:-.04em;margin:0;font-weight:600}.fact-copy p,.paper p{font-size:14px;color:var(--body);line-height:1.75;margin:14px 0 0}.facts{border-top:1px solid var(--line);margin-top:22px}.facts div{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--line);font-size:12px;line-height:1.4}.facts span:first-child{color:var(--muted)}.facts span:last-child{font-weight:600;text-align:right}.scan-frame{margin-top:22px;border:1px dashed var(--cta);padding:11px;position:relative}.scan-inner{height:7px;border-radius:4px;background:var(--teal);width:46%;margin-bottom:12px}.scan-frame small{font-size:11px;color:var(--body)}\n.pulse-band{margin-top:22px;background:rgba(0,0,0,.18);border:1px solid rgba(255,255,255,.14);border-radius:22px;padding:34px 38px;display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:center}.pulse-band h3{font-size:28px;line-height:1.12;margin:0;letter-spacing:-.04em}.pulse-band p{font-size:14px;line-height:1.75;color:#D4E3DE;margin:14px 0 0}.pulse-photo{height:190px;border-radius:12px;overflow:hidden;position:relative}.pulse-photo img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.68) brightness(.78)}.pulse-photo:after{content:\"\";position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,51,43,.7),transparent 65%)}.pulse-line{position:absolute;z-index:2;inset:0;width:100%;height:100%}.pulse-path{stroke-dasharray:620;stroke-dashoffset:620;transition:stroke-dashoffset 1.7s ease}.pulse-band.in-view .pulse-path{stroke-dashoffset:0}\n.two-col{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:44px}.paper.tall{min-height:300px}.mock-phone{width:220px;background:#fff;border-radius:28px;padding:12px;margin:auto;color:var(--ink)}.mock-screen{background:var(--wash);border-radius:19px;padding:14px;display:grid;gap:9px}.mock-row{background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px;font-size:11px;font-weight:600;display:flex;justify-content:space-between;gap:8px}.mock-row small{font-size:10px;font-weight:400;color:var(--muted)}.mock-cta{background:var(--cta);color:#fff;padding:10px;border-radius:999px;text-align:center;font-size:11px;font-weight:600}.visual{min-height:300px;background:rgba(0,0,0,.16);border:1px solid rgba(255,255,255,.14);border-radius:22px;display:flex;align-items:center;justify-content:center;padding:30px}.body-mock{display:flex;gap:18px;align-items:center}.body-fig{width:100px;height:188px;border-radius:52px;background:rgba(255,255,255,.08);border:2px solid rgba(255,255,255,.52);position:relative}.body-fig:before{content:\"\";position:absolute;left:31px;top:-21px;width:34px;height:34px;border:2px solid rgba(255,255,255,.52);border-radius:50%}.body-fig i{position:absolute;width:14px;height:14px;background:var(--pulse);border-radius:50%;box-shadow:0 0 0 5px rgba(215,38,61,.18)}.body-fig i:first-child{top:58px;left:25px}.body-fig i:last-child{top:112px;right:22px}.body-list{display:grid;gap:8px}.body-list div{background:#fff;color:var(--ink);font-size:11px;font-weight:600;border-radius:9px;padding:8px 10px}\n.chat-spread{display:grid;grid-template-columns:1.1fr .9fr;gap:22px;margin-top:46px;align-items:stretch}.chat-pane{background:var(--stage-deep);border:1px solid rgba(255,255,255,.16);border-radius:22px;padding:32px;display:grid;align-content:center;gap:12px}.bubble{font-size:13px;line-height:1.6;padding:12px 14px;border-radius:14px;max-width:88%}.bubble.them{background:#fff;color:var(--ink);border-bottom-left-radius:4px}.bubble.me{background:var(--cta);color:#fff;justify-self:end;border-bottom-right-radius:4px}.evidence{position:relative}.evidence:before{content:\"\";position:absolute;top:0;left:0;width:3px;height:32px;background:var(--teal)}.evidence blockquote{margin:20px 0 0;padding:17px 0 0;border-top:1px solid var(--line);font-size:14px;line-height:1.7;color:var(--body)}.evidence cite{display:block;margin-top:14px;font-size:11px;color:var(--muted);font-style:normal}.evidence p{margin-top:19px}.evidence-link{display:inline-flex;align-items:center;gap:7px;color:var(--cta);font-size:12px;font-weight:600;margin-top:22px}.evidence-link i{font-size:16px}.motif{height:190px;margin-top:38px;display:flex;justify-content:center;align-items:center;position:relative}.motif:before,.motif:after{content:\"\";position:absolute;border:1px solid rgba(79,209,197,.48);border-radius:50%}.motif:before{width:160px;height:160px}.motif:after{width:80px;height:80px}.motif span{width:7px;height:7px;border-radius:50%;background:var(--teal);position:absolute;top:39px;left:calc(50% + 30px)}\n.promise-list{margin-top:42px;border-top:1px solid rgba(255,255,255,.22)}.promise-row{display:grid;grid-template-columns:minmax(180px,.7fr) minmax(0,1.3fr);gap:30px;padding:25px 4px;border-bottom:1px solid rgba(255,255,255,.22)}.promise-row b{font-size:16px}.promise-row p{font-size:14px;line-height:1.75;color:#D5E4DE;margin:0}.promise-row.safety b:before{content:\"\";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--pulse);margin:0 9px 2px 0}\n.faq-wrap{max-width:820px;margin:42px auto 0}.faq-item{background:#fff;color:var(--ink);border-bottom:1px solid var(--line)}.faq-q{width:100%;display:flex;justify-content:space-between;gap:20px;align-items:center;background:transparent;border:0;color:var(--ink);padding:21px 22px;text-align:left;cursor:pointer;font-size:14px;font-weight:600}.faq-q i{color:var(--cta);font-size:18px;transition:transform .25s ease}.faq-item.open .faq-q i{transform:rotate(45deg)}.faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease}.faq-a p{padding:0 22px 22px;color:var(--body);font-size:13px;line-height:1.75;margin:0}.faq-item.open .faq-a{max-height:240px}\n.get-sheet{margin-top:44px}.get-sheet h2{font-size:clamp(32px,4.5vw,54px);line-height:1.08;letter-spacing:-.055em;max-width:670px;margin:0}.get-sheet h2 .serif{color:var(--cta)}.get-sheet p{max-width:590px;color:var(--body);font-size:15px;line-height:1.75;margin:18px 0 0}.get-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:27px}.store{display:inline-flex;align-items:center;gap:10px;background:var(--ink);color:#fff;border-radius:12px;padding:12px 18px;font-size:13px;font-weight:600}.store small{font-size:9px;color:#B9C6C1;display:block;font-weight:400}.fine{font-size:11px!important;color:var(--muted)!important;margin-top:20px!important}.fine a{color:var(--cta);font-weight:600}\nfooter{padding:48px 0 64px;border-top:1px solid rgba(255,255,255,.16);color:var(--fog);font-size:12px}.footer-row{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;flex-wrap:wrap}.disclaimer{max-width:680px;margin:18px 0 0;line-height:1.75;font-size:11px}.colophon{font-size:11px;line-height:1.7;text-align:right}\n@media(max-width:900px){.hero{grid-template-columns:1fr;gap:38px;padding-top:54px}.hero-media{height:390px;max-width:620px}.hero:before{right:-150px}.reading-grid{grid-template-columns:1fr}.toc{position:static;display:flex;gap:10px;overflow-x:auto;padding:0 0 9px;border-bottom:1px solid rgba(255,255,255,.2)}.toc-title{display:none}.toc a{border:0;white-space:nowrap;padding:4px 12px 4px 0}.dial-grid{grid-template-columns:1fr}.dial-visual{order:-1;min-height:390px}.feature-grid,.food-sheet,.chat-spread{grid-template-columns:1fr}.head-note{max-width:150px}.pulse-band{grid-template-columns:1fr}.pulse-photo{height:210px}.promise-row{grid-template-columns:1fr;gap:12px}}\n@media(max-width:600px){.shell{padding:0 20px}.nav-inner{min-height:62px}.nav-links{display:none}.nav-inner>.btn{margin-left:auto;padding:0 14px;min-height:38px;font-size:12px}.hero{min-height:0;padding:58px 0 64px}.hero h1{font-size:clamp(45px,13vw,68px);margin-top:25px}.hero-lede{font-size:15px}.hero-media{height:300px}.section-head{display:block}.head-note{text-align:left;margin-top:14px}.paper{border-radius:16px;padding:26px 22px}.ledger-row{grid-template-columns:1fr auto;gap:7px 14px}.ledger-row .when{grid-column:1/-1}.ledger-row .val{grid-column:2;grid-row:2}.dial-section,.chapter{padding:78px 0}.dial-visual{min-height:310px}.dial-visual:after{width:300px;height:300px}.dial-legend{max-width:none}.phase{font-size:10px;margin-right:9px}.pulse-band{padding:25px 20px;border-radius:16px}.two-col{grid-template-columns:1fr;margin-top:28px}.visual{min-height:280px;border-radius:16px}.chapter h2{font-size:clamp(34px,11vw,49px)}.get-sheet{margin-top:28px}.get-actions{display:grid;grid-template-columns:1fr}.store{justify-content:center}.colophon{text-align:left}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn,.text-link i,.phase:after,.faq-q i,.faq-a,.pulse-path{transition:none}.pulse-path{stroke-dashoffset:0}.hero-media video{display:none}}\n</style>\n<nav aria-label=\"Primary navigation\" data-kid=\"1\">\n    <div class=\"shell nav-inner\" data-kid=\"1-1\">\n        <a class=\"brand\" data-kid=\"1-1-1\" href=\"#top\">\n            <span aria-hidden=\"true\" class=\"mark\" data-kid=\"1-1-1-1\">\n            </span>\n            HealthGraph\n        </a>\n        <div class=\"nav-links\" data-kid=\"1-1-2\">\n            <a data-kid=\"1-1-2-1\" href=\"#inside\">\n                Inside\n            </a>\n            <a data-kid=\"1-1-2-2\" href=\"#dial\">\n                Dial\n            </a>\n            <a data-kid=\"1-1-2-3\" href=\"#promises\">\n                Promises\n            </a>\n            <a data-kid=\"1-1-2-4\" href=\"#faq\">\n                FAQ\n            </a>\n        </div>\n        <a class=\"btn btn-white\" data-kid=\"1-1-3\" href=\"#get\">\n            Get the app\n        </a>\n    </div>\n</nav>\n<main data-kid=\"2\" id=\"top\">\n    <header aria-labelledby=\"hero-title\" class=\"shell hero\" data-kid=\"2-1\">\n        <div class=\"hero-copy\" data-kid=\"2-1-1\">\n            <div class=\"hero-kicker\" data-kid=\"2-1-1-1\">\n                <span aria-hidden=\"true\" data-kid=\"2-1-1-1-1\">\n                </span>\n                Sleep · Symptoms · Meds · Meals · Pulse · Records\n            </div>\n            <h1 data-kid=\"2-1-1-2\" id=\"hero-title\">\n                Your whole health\n                <br data-kid=\"2-1-1-2-1\"/>\n                in\n                <span class=\"serif\" data-kid=\"2-1-1-2-2\">\n                    one dial.\n                </span>\n            </h1>\n            <p class=\"hero-lede\" data-kid=\"2-1-1-3\">\n                HealthGraph keeps your sleep, symptoms, medicines, meals, pulse readings, and medical records in one place, then shows what they add up to across ten spokes you can scrub back through thirty days.\n            </p>\n            <div class=\"hero-actions\" data-kid=\"2-1-1-4\">\n                <a class=\"btn btn-white\" data-kid=\"2-1-1-4-1\" href=\"#get\">\n                    Get HealthGraph free\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"2-1-1-4-1-1\">\n                    </i>\n                </a>\n                <a class=\"text-link\" data-kid=\"2-1-1-4-2\" href=\"#inside\">\n                    Look inside first\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-down\" data-kid=\"2-1-1-4-2-1\">\n                    </i>\n                </a>\n            </div>\n            <p class=\"hero-note\" data-kid=\"2-1-1-5\">\n                Free during early access. iOS and Android. Your data stays yours.\n            </p>\n        </div>\n        <figure aria-label=\"HealthGraph app opening film\" class=\"hero-media\" data-kid=\"2-1-2\">\n            <video autoplay=\"\" data-dynamic=\"true\" data-kid=\"2-1-2-1\" data-name=\"hero video\" data-reason=\"source reinitialized by script to manage video loading\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/photos/34590137/pexels-photo-34590137.jpeg?auto=compress&cs=tinysrgb&w=900&q=80\" preload=\"metadata\">\n                <source data-kid=\"2-1-2-1-1\" src=\"../assets/app-load.mp4\" type=\"video/mp4\"/>\n                <source data-kid=\"2-1-2-1-2\" src=\"frontend/assets/app-load.mp4\" type=\"video/mp4\"/>\n            </video>\n            <figcaption class=\"media-caption\" data-kid=\"2-1-2-2\">\n                <b data-kid=\"2-1-2-2-1\">\n                    Figure 00\n                </b>\n                · The app opens with the same record you build one ordinary day at a time.\n            </figcaption>\n        </figure>\n    </header>\n    <section aria-labelledby=\"inside-title\" class=\"shell intro\" data-kid=\"2-2\" id=\"inside\">\n        <div class=\"reading-grid\" data-kid=\"2-2-1\">\n            <aside aria-label=\"On this page\" class=\"toc\" data-kid=\"2-2-1-1\">\n                <div class=\"toc-title\" data-kid=\"2-2-1-1-1\">\n                    On this page\n                </div>\n                <a data-kid=\"2-2-1-1-2\" href=\"#record\">\n                    <span data-kid=\"2-2-1-1-2-1\">\n                        01\n                    </span>\n                    A day\n                </a>\n                <a data-kid=\"2-2-1-1-3\" href=\"#dial\">\n                    <span data-kid=\"2-2-1-1-3-1\">\n                        02\n                    </span>\n                    The dial\n                </a>\n                <a data-kid=\"2-2-1-1-4\" href=\"#food\">\n                    <span data-kid=\"2-2-1-1-4-1\">\n                        03\n                    </span>\n                    Food scan\n                </a>\n                <a data-kid=\"2-2-1-1-5\" href=\"#chat\">\n                    <span data-kid=\"2-2-1-1-5-1\">\n                        04\n                    </span>\n                    Health chat\n                </a>\n                <a data-kid=\"2-2-1-1-6\" href=\"#pulse\">\n                    <span data-kid=\"2-2-1-1-6-1\">\n                        05\n                    </span>\n                    Pulse\n                </a>\n                <a data-kid=\"2-2-1-1-7\" href=\"#treatment\">\n                    <span data-kid=\"2-2-1-1-7-1\">\n                        06\n                    </span>\n                    Treatment\n                </a>\n                <a data-kid=\"2-2-1-1-8\" href=\"#promises\">\n                    <span data-kid=\"2-2-1-1-8-1\">\n                        07\n                    </span>\n                    Promises\n                </a>\n            </aside>\n            <div data-kid=\"2-2-1-2\">\n                <div class=\"section-head\" data-kid=\"2-2-1-2-1\">\n                    <h2 data-kid=\"2-2-1-2-1-1\" id=\"inside-title\">\n                        Everything below lives in the app, and all of it reads from the same data.\n                    </h2>\n                    <p class=\"head-note\" data-kid=\"2-2-1-2-1-2\">\n                        The whole product, in the order it becomes useful.\n                    </p>\n                </div>\n                <p class=\"lede\" data-kid=\"2-2-1-2-2\">\n                    Log something once and it shows up everywhere it matters. The list below is the whole product, and nothing on it is a mockup.\n                </p>\n                <div class=\"paper ledger-sheet\" data-kid=\"2-2-1-2-3\" id=\"record\">\n                    <div class=\"eyebrow\" data-kid=\"2-2-1-2-3-1\" style=\"color:var(--cta)\">\n                        01 · Daily log and timeline\n                    </div>\n                    <h3 data-kid=\"2-2-1-2-3-2\" style=\"font-size:clamp(24px,3.4vw,38px);letter-spacing:-.05em;line-height:1.1;margin:10px 0 0\">\n                        A day, before it becomes a\n                        <span class=\"serif\" data-kid=\"2-2-1-2-3-2-1\" style=\"color:var(--cta)\">\n                            score.\n                        </span>\n                    </h3>\n                    <p data-kid=\"2-2-1-2-3-3\" style=\"color:var(--body);font-size:14px;line-height:1.75;max-width:620px;margin:15px 0 0\">\n                        Sixty seconds in, a lifetime ledger out. The daily sheet is sliders and chips, almost no keyboard: mood, sleep, water, meals, activity, pain, vitals, and a notes line for anything the sliders cannot say.\n                    </p>\n                    <div class=\"ledger\" data-kid=\"2-2-1-2-3-4\">\n                        <a class=\"ledger-row\" data-kid=\"2-2-1-2-3-4-1\" href=\"#dial\">\n                            <span class=\"when\" data-kid=\"2-2-1-2-3-4-1-1\">\n                                Today\n                            </span>\n                            <span class=\"what\" data-kid=\"2-2-1-2-3-4-1-2\">\n                                Evening log\n                                <small data-kid=\"2-2-1-2-3-4-1-2-1\">\n                                    Mood 4, pain 2, water 1.8 litres, notes about the headache after lunch.\n                                </small>\n                            </span>\n                            <span class=\"val\" data-kid=\"2-2-1-2-3-4-1-3\">\n                                Saved\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"2-2-1-2-3-4-1-3-1\">\n                                </i>\n                            </span>\n                        </a>\n                        <a class=\"ledger-row\" data-kid=\"2-2-1-2-3-4-2\" href=\"#treatment\">\n                            <span class=\"when\" data-kid=\"2-2-1-2-3-4-2-1\">\n                                Yesterday\n                            </span>\n                            <span class=\"what\" data-kid=\"2-2-1-2-3-4-2-2\">\n                                Amtiva 5g, morning dose\n                                <small data-kid=\"2-2-1-2-3-4-2-2-1\">\n                                    Taken at 8:04, four minutes after the reminder.\n                                </small>\n                            </span>\n                            <span class=\"val\" data-kid=\"2-2-1-2-3-4-2-3\">\n                                Taken\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"2-2-1-2-3-4-2-3-1\">\n                                </i>\n                            </span>\n                        </a>\n                        <a class=\"ledger-row\" data-kid=\"2-2-1-2-3-4-3\" href=\"#evidence\">\n                            <span class=\"when\" data-kid=\"2-2-1-2-3-4-3-1\">\n                                Sep 14\n                            </span>\n                            <span class=\"what\" data-kid=\"2-2-1-2-3-4-3-2\">\n                                Lipid panel, uploaded PDF\n                                <small data-kid=\"2-2-1-2-3-4-3-2-1\">\n                                    Extraction finished overnight. Two values flagged in place.\n                                </small>\n                            </span>\n                            <span class=\"val\" data-kid=\"2-2-1-2-3-4-3-3\">\n                                Ready\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"2-2-1-2-3-4-3-3-1\">\n                                </i>\n                            </span>\n                        </a>\n                        <a class=\"ledger-row\" data-kid=\"2-2-1-2-3-4-4\" href=\"#pulse\">\n                            <span class=\"when\" data-kid=\"2-2-1-2-3-4-4-1\">\n                                Sep 12\n                            </span>\n                            <span class=\"what\" data-kid=\"2-2-1-2-3-4-4-2\">\n                                Face pulse check\n                                <small data-kid=\"2-2-1-2-3-4-4-2-1\">\n                                    72 bpm, good quality, thirty second scan.\n                                </small>\n                            </span>\n                            <span class=\"val\" data-kid=\"2-2-1-2-3-4-4-3\">\n                                72\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"2-2-1-2-3-4-4-3-1\">\n                                </i>\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"dial-title\" class=\"dial-section\" data-kid=\"2-3\" id=\"dial\">\n        <div class=\"shell dial-grid\" data-kid=\"2-3-1\">\n            <div class=\"dial-copy\" data-kid=\"2-3-1-1\">\n                <div class=\"eyebrow\" data-kid=\"2-3-1-1-1\">\n                    02 · The insight dial\n                </div>\n                <h2 data-kid=\"2-3-1-1-2\" id=\"dial-title\">\n                    One ring. Ten signals.\n                    <span class=\"serif\" data-kid=\"2-3-1-1-2-1\">\n                        Your call\n                    </span>\n                    what it shows next.\n                </h2>\n                <p data-dynamic=\"true\" data-kid=\"2-3-1-1-3\" data-name=\"dial explanation text\" data-reason=\"text updated when phase buttons are clicked\" id=\"dial-copy\">\n                    Sleep, energy, water, stress, movement, wellbeing, pain, meals, heart, and doses each get a spoke, and each spoke sits inside its healthy band or steps outside it where you can see it happen.\n                </p>\n                <div aria-label=\"Dial explanation phases\" class=\"dial-legend\" data-kid=\"2-3-1-1-4\" role=\"group\">\n                    <button aria-pressed=\"true\" class=\"phase\" data-dynamic=\"true\" data-kid=\"2-3-1-1-4-1\" data-name=\"signals phase button\" data-phase=\"0\" data-reason=\"aria-pressed attribute toggled by script\">\n                        signals\n                    </button>\n                    <button aria-pressed=\"false\" class=\"phase\" data-dynamic=\"true\" data-kid=\"2-3-1-1-4-2\" data-name=\"today phase button\" data-phase=\"1\" data-reason=\"aria-pressed attribute toggled by script\">\n                        today\n                    </button>\n                    <button aria-pressed=\"false\" class=\"phase\" data-dynamic=\"true\" data-kid=\"2-3-1-1-4-3\" data-name=\"thirty days phase button\" data-phase=\"2\" data-reason=\"aria-pressed attribute toggled by script\">\n                        thirty days\n                    </button>\n                </div>\n            </div>\n            <div class=\"dial-visual\" data-kid=\"2-3-1-2\">\n                <svg aria-label=\"Ten spoke health insight dial\" class=\"dial-svg\" data-kid=\"2-3-1-2-1\" id=\"dialSvg\" role=\"img\" viewbox=\"0 0 480 480\">\n                    <circle cx=\"240\" cy=\"240\" fill=\"none\" r=\"178\" stroke=\"rgba(255,255,255,.18)\" stroke-width=\"28\">\n                    </circle>\n                    <circle cx=\"240\" cy=\"240\" fill=\"none\" id=\"dialBand\" r=\"178\" stroke=\"var(--teal)\" stroke-linecap=\"round\" stroke-width=\"28\" transform=\"rotate(-90 240 240)\">\n                    </circle>\n                    <circle cx=\"240\" cy=\"240\" fill=\"none\" r=\"128\" stroke=\"rgba(255,255,255,.2)\" stroke-width=\"1.5\">\n                    </circle>\n                    <circle cx=\"240\" cy=\"240\" fill=\"none\" r=\"73\" stroke=\"rgba(255,255,255,.2)\" stroke-width=\"1.5\">\n                    </circle>\n                    <g id=\"dialSpokes\" stroke=\"var(--teal)\" stroke-linecap=\"round\" stroke-width=\"3\">\n                    </g>\n                    <g fill=\"#fff\" id=\"dialDots\">\n                    </g>\n                    <text fill=\"#fff\" font-size=\"40\" font-weight=\"600\" id=\"dialCenter\" text-anchor=\"middle\" x=\"240\" y=\"234\">\n                        8\n                    </text>\n                    <text fill=\"var(--fog)\" font-size=\"13\" text-anchor=\"middle\" x=\"240\" y=\"261\">\n                        steady\n                    </text>\n                </svg>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"food-title\" class=\"shell chapter\" data-kid=\"2-4\" id=\"food\">\n        <div class=\"eyebrow\" data-kid=\"2-4-1\">\n            03 · Ways the record gets made\n        </div>\n        <h2 data-kid=\"2-4-2\" id=\"food-title\">\n            Dinner first,\n            <span class=\"serif\" data-kid=\"2-4-2-1\">\n                arithmetic\n            </span>\n            second.\n        </h2>\n        <p class=\"chapter-lede\" data-kid=\"2-4-3\">\n            Nobody keeps a food diary for long when every entry means typing ingredients into tiny boxes. So the diary works the other way here. You frame the plate, tap once, and about forty seconds later the meal is sitting in your log with calories and macros attached, ready for you to correct.\n        </p>\n        <div class=\"paper food-sheet\" data-kid=\"2-4-4\">\n            <figure class=\"figure\" data-kid=\"2-4-4-1\">\n                <img alt=\"Hands serving a homemade meal at a table — Nour Alhoda on Pexels\" data-kid=\"2-4-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/34590137/pexels-photo-34590137.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80\"/>\n                <figcaption class=\"figure-caption\" data-kid=\"2-4-4-1-2\">\n                    A photo becomes a logged meal in about forty seconds.\n                </figcaption>\n            </figure>\n            <div class=\"fact-copy\" data-kid=\"2-4-4-2\">\n                <h3 data-kid=\"2-4-4-2-1\">\n                    How a photo becomes a number you can trust enough to log\n                </h3>\n                <p data-kid=\"2-4-4-2-2\">\n                    Vision AI names each food on the plate and judges portions against the plate itself, then the USDA nutrition database fills in calories, protein, carbs, and fat per hundred grams. Because a photo is evidence rather than measurement, the answer arrives as a range with a confidence note, and every item carries gram steppers so a heavy pour of rice takes two taps to fix. Logging works offline and syncs when you reconnect.\n                </p>\n                <div class=\"scan-frame\" data-kid=\"2-4-4-2-3\">\n                    <div class=\"scan-inner\" data-kid=\"2-4-4-2-3-1\">\n                    </div>\n                    <small data-kid=\"2-4-4-2-3-2\">\n                        Rice and stew · 420 to 520 kcal\n                    </small>\n                </div>\n                <div class=\"facts\" data-kid=\"2-4-4-2-4\">\n                    <div data-kid=\"2-4-4-2-4-1\">\n                        <span data-kid=\"2-4-4-2-4-1-1\">\n                            Typical analysis time\n                        </span>\n                        <span data-kid=\"2-4-4-2-4-1-2\">\n                            About 40 seconds\n                        </span>\n                    </div>\n                    <div data-kid=\"2-4-4-2-4-2\">\n                        <span data-kid=\"2-4-4-2-4-2-1\">\n                            Portion adjustment\n                        </span>\n                        <span data-kid=\"2-4-4-2-4-2-2\">\n                            10 gram steps, totals rescale live\n                        </span>\n                    </div>\n                    <div data-kid=\"2-4-4-2-4-3\">\n                        <span data-kid=\"2-4-4-2-4-3-1\">\n                            Nutrition source\n                        </span>\n                        <span data-kid=\"2-4-4-2-4-3-2\">\n                            USDA FoodData Central\n                        </span>\n                    </div>\n                    <div data-kid=\"2-4-4-2-4-4\">\n                        <span data-kid=\"2-4-4-2-4-4-1\">\n                            When unsure\n                        </span>\n                        <span data-kid=\"2-4-4-2-4-4-2\">\n                            A range, never a fake exact figure\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"pulse-band\" data-kid=\"2-4-5\" id=\"pulse\">\n            <div data-kid=\"2-4-5-1\">\n                <div class=\"eyebrow\" data-kid=\"2-4-5-1-1\">\n                    05 · Pulse check\n                </div>\n                <h3 data-kid=\"2-4-5-1-2\">\n                    Two ways to take a pulse,\n                    <span class=\"serif\" data-kid=\"2-4-5-1-2-1\">\n                        zero wearables\n                    </span>\n                    required.\n                </h3>\n                <p data-kid=\"2-4-5-1-3\">\n                    The fingertip method is the classic one: cover the camera, hold still, and watch the live waveform draw itself while the quality meter decides whether the reading counts. The face method needs nothing but light. It reads the pulse remotely from skin tone changes over about thirty seconds, which makes it the option you will actually use on an ordinary Tuesday.\n                </p>\n            </div>\n            <div class=\"pulse-photo\" data-kid=\"2-4-5-2\">\n                <img alt=\"Adult using a phone for a health reading in natural light — Tima Miroshnichenko on Pexels\" data-kid=\"2-4-5-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8376172/pexels-photo-8376172.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80\"/>\n                <svg aria-hidden=\"true\" class=\"pulse-line\" data-kid=\"2-4-5-2-2\" viewbox=\"0 0 600 190\">\n                    <path class=\"pulse-path\" d=\"M0 101H130L163 101L183 41L208 147L231 78L246 101H600\" fill=\"none\" stroke=\"var(--teal)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"5\">\n                    </path>\n                </svg>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"treatment-title\" class=\"shell chapter\" data-kid=\"2-5\" id=\"treatment\">\n        <div class=\"eyebrow\" data-kid=\"2-5-1\">\n            06 · Meds and symptom map\n        </div>\n        <h2 data-kid=\"2-5-2\" id=\"treatment-title\">\n            The treatment half\n            <span class=\"serif\" data-kid=\"2-5-2-1\">\n                of the record.\n            </span>\n        </h2>\n        <div class=\"two-col\" data-kid=\"2-5-3\">\n            <div class=\"paper tall\" data-kid=\"2-5-3-1\">\n                <h3 data-kid=\"2-5-3-1-1\">\n                    Schedules that survive real life\n                </h3>\n                <p data-kid=\"2-5-3-1-2\">\n                    You define each medicine once with its dose, times, and days, and the day view reduces the rest to a single decision per row: taken or not. One tap stamps the time. Adherence becomes a spoke on the dial, which turns out to motivate more reliably than any reminder sentence, though the reminders stay.\n                </p>\n                <div class=\"mock-phone\" data-kid=\"2-5-3-1-3\" style=\"margin-top:24px\">\n                    <div class=\"mock-screen\" data-kid=\"2-5-3-1-3-1\">\n                        <div class=\"mock-row\" data-kid=\"2-5-3-1-3-1-1\">\n                            Amtiva 5g\n                            <small data-kid=\"2-5-3-1-3-1-1-1\">\n                                8:00 AM, taken\n                            </small>\n                        </div>\n                        <div class=\"mock-row\" data-kid=\"2-5-3-1-3-1-2\">\n                            Vitamin D\n                            <small data-kid=\"2-5-3-1-3-1-2-1\">\n                                due 1:00 PM\n                            </small>\n                        </div>\n                        <div class=\"mock-cta\" data-kid=\"2-5-3-1-3-1-3\">\n                            Mark taken\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"visual\" data-kid=\"2-5-3-2\">\n                <div class=\"body-mock\" data-kid=\"2-5-3-2-1\">\n                    <div aria-hidden=\"true\" class=\"body-fig\" data-kid=\"2-5-3-2-1-1\">\n                        <i data-kid=\"2-5-3-2-1-1-1\">\n                        </i>\n                        <i data-kid=\"2-5-3-2-1-1-2\">\n                        </i>\n                    </div>\n                    <div class=\"body-list\" data-kid=\"2-5-3-2-1-2\">\n                        <div data-kid=\"2-5-3-2-1-2-1\">\n                            Shoulder · 4/10\n                        </div>\n                        <div data-kid=\"2-5-3-2-1-2-2\">\n                            Lower back · 6/10\n                        </div>\n                        <div data-kid=\"2-5-3-2-1-2-3\">\n                            Knee · 2/10\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"chat-title\" class=\"shell chapter\" data-kid=\"2-6\" id=\"chat\">\n        <div class=\"eyebrow\" data-kid=\"2-6-1\">\n            04 · Ways the record gets read\n        </div>\n        <h2 data-kid=\"2-6-2\" id=\"chat-title\">\n            Ask the week\n            <span class=\"serif\" data-kid=\"2-6-2-1\">\n                what happened.\n            </span>\n        </h2>\n        <div class=\"chat-spread\" data-kid=\"2-6-3\">\n            <div aria-label=\"Health chat example\" class=\"chat-pane\" data-kid=\"2-6-3-1\">\n                <div class=\"bubble them\" data-kid=\"2-6-3-1-1\">\n                    Your sleep averaged 7h 10m this week, up from 6h 20m last week. Energy followed it upward on four of seven days.\n                </div>\n                <div class=\"bubble me\" data-kid=\"2-6-3-1-2\">\n                    Has my stress changed too?\n                </div>\n                <div class=\"bubble them\" data-kid=\"2-6-3-1-3\">\n                    Down a full point since Monday. The timeline has the daily entries if you want them.\n                </div>\n            </div>\n            <div class=\"paper evidence\" data-kid=\"2-6-3-2\">\n                <h3 data-kid=\"2-6-3-2-1\">\n                    A stop button under your thumb\n                </h3>\n                <p data-kid=\"2-6-3-2-2\">\n                    The assistant reads before it speaks. When you ask how sleep went, it has already pulled the week of sleep points, the energy curve beside it, and anything your records say that bears on the question.\n                </p>\n                <blockquote data-kid=\"2-6-3-2-3\">\n                    “Answers quoted from your own records.”\n                    <cite data-kid=\"2-6-3-2-3-1\">\n                        Health chat · source-aware by design\n                    </cite>\n                </blockquote>\n                <p data-kid=\"2-6-3-2-4\">\n                    It also knows what it should not do. Doses and diagnoses are off limits, uncertainty is stated instead of smoothed over, and every reply ends with two or three follow-up questions it genuinely expects.\n                </p>\n                <a class=\"evidence-link\" data-kid=\"2-6-3-2-5\" href=\"#evidence\">\n                    Continue to the evidence\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"2-6-3-2-5-1\">\n                    </i>\n                </a>\n            </div>\n        </div>\n        <div class=\"paper\" data-kid=\"2-6-4\" id=\"evidence\" style=\"margin-top:22px;display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center\">\n            <div data-kid=\"2-6-4-1\">\n                <div class=\"eyebrow\" data-kid=\"2-6-4-1-1\" style=\"color:var(--cta)\">\n                    07 · 3D body, graph, records\n                </div>\n                <h3 data-kid=\"2-6-4-1-2\" style=\"margin-top:12px\">\n                    Your body of evidence,\n                    <span class=\"serif\" data-kid=\"2-6-4-1-2-1\" style=\"color:var(--cta)\">\n                        walkable.\n                    </span>\n                </h3>\n                <p data-kid=\"2-6-4-1-3\">\n                    Metrics become a rotatable anatomical model and a living knowledge graph, and the chat links straight into whichever structure an answer is about. Records arrive the unglamorous way, as PDFs and photos you upload, and leave as extracted values filed into the timeline with the originals one tap away in the profile drawer. Everything connects because everything reads from the same store.\n                </p>\n            </div>\n            <div aria-hidden=\"true\" class=\"motif\" data-kid=\"2-6-4-2\">\n                <span data-kid=\"2-6-4-2-1\">\n                </span>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"promises-title\" class=\"shell chapter\" data-kid=\"2-7\" id=\"promises\">\n        <div class=\"eyebrow\" data-kid=\"2-7-1\">\n            Promises\n        </div>\n        <h2 data-kid=\"2-7-2\" id=\"promises-title\">\n            What we\n            <span class=\"serif\" data-kid=\"2-7-2-1\">\n                refuse\n            </span>\n            to do.\n        </h2>\n        <div class=\"promise-list\" data-kid=\"2-7-3\">\n            <div class=\"promise-row\" data-kid=\"2-7-3-1\">\n                <b data-kid=\"2-7-3-1-1\">\n                    No invented precision\n                </b>\n                <p data-kid=\"2-7-3-1-2\">\n                    An estimate ships with its range and its confidence, or it does not ship. Missing days show as missing days. A blank is always more honest than a plausible number.\n                </p>\n            </div>\n            <div class=\"promise-row safety\" data-kid=\"2-7-3-2\">\n                <b data-kid=\"2-7-3-2-1\">\n                    No medical cosplay\n                </b>\n                <p data-kid=\"2-7-3-2-2\">\n                    The app spots patterns and keeps records organized. It does not diagnose, does not prescribe, and says plainly when a question belongs with a clinician.\n                </p>\n            </div>\n            <div class=\"promise-row\" data-kid=\"2-7-3-3\">\n                <b data-kid=\"2-7-3-3-1\">\n                    No data market\n                </b>\n                <p data-kid=\"2-7-3-3-2\">\n                    Your logs sync to your private account for backup and are never sold. Uploaded documents are processed only to build your timeline. Sign out keeps local data on the device.\n                </p>\n            </div>\n            <div class=\"promise-row\" data-kid=\"2-7-3-4\">\n                <b data-kid=\"2-7-3-4-1\">\n                    No dead ends offline\n                </b>\n                <p data-kid=\"2-7-3-4-2\">\n                    Logging, meds, the dial, and history work without a connection and sync quietly when one returns. Anything needing the network says so instead of spinning.\n                </p>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"faq-title\" class=\"shell chapter\" data-kid=\"2-8\" id=\"faq\" style=\"padding-top:88px\">\n        <div class=\"eyebrow\" data-kid=\"2-8-1\">\n            Questions\n        </div>\n        <h2 data-kid=\"2-8-2\" id=\"faq-title\">\n            Asked often,\n            <span class=\"serif\" data-kid=\"2-8-2-1\">\n                answered plainly.\n            </span>\n        </h2>\n        <div class=\"faq-wrap\" data-kid=\"2-8-3\">\n            <div class=\"faq-item\" data-kid=\"2-8-3-1\">\n                <button aria-controls=\"faq-a1\" aria-expanded=\"false\" class=\"faq-q\" data-dynamic=\"true\" data-kid=\"2-8-3-1-1\" data-name=\"FAQ question button 1\" data-reason=\"aria-expanded attribute toggled by script\">\n                    Is HealthGraph free?\n                    <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"2-8-3-1-1-1\">\n                    </i>\n                </button>\n                <div class=\"faq-a\" data-dynamic=\"true\" data-kid=\"2-8-3-1-2\" data-name=\"FAQ answer 1\" data-reason=\"max-height updated by script on open/close\" id=\"faq-a1\">\n                    <p data-kid=\"2-8-3-1-2-1\">\n                        Yes, the whole app is free during early access, including food scanning, both pulse methods, and the chat. A Premium tier with deeper history and family sharing is planned for later, and early users will keep a founding discount when it arrives.\n                    </p>\n                </div>\n            </div>\n            <div class=\"faq-item\" data-kid=\"2-8-3-2\">\n                <button aria-controls=\"faq-a2\" aria-expanded=\"false\" class=\"faq-q\" data-dynamic=\"true\" data-kid=\"2-8-3-2-1\" data-name=\"FAQ question button 2\" data-reason=\"aria-expanded attribute toggled by script\">\n                    How does the food scanner estimate portions from a flat photo?\n                    <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"2-8-3-2-1-1\">\n                    </i>\n                </button>\n                <div class=\"faq-a\" data-dynamic=\"true\" data-kid=\"2-8-3-2-2\" data-name=\"FAQ answer 2\" data-reason=\"max-height updated by script on open/close\" id=\"faq-a2\">\n                    <p data-kid=\"2-8-3-2-2-1\">\n                        It compares the food against the plate and utensils in the frame, using a standard plate size as the reference, then converts volume to grams with a density table. That is estimation, which is why every result carries a range and a confidence note, and why the gram steppers sit right under each item before you log.\n                    </p>\n                </div>\n            </div>\n            <div class=\"faq-item\" data-kid=\"2-8-3-3\">\n                <button aria-controls=\"faq-a3\" aria-expanded=\"false\" class=\"faq-q\" data-dynamic=\"true\" data-kid=\"2-8-3-3-1\" data-name=\"FAQ question button 3\" data-reason=\"aria-expanded attribute toggled by script\">\n                    Which phones can measure pulse?\n                    <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"2-8-3-3-1-1\">\n                    </i>\n                </button>\n                <div class=\"faq-a\" data-dynamic=\"true\" data-kid=\"2-8-3-3-2\" data-name=\"FAQ answer 3\" data-reason=\"max-height updated by script on open/close\" id=\"faq-a3\">\n                    <p data-kid=\"2-8-3-3-2-1\">\n                        Any phone with a camera and flash handles fingertip readings. The face scan needs only a front camera and decent light, and takes about thirty seconds. Both show a live quality meter, and a reading that fails it is discarded with an explanation instead of being saved.\n                    </p>\n                </div>\n            </div>\n            <div class=\"faq-item\" data-kid=\"2-8-3-4\">\n                <button aria-controls=\"faq-a4\" aria-expanded=\"false\" class=\"faq-q\" data-dynamic=\"true\" data-kid=\"2-8-3-4-1\" data-name=\"FAQ question button 4\" data-reason=\"aria-expanded attribute toggled by script\">\n                    What happens to my data if I stop using the app?\n                    <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"2-8-3-4-1-1\">\n                    </i>\n                </button>\n                <div class=\"faq-a\" data-dynamic=\"true\" data-kid=\"2-8-3-4-2\" data-name=\"FAQ answer 4\" data-reason=\"max-height updated by script on open/close\" id=\"faq-a4\">\n                    <p data-kid=\"2-8-3-4-2-1\">\n                        Signing out leaves your local data on the device, and uninstalling removes it. Your synced account keeps the backup until you ask for deletion from the account screen. Nothing is retained for advertising under any circumstance, because there is no advertising.\n                    </p>\n                </div>\n            </div>\n            <div class=\"faq-item open\" data-kid=\"2-8-3-5\">\n                <button aria-controls=\"faq-a5\" aria-expanded=\"true\" class=\"faq-q\" data-dynamic=\"true\" data-kid=\"2-8-3-5-1\" data-name=\"FAQ question button 5\" data-reason=\"aria-expanded attribute toggled by script\">\n                    Can it replace my doctor?\n                    <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"2-8-3-5-1-1\">\n                    </i>\n                </button>\n                <div class=\"faq-a\" data-dynamic=\"true\" data-kid=\"2-8-3-5-2\" data-name=\"FAQ answer 5\" data-reason=\"max-height updated by script on open/close\" id=\"faq-a5\">\n                    <p data-kid=\"2-8-3-5-2-1\">\n                        No, and it will tell you so inside the app as well. HealthGraph exists to make the patterns visible and the records organized so your appointments go further. Diagnosis and treatment stay with qualified clinicians.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"get-title\" class=\"shell chapter\" data-kid=\"2-9\" id=\"get\" style=\"padding-top:78px\">\n        <div class=\"paper get-sheet\" data-kid=\"2-9-1\">\n            <h2 data-kid=\"2-9-1-1\" id=\"get-title\">\n                Get HealthGraph while it is\n                <span class=\"serif\" data-kid=\"2-9-1-1-1\">\n                    free.\n                </span>\n            </h2>\n            <p data-kid=\"2-9-1-2\">\n                One account across iOS and Android, with history everywhere you sign in. Tap below and an email opens, addressed and ready. Send it and we reply with your invite link.\n            </p>\n            <div class=\"get-actions\" data-kid=\"2-9-1-3\">\n                <a class=\"store\" data-kid=\"2-9-1-3-1\" href=\"mailto:hello@healthgraph.app?subject=HealthGraph%20early%20access\">\n                    <span data-kid=\"2-9-1-3-1-1\">\n                        <small data-kid=\"2-9-1-3-1-1-1\">\n                            Get it on\n                        </small>\n                        App Store\n                    </span>\n                </a>\n                <a class=\"store\" data-kid=\"2-9-1-3-2\" href=\"mailto:hello@healthgraph.app?subject=HealthGraph%20early%20access\">\n                    <span data-kid=\"2-9-1-3-2-1\">\n                        <small data-kid=\"2-9-1-3-2-1-1\">\n                            Get it on\n                        </small>\n                        Google Play\n                    </span>\n                </a>\n            </div>\n            <p class=\"fine\" data-kid=\"2-9-1-4\">\n                One email from you, one invite back from us. No newsletter, no drip campaign, unsubscribe by replying stop.\n            </p>\n        </div>\n    </section>\n</main>\n<footer data-kid=\"3\">\n    <div class=\"shell\" data-kid=\"3-1\">\n        <div class=\"footer-row\" data-kid=\"3-1-1\">\n            <a class=\"brand\" data-kid=\"3-1-1-1\" href=\"#top\">\n                <span aria-hidden=\"true\" class=\"mark\" data-kid=\"3-1-1-1-1\">\n                </span>\n                HealthGraph\n            </a>\n            <div class=\"colophon\" data-kid=\"3-1-1-2\">\n                Set in Poppins, with an italic serif for emphasis. One HTML file, no trackers, no cookies.\n                <br data-kid=\"3-1-1-2-1\"/>\n                © 2026 HealthGraph.\n            </div>\n        </div>\n        <p class=\"disclaimer\" data-kid=\"3-1-2\">\n            HealthGraph is a wellness companion, not a medical device. Everything on this page and in the app is informational only and never medical advice, diagnosis, or treatment. Consult a qualified clinician about any health concern.\n        </p>\n    </div>\n</footer>\n<script>\n    (function(){\n  var phaseCopy=[\n    'Sleep, energy, water, stress, movement, wellbeing, pain, meals, heart, and doses each get a spoke, and each spoke sits inside their healthy band or steps outside it where you can see it happen.',\n    'Scroll and the ring draws itself. Every spoke lands where the latest logs would put it. The count in the middle is simply how many spokes sit inside their bands right now.',\n    'This is the same dial that lives in the app, replaying any of the last thirty days from the slider under it. The chapters below walk through everything feeding it.'\n  ];\n  var svg=document.getElementById('dialSvg'), spokes=document.getElementById('dialSpokes'), dots=document.getElementById('dialDots'), center=document.getElementById('dialCenter'), band=document.getElementById('dialBand'), copy=document.getElementById('dial-copy');\n  if(svg&&spokes&&dots){\n    for(var i=0;i<10;i++){var a=-Math.PI/2+(2*Math.PI*i)/10;var r=128+[42,28,47,21,38,44,18,33,40,27][i]*.9;var x1=240+73*Math.cos(a),y1=240+73*Math.sin(a),x2=240+Math.min(r,174)*Math.cos(a),y2=240+Math.min(r,174)*Math.sin(a);var line=document.createElementNS('http://www.w3.org/2000/svg','line');line.setAttribute('x1',x1);line.setAttribute('y1',y1);line.setAttribute('x2',x2);line.setAttribute('y2',y2);line.style.strokeDasharray=Math.hypot(x2-x1,y2-y1);line.style.strokeDashoffset=line.style.strokeDasharray;spokes.appendChild(line);var dot=document.createElementNS('http://www.w3.org/2000/svg','circle');dot.setAttribute('cx',x2);dot.setAttribute('cy',y2);dot.setAttribute('r','6');dot.style.opacity='0';dots.appendChild(dot)}\n  }\n  var C=2*Math.PI*178;\n  if(band){band.style.strokeDasharray=C;band.style.strokeDashoffset=C*.28}\n  function setPhase(n){n=Number(n)||0;if(copy)copy.textContent=phaseCopy[n];if(center)center.textContent=String(8-n*2);document.querySelectorAll('.phase').forEach(function(btn){var on=Number(btn.dataset.phase)===n;btn.setAttribute('aria-pressed',String(on))});if(band)band.style.strokeDashoffset=C*[.28,.48,.66][n];if(spokes&&dots){Array.prototype.forEach.call(spokes.children,function(line,j){var q=Math.max(0,Math.min(1,(n+1)*.34-(j/10)));line.style.strokeDashoffset=line.style.strokeDasharray*(1-q);dots.children[j].style.opacity=q})}}\n  document.querySelectorAll('.phase').forEach(function(btn){btn.addEventListener('click',function(){setPhase(btn.dataset.phase)})});setPhase(0);\n  var pulse=document.querySelector('.pulse-band');if(pulse&&'IntersectionObserver' in window){var io=new IntersectionObserver(function(entries){entries.forEach(function(entry){if(entry.isIntersecting){pulse.classList.add('in-view');io.unobserve(pulse)}})},{threshold:.35});io.observe(pulse)}else if(pulse){pulse.classList.add('in-view')}\n  document.querySelectorAll('.faq-q').forEach(function(btn){btn.addEventListener('click',function(){var item=btn.parentElement;var open=item.classList.contains('open');document.querySelectorAll('.faq-item.open').forEach(function(other){other.classList.remove('open');other.querySelector('.faq-q').setAttribute('aria-expanded','false')});if(!open){item.classList.add('open');btn.setAttribute('aria-expanded','true')}})});\n})();\n</script>\n",
      "comments": [],
      "created": "2026-09-18T14:15:36.855407+00:00",
      "modified": "2026-09-18T14:17:30.610610+00:00",
      "id": "var_58679708ff11",
      "viewportScrollY": 7926
    },
    "var_630e65c05300": {
      "type": "variant",
      "label": "Everyday Almanac — HealthGraph",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Poppins:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n:root {\n  --stage: #0B4A3F;\n  --stage-deep: #07332B;\n  --paper: #FFFFFF;\n  --ink: #14201D;\n  --body: #3E4F4A;\n  --muted: #7A8B85;\n  --line: #DCE7E2;\n  --wash: #EFF5F2;\n  --cta: #0B7A55;\n  --teal: #4FD1C5;\n  --pulse: #D7263D;\n  --fog: #A7B8B2;\n  --serif: 'Instrument Serif', Georgia, serif;\n  --sans: 'Poppins', system-ui, sans-serif;\n}\n\n.hg-page {\n  min-height: 100vh;\n  overflow-x: hidden;\n  background: var(--stage);\n  color: var(--paper);\n  font-family: var(--sans);\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n.hg-page a { color: inherit; text-decoration: none; }\n.hg-page button { font: inherit; }\n.hg-page img, .hg-page video { display: block; max-width: 100%; }\n.hg-page .wrap { width: min(1160px, calc(100% - 64px)); margin: 0 auto; }\n.hg-page .serif { font-family: var(--serif); font-style: italic; font-weight: 400; }\n.hg-page .eyebrow { color: var(--teal); font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }\n.hg-page .rule { height: 1px; background: rgba(255,255,255,.22); }\n\n.hg-nav {\n  position: sticky;\n  top: 0;\n  z-index: 30;\n  border-bottom: 1px solid rgba(255,255,255,.16);\n  background: rgba(11,74,63,.94);\n  backdrop-filter: blur(16px);\n}\n.hg-nav-inner { min-height: 72px; display: flex; align-items: center; gap: 22px; }\n.hg-brand { display: inline-flex; align-items: center; gap: 10px; flex: none; font-size: 17px; font-weight: 600; letter-spacing: -.025em; }\n.hg-mark { position: relative; width: 25px; height: 25px; border: 2px solid var(--teal); border-radius: 50%; }\n.hg-mark::before { content: ''; position: absolute; inset: 5px; border: 1px solid rgba(79,209,197,.75); border-radius: 50%; }\n.hg-mark::after { content: ''; position: absolute; left: 50%; top: 50%; width: 5px; height: 5px; transform: translate(-50%,-50%); border-radius: 50%; background: var(--teal); }\n.hg-nav-links { display: flex; align-items: center; gap: 2px; margin-left: auto; }\n.hg-nav-links a { padding: 9px 9px; color: #D8E5E0; font-size: 11px; transition: color .2s ease; }\n.hg-nav-links a:hover, .hg-nav-links a:focus-visible { color: var(--teal); }\n.hg-nav-cta { display: inline-flex; align-items: center; gap: 8px; padding: 11px 16px; border: 1px solid rgba(255,255,255,.76); border-radius: 999px; background: var(--paper); color: var(--ink) !important; font-size: 12px; font-weight: 600; white-space: nowrap; }\n.hg-nav-cta:hover, .hg-nav-cta:focus-visible { background: var(--teal); border-color: var(--teal); }\n\n/* The same small graph remains present throughout the page. It is a projection of the larger story, not a second feature. */\n.hg-system {\n  position: fixed;\n  top: 101px;\n  right: 18px;\n  z-index: 12;\n  width: 148px;\n  pointer-events: none;\n  color: rgba(216,229,224,.62);\n  will-change: transform, opacity;\n}\n.hg-system-label { margin: 0 0 7px 26px; font-size: 9px; letter-spacing: .14em; text-transform: uppercase; }\n.hg-system svg { width: 100%; height: 365px; overflow: visible; }\n.hg-system-edge { fill: none; stroke: rgba(79,209,197,.48); stroke-width: 1.1; vector-effect: non-scaling-stroke; }\n.hg-system-node { opacity: 0; transform-box: fill-box; transform-origin: center; will-change: transform, opacity; }\n.hg-system-node .hg-node-core { fill: var(--teal); }\n.hg-system-node .hg-node-halo { fill: none; stroke: var(--teal); stroke-width: 1; opacity: .28; }\n.hg-system-node text { fill: rgba(216,229,224,.72); font-family: var(--sans); font-size: 8px; letter-spacing: .03em; }\n\n.hg-hero { padding: 92px 0 0; text-align: center; }\n.hg-hero-copy { width: min(790px, 100%); margin: 0 auto; }\n.hg-caption { display: inline-flex; align-items: center; gap: 9px; color: var(--fog); font-size: 12px; letter-spacing: .035em; }\n.hg-caption::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--teal); }\n.hg-hero h1 { margin: 24px 0 0; color: var(--paper); font-size: clamp(48px, 7vw, 84px); font-weight: 600; letter-spacing: -.065em; line-height: .98; }\n.hg-hero h1 span { display: block; }\n.hg-hero p { width: min(620px, 100%); margin: 24px auto 0; color: #D8E5E0; font-size: 16px; line-height: 1.75; }\n.hg-actions { display: flex; align-items: center; justify-content: center; gap: 22px; margin-top: 30px; }\n.hg-button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 45px; padding: 0 20px; border-radius: 999px; border: 1px solid transparent; cursor: pointer; font-size: 13px; font-weight: 600; transition: background .2s ease, color .2s ease, border-color .2s ease; }\n.hg-button:focus-visible, .hg-text-link:focus-visible, .hg-nav a:focus-visible, .hg-faq-q:focus-visible, .hg-phase button:focus-visible, .hg-rail button:focus-visible { outline: 3px solid rgba(79,209,197,.65); outline-offset: 3px; }\n.hg-button-primary { background: var(--paper); color: var(--ink) !important; }\n.hg-button-primary:hover { background: var(--teal); }\n.hg-text-link { display: inline-flex; align-items: center; gap: 7px; color: var(--paper); font-size: 13px; font-weight: 500; text-decoration: underline; text-decoration-color: rgba(79,209,197,.72); text-underline-offset: 5px; }\n.hg-text-link i { color: var(--teal); font-size: 15px; transition: transform .2s ease; }\n.hg-text-link:hover i { transform: translateY(3px); }\n.hg-hero-note { margin-top: 15px; color: var(--fog); font-size: 11px; }\n.hg-film { position: relative; width: 100%; height: 335px; margin-top: 70px; overflow: hidden; background: var(--stage-deep); border-top: 1px solid rgba(255,255,255,.17); border-bottom: 1px solid rgba(255,255,255,.17); }\n.hg-film img, .hg-film video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }\n.hg-film img { opacity: .44; filter: saturate(.7) contrast(1.05); }\n.hg-film video { z-index: 1; opacity: .78; mix-blend-mode: screen; }\n.hg-film-shade { position: absolute; inset: 0; z-index: 2; background: linear-gradient(90deg, rgba(7,51,43,.86), rgba(7,51,43,.08) 52%, rgba(7,51,43,.68)); pointer-events: none; }\n.hg-film-meta { position: absolute; z-index: 3; left: max(32px, calc((100% - 1160px)/2)); bottom: 28px; display: flex; align-items: center; gap: 14px; color: #D8E5E0; font-size: 11px; letter-spacing: .09em; text-transform: uppercase; }\n.hg-film-meta strong { color: var(--teal); font-weight: 600; }\n.hg-film-meta span { width: 42px; height: 1px; background: var(--teal); }\n.hg-film-caption { position: absolute; z-index: 3; right: max(32px, calc((100% - 1160px)/2)); bottom: 28px; color: rgba(255,255,255,.7); font-size: 11px; }\n\n.hg-act { padding: 108px 0; }\n.hg-act-light { background: var(--paper); color: var(--ink); }\n.hg-act-light .eyebrow { color: var(--cta); }\n.hg-act-light .rule { background: var(--line); }\n.hg-act-head { display: grid; grid-template-columns: 1fr 2fr; gap: 44px; align-items: start; }\n.hg-act-head h2 { max-width: 760px; margin: 12px 0 0; font-size: clamp(34px, 4.7vw, 58px); font-weight: 600; letter-spacing: -.06em; line-height: 1.02; }\n.hg-act-head p { max-width: 580px; margin: 17px 0 0; color: #D8E5E0; font-size: 15.5px; line-height: 1.78; }\n.hg-act-light .hg-act-head p { color: var(--body); }\n.hg-act-number { padding-top: 8px; font-size: 12px; font-variant-numeric: tabular-nums; letter-spacing: .12em; color: var(--muted); }\n.hg-act-number b { color: var(--cta); font-weight: 600; }\n\n.hg-rail { display: grid; grid-template-columns: 132px 1fr; gap: 26px; margin-top: 54px; }\n.hg-rail-list { position: relative; display: grid; gap: 17px; align-content: start; }\n.hg-rail-list::after { content: ''; position: absolute; top: 6px; bottom: 5px; right: 4px; width: 1px; background: var(--line); }\n.hg-rail button { position: relative; z-index: 1; display: grid; gap: 2px; padding: 0 18px 0 0; border: 0; background: transparent; color: var(--muted); text-align: left; cursor: pointer; font-size: 12px; }\n.hg-rail button::after { content: ''; position: absolute; top: 5px; right: 0; width: 9px; height: 9px; border: 2px solid var(--line); border-radius: 50%; background: var(--paper); }\n.hg-rail button[aria-pressed='true'] { color: var(--cta); }\n.hg-rail button[aria-pressed='true']::after { border-color: var(--teal); background: var(--teal); }\n.hg-rail button strong { font-size: 11px; font-weight: 600; font-variant-numeric: tabular-nums; }\n.hg-rail button span { line-height: 1.35; }\n.hg-side-note { display: flex; justify-content: space-between; align-items: baseline; gap: 22px; margin-bottom: 14px; color: var(--muted); font-size: 12px; }\n.hg-side-note b { color: var(--cta); font-weight: 600; }\n.hg-ledger { border-top: 1px solid var(--line); }\n.hg-ledger-row { display: grid; grid-template-columns: 125px 1fr auto; gap: 25px; align-items: baseline; padding: 22px 5px; border-bottom: 1px solid var(--line); transition: border-color .2s ease, padding-left .2s ease; }\n.hg-ledger-row:hover, .hg-ledger-row.is-selected { border-bottom-color: var(--teal); padding-left: 10px; }\n.hg-ledger-when { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }\n.hg-ledger-what { color: var(--ink); font-size: 15px; font-weight: 600; }\n.hg-ledger-what small { display: block; max-width: 590px; margin-top: 6px; color: var(--body); font-size: 13px; font-weight: 400; line-height: 1.6; }\n.hg-ledger-val { display: inline-flex; align-items: center; gap: 8px; color: var(--cta); font-size: 12px; font-weight: 600; white-space: nowrap; }\n.hg-ledger-val i { transition: transform .2s ease; }\n.hg-ledger-row:hover .hg-ledger-val i, .hg-ledger-row.is-selected .hg-ledger-val i { transform: translateX(4px); }\n\n.hg-capture-grid { display: grid; grid-template-columns: minmax(0, 1.38fr) minmax(280px, .62fr); gap: 22px; margin-top: 70px; }\n.hg-sheet { background: var(--paper); color: var(--ink); border-radius: 22px; overflow: hidden; }\n.hg-sheet-inner { padding: 34px; }\n.hg-sheet h3 { margin: 10px 0 0; font-size: clamp(24px, 3vw, 36px); font-weight: 600; letter-spacing: -.055em; line-height: 1.08; }\n.hg-sheet p { margin: 15px 0 0; color: var(--body); font-size: 14px; line-height: 1.78; }\n.hg-sheet .eyebrow { color: var(--cta); }\n.hg-photo { position: relative; min-height: 270px; overflow: hidden; }\n.hg-photo img { width: 100%; height: 100%; min-height: 270px; object-fit: cover; filter: saturate(.72) contrast(1.04); }\n.hg-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(7,51,43,.68)); pointer-events: none; }\n.hg-photo figcaption { position: absolute; z-index: 1; right: 20px; bottom: 18px; left: 20px; color: white; font-size: 11px; line-height: 1.45; }\n.hg-facts { margin-top: 24px; border-top: 1px solid var(--line); }\n.hg-fact { display: flex; justify-content: space-between; gap: 20px; padding: 11px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 12px; }\n.hg-fact strong { color: var(--ink); font-weight: 600; text-align: right; }\n.hg-scan { display: grid; grid-template-columns: .78fr 1.22fr; min-height: 280px; }\n.hg-scan-visual { position: relative; display: flex; align-items: center; justify-content: center; min-height: 280px; background: var(--stage-deep); }\n.hg-scan-visual::before { content: ''; position: absolute; width: 184px; height: 230px; border: 1px solid rgba(79,209,197,.75); border-radius: 18px; transform: rotate(-4deg); }\n.hg-scan-visual::after { content: ''; position: absolute; left: 26px; right: 26px; top: 50%; height: 1px; background: var(--teal); box-shadow: 0 0 0 5px rgba(79,209,197,.09); }\n.hg-scan-tag { position: absolute; bottom: 24px; left: 26px; color: var(--fog); font-size: 11px; }\n.hg-treatment { display: grid; gap: 22px; }\n.hg-mini-sheet { padding: 28px; background: var(--paper); color: var(--ink); border-radius: 22px; }\n.hg-mini-sheet h3 { margin-top: 9px; font-size: 24px; font-weight: 600; letter-spacing: -.05em; line-height: 1.08; }\n.hg-mini-sheet p { margin-top: 12px; color: var(--body); font-size: 13px; line-height: 1.72; }\n.hg-phone { display: grid; gap: 9px; margin-top: 20px; padding: 13px; border-radius: 21px; background: var(--wash); }\n.hg-phone-row { display: flex; justify-content: space-between; gap: 10px; padding: 10px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); color: var(--ink); font-size: 11px; font-weight: 600; }\n.hg-phone-row small { color: var(--muted); font-weight: 400; }\n.hg-phone-cta { padding: 10px; border-radius: 999px; background: var(--cta); color: var(--paper); text-align: center; font-size: 11px; font-weight: 600; }\n.hg-body-map { display: flex; align-items: center; gap: 16px; margin-top: 20px; }\n.hg-body-figure { position: relative; width: 68px; height: 130px; flex: none; border: 2px solid rgba(20,32,29,.35); border-radius: 45px 45px 31px 31px; }\n.hg-body-figure::before { content: ''; position: absolute; top: -18px; left: 19px; width: 27px; height: 27px; border: 2px solid rgba(20,32,29,.35); border-radius: 50%; background: var(--paper); }\n.hg-body-spot { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: var(--pulse); }\n.hg-body-spot.one { top: 31px; left: 18px; }\n.hg-body-spot.two { top: 67px; right: 14px; }\n.hg-body-list { display: grid; gap: 7px; font-size: 11px; }\n.hg-body-list span { padding: 7px 9px; border-radius: 7px; background: var(--wash); font-weight: 600; }\n\n.hg-patterns { position: relative; padding: 122px 0 138px; overflow: hidden; background: var(--stage); }\n.hg-patterns::before { content: ''; position: absolute; left: 50%; top: 30px; width: 620px; height: 620px; transform: translateX(30%); border: 1px solid rgba(79,209,197,.11); border-radius: 50%; box-shadow: 0 0 0 70px rgba(79,209,197,.025), 0 0 0 140px rgba(79,209,197,.018); }\n.hg-patterns-inner { position: relative; z-index: 1; display: grid; grid-template-columns: .82fr 1.18fr; gap: 58px; align-items: center; }\n.hg-pattern-copy h2 { margin-top: 13px; font-size: clamp(36px, 5vw, 62px); font-weight: 600; letter-spacing: -.065em; line-height: .98; }\n.hg-pattern-copy p { max-width: 435px; margin-top: 19px; color: #D8E5E0; font-size: 15px; line-height: 1.8; }\n.hg-phase { display: flex; gap: 0; max-width: 430px; margin-top: 29px; border-top: 1px solid rgba(255,255,255,.28); }\n.hg-phase button { position: relative; flex: 1; padding: 13px 0 0; border: 0; background: transparent; color: var(--fog); cursor: pointer; text-align: left; font-size: 11px; }\n.hg-phase button::before { content: ''; position: absolute; left: 0; top: -2px; width: 0; height: 3px; background: var(--teal); transition: width .25s ease; }\n.hg-phase button[aria-pressed='true'] { color: var(--teal); }\n.hg-phase button[aria-pressed='true']::before { width: 100%; }\n.hg-dial-wrap { min-width: 0; }\n.hg-dial { width: min(520px, 100%); margin: 0 auto; }\n.hg-dial text { font-family: var(--sans); }\n.hg-dial-center { font-size: 37px; font-weight: 600; }\n.hg-dial-caption { font-size: 12px; letter-spacing: .02em; }\n.hg-signal-key { display: grid; grid-template-columns: repeat(5, 1fr); gap: 7px 12px; max-width: 470px; margin: 17px auto 0; color: var(--fog); font-size: 10px; }\n.hg-signal-key span::before { content: ''; display: inline-block; width: 5px; height: 5px; margin: 0 5px 1px 0; border-radius: 50%; background: var(--teal); }\n\n.hg-details { padding: 108px 0 120px; background: var(--wash); color: var(--ink); }\n.hg-details .hg-act-head p { color: var(--body); }\n.hg-details-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 22px; margin-top: 56px; }\n.hg-transcript { padding: 34px; border-radius: 22px; background: var(--stage-deep); color: var(--paper); }\n.hg-transcript h3, .hg-evidence h3 { margin: 10px 0 0; font-size: 26px; font-weight: 600; letter-spacing: -.05em; }\n.hg-transcript .eyebrow { color: var(--teal); }\n.hg-bubbles { display: grid; gap: 14px; margin-top: 27px; }\n.hg-bubble { max-width: 85%; padding: 13px 15px; border-radius: 15px; font-size: 13px; line-height: 1.65; }\n.hg-bubble.them { border-bottom-left-radius: 4px; background: rgba(255,255,255,.11); color: #EDF6F2; }\n.hg-bubble.me { justify-self: end; border-bottom-right-radius: 4px; background: var(--cta); color: var(--paper); }\n.hg-evidence { padding: 34px; border-radius: 22px; background: var(--paper); }\n.hg-evidence .eyebrow { color: var(--cta); }\n.hg-quote { margin-top: 25px; padding: 17px 0 17px 18px; border-top: 3px solid var(--teal); color: var(--body); font-size: 14px; line-height: 1.75; }\n.hg-quote b { display: block; margin-bottom: 7px; color: var(--ink); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }\n.hg-graph-band { display: grid; grid-template-columns: 1.1fr .9fr; gap: 32px; align-items: center; margin-top: 22px; padding: 32px; border-radius: 22px; background: var(--paper); }\n.hg-graph-band p { max-width: 620px; margin-top: 14px; color: var(--body); font-size: 14px; line-height: 1.78; }\n.hg-graph-motif { position: relative; height: 150px; }\n.hg-graph-motif::before, .hg-graph-motif::after { content: ''; position: absolute; border: 1px solid var(--teal); border-radius: 50%; }\n.hg-graph-motif::before { width: 128px; height: 128px; top: 10px; left: 34px; box-shadow: 34px 18px 0 -17px var(--paper), 34px 18px 0 -16px var(--teal); }\n.hg-graph-motif::after { width: 74px; height: 74px; top: 37px; left: 61px; }\n.hg-graph-line { position: absolute; left: 44px; top: 75px; width: 135px; height: 1px; transform: rotate(-24deg); background: var(--teal); }\n.hg-graph-dot { position: absolute; width: 8px; height: 8px; border-radius: 50%; background: var(--teal); }\n.hg-graph-dot.a { left: 35px; top: 70px; }.hg-graph-dot.b { left: 171px; top: 47px; }.hg-graph-dot.c { left: 113px; top: 126px; background: var(--pulse); }\n\n.hg-promises { padding: 112px 0; background: var(--stage); }\n.hg-register { margin-top: 49px; border-top: 1px solid rgba(255,255,255,.23); }\n.hg-register-row { display: grid; grid-template-columns: 1fr 1.7fr; gap: 38px; padding: 24px 4px; border-bottom: 1px solid rgba(255,255,255,.23); }\n.hg-register-row h3 { display: flex; align-items: center; gap: 9px; margin: 0; font-size: 16px; font-weight: 600; }\n.hg-register-row h3::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--teal); }\n.hg-register-row.safety h3::before { background: var(--pulse); }\n.hg-register-row p { margin: 0; color: #D8E5E0; font-size: 14px; line-height: 1.75; }\n\n.hg-questions { padding: 106px 0 118px; background: var(--paper); color: var(--ink); }\n.hg-questions .hg-act-head p { color: var(--body); }\n.hg-faq { max-width: 840px; margin: 45px auto 0; border-top: 1px solid var(--line); }\n.hg-faq-item { border-bottom: 1px solid var(--line); }\n.hg-faq-q { display: flex; align-items: center; justify-content: space-between; gap: 20px; width: 100%; padding: 21px 4px; border: 0; background: transparent; color: var(--ink); cursor: pointer; text-align: left; font-size: 14px; font-weight: 600; }\n.hg-faq-q i { color: var(--cta); font-size: 17px; transition: transform .2s ease; }\n.hg-faq-item.is-open .hg-faq-q i { transform: rotate(45deg); }\n.hg-faq-a { display: none; padding: 0 45px 22px 4px; color: var(--body); font-size: 13px; line-height: 1.8; }\n.hg-faq-item.is-open .hg-faq-a { display: block; }\n\n/* The climax is a single pinned state of the same graph system. */\n.hg-climax { position: relative; min-height: 100vh; overflow: hidden; background: #E7F0EC; color: var(--ink); }\n.hg-climax-sticky { min-height: 100vh; display: flex; align-items: center; position: relative; }\n.hg-climax-inner { width: min(1160px, calc(100% - 64px)); margin: 0 auto; }\n.hg-climax-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 28px; }\n.hg-climax-head h2 { max-width: 720px; margin: 12px 0 0; font-size: clamp(34px, 5vw, 64px); font-weight: 600; letter-spacing: -.065em; line-height: .98; }\n.hg-climax-head p { max-width: 340px; margin: 0; color: var(--body); font-size: 13px; line-height: 1.7; }\n.hg-climax-phase { margin-top: 10px; color: var(--cta); font-size: 10px; font-variant-numeric: tabular-nums; letter-spacing: .12em; text-transform: uppercase; }\n.hg-climax-grid { display: grid; grid-template-columns: .74fr 1.3fr .72fr; gap: 26px; align-items: end; margin-top: 34px; }\n.hg-records { position: relative; padding-top: 4px; }\n.hg-records-label { margin-bottom: 17px; color: var(--muted); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }\n.hg-records-line { position: absolute; left: 47px; top: 41px; bottom: 12px; width: 1px; background: var(--line); transform-origin: top; transform: scaleY(0); }\n.hg-record-row { position: relative; display: grid; grid-template-columns: 48px 1fr; gap: 14px; align-items: center; min-height: 65px; opacity: 0; }\n.hg-record-row time { color: var(--cta); font-size: 11px; font-variant-numeric: tabular-nums; }\n.hg-record-copy { padding: 11px 0; border-bottom: 1px solid var(--line); color: var(--ink); font-size: 12px; font-weight: 600; }\n.hg-record-copy small { display: block; margin-top: 4px; color: var(--muted); font-size: 10px; font-weight: 400; }\n.hg-record-dot { position: absolute; left: 43px; width: 9px; height: 9px; border: 2px solid var(--teal); border-radius: 50%; background: #E7F0EC; }\n.hg-climax-canvas { position: relative; min-height: 405px; overflow: visible; }\n.hg-climax-canvas::before { content: ''; position: absolute; inset: 24px -30px 0; border-top: 1px solid rgba(11,122,85,.16); border-bottom: 1px solid rgba(11,122,85,.16); pointer-events: none; }\n.hg-climax-graph { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; transform-origin: 50% 52%; will-change: transform; }\n.hg-climax-edge, .hg-body-connector { fill: none; stroke: var(--teal); stroke-width: 1.25; vector-effect: non-scaling-stroke; }\n.hg-climax-edge { opacity: .78; }\n.hg-climax-node { opacity: 0; transform-box: fill-box; transform-origin: center; will-change: transform, opacity; }\n.hg-climax-node .node-core { fill: var(--cta); }\n.hg-climax-node .node-halo { fill: none; stroke: var(--teal); stroke-width: 1; opacity: .34; }\n.hg-climax-node text { fill: var(--body); font-family: var(--sans); font-size: 9px; }\n.hg-climax-node .node-date { fill: var(--muted); font-size: 8px; }\n.hg-depth-a, .hg-depth-b { position: absolute; pointer-events: none; }\n.hg-depth-a { inset: 0; border: 1px solid rgba(79,209,197,.14); transform: rotate(-9deg); }\n.hg-depth-b { inset: 32px 28px 12px; border: 1px solid rgba(11,122,85,.10); transform: rotate(7deg); }\n.hg-body-view { position: relative; min-height: 405px; display: flex; align-items: center; justify-content: center; perspective: 700px; }\n.hg-body-visual { position: relative; width: 210px; height: 392px; transform-style: preserve-3d; will-change: transform; }\n.hg-body-shadow { position: absolute; inset: 16px 0 0 15px; width: 210px; height: 370px; opacity: .18; }\n.hg-body-svg { position: absolute; inset: 0; width: 210px; height: 392px; overflow: visible; }\n.hg-body-outline { fill: rgba(255,255,255,.17); stroke: rgba(11,74,63,.52); stroke-width: 1.2; }\n.hg-body-highlight { fill: none; stroke: rgba(79,209,197,.48); stroke-width: 1; }\n.hg-body-ring { fill: none; stroke: rgba(79,209,197,.18); stroke-width: 1; }\n.hg-body-region { opacity: .14; transform-box: fill-box; transform-origin: center; fill: var(--teal); filter: url(#hgBodyGlow); will-change: transform, opacity; }\n.hg-body-region.alert { fill: var(--pulse); }\n.hg-body-caption { position: absolute; right: -4px; bottom: 0; width: 150px; color: var(--body); font-size: 10px; line-height: 1.5; }\n.hg-climax-bridge { max-width: 750px; margin: 30px auto 0; text-align: center; opacity: 0; }\n.hg-climax-bridge strong { display: block; color: var(--ink); font-size: clamp(20px, 2.3vw, 30px); font-weight: 500; letter-spacing: -.04em; line-height: 1.18; }\n.hg-climax-bridge span { display: block; margin-top: 8px; color: var(--muted); font-size: 11px; }\n\n.hg-pricing { padding: 108px 0 116px; background: var(--stage); color: var(--paper); }\n.hg-pricing-head { display: grid; grid-template-columns: 1fr 2fr; gap: 44px; align-items: start; }\n.hg-pricing-head h2 { max-width: 720px; margin: 12px 0 0; font-size: clamp(34px, 4.8vw, 60px); font-weight: 600; letter-spacing: -.065em; line-height: .98; }\n.hg-pricing-head p { max-width: 540px; margin-top: 18px; color: #D8E5E0; font-size: 15px; line-height: 1.75; }\n.hg-plan-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 18px; margin-top: 52px; }\n.hg-plan { min-height: 245px; padding: 30px; border: 1px solid rgba(255,255,255,.18); border-radius: 20px; background: rgba(255,255,255,.05); }\n.hg-plan.primary { background: var(--paper); color: var(--ink); }\n.hg-plan-label { color: var(--teal); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }\n.hg-plan.primary .hg-plan-label { color: var(--cta); }\n.hg-plan h3 { margin-top: 13px; font-size: 27px; font-weight: 600; letter-spacing: -.05em; }\n.hg-plan-price { margin-top: 22px; font-size: 37px; font-weight: 600; letter-spacing: -.06em; }\n.hg-plan p { max-width: 430px; margin-top: 10px; color: #D8E5E0; font-size: 13px; line-height: 1.7; }\n.hg-plan.primary p { color: var(--body); }\n.hg-plan .hg-button { margin-top: 22px; }\n.hg-plan.secondary { opacity: .8; }\n\n.hg-footer { padding: 36px 0 54px; color: var(--fog); }\n.hg-footer-top { display: flex; justify-content: space-between; gap: 24px; align-items: flex-start; }\n.hg-footer .hg-brand { color: var(--paper); }\n.hg-colophon { text-align: right; font-size: 11px; line-height: 1.6; }\n.hg-disclaimer { max-width: 720px; margin: 25px 0 0; font-size: 11px; line-height: 1.72; }\n\n@media (max-width: 900px) {\n  .hg-page .wrap, .hg-climax-inner { width: min(100% - 42px, 720px); }\n  .hg-nav-inner { min-height: 64px; gap: 14px; }\n  .hg-nav-links { display: none; }\n  .hg-nav-cta { margin-left: auto; }\n  .hg-hero { padding-top: 70px; }\n  .hg-film { height: 290px; margin-top: 52px; }\n  .hg-act-head, .hg-pricing-head { grid-template-columns: 1fr; gap: 8px; }\n  .hg-act-number { padding-top: 0; }\n  .hg-rail { grid-template-columns: 1fr; gap: 26px; }\n  .hg-rail-list { display: flex; gap: 18px; overflow-x: auto; padding: 0 0 14px; border-bottom: 1px solid var(--line); }\n  .hg-rail-list::after { display: none; }\n  .hg-rail button { min-width: 115px; padding: 0 0 12px; }\n  .hg-rail button::after { top: auto; right: auto; bottom: -18px; left: 0; }\n  .hg-capture-grid, .hg-details-grid, .hg-graph-band, .hg-plan-grid { grid-template-columns: 1fr; }\n  .hg-store-actions { justify-content: flex-start; }\n  .hg-patterns-inner { grid-template-columns: 1fr; gap: 28px; }\n  .hg-patterns::before { transform: translateX(-12%); opacity: .7; }\n  .hg-dial { max-width: 520px; }\n  .hg-register-row { grid-template-columns: 1fr; gap: 12px; }\n  .hg-footer-top { flex-direction: column; }\n  .hg-colophon { text-align: left; }\n  .hg-climax-head { display: block; }\n  .hg-climax-head p { margin-top: 15px; }\n  .hg-climax-grid { grid-template-columns: .85fr 1.4fr; }\n  .hg-body-view { grid-column: 1 / -1; min-height: 260px; }\n  .hg-body-visual { transform: scale(.78); transform-origin: center top; }\n  .hg-climax-canvas { min-height: 360px; }\n}\n@media (max-width: 560px) {\n  .hg-page .wrap, .hg-climax-inner { width: calc(100% - 32px); }\n  .hg-system { top: 86px; right: 7px; width: 92px; opacity: .5; }\n  .hg-system svg { height: 270px; }\n  .hg-system text { display: none; }\n  .hg-hero h1 { font-size: clamp(43px, 13vw, 66px); }\n  .hg-hero p { font-size: 14px; }\n  .hg-actions { align-items: flex-start; flex-direction: column; gap: 16px; }\n  .hg-film { height: auto; aspect-ratio: 16 / 9; margin-top: 42px; }\n  .hg-film-meta { left: 17px; bottom: 16px; font-size: 9px; }\n  .hg-film-caption { right: 17px; bottom: 16px; font-size: 9px; }\n  .hg-act, .hg-details, .hg-promises, .hg-questions, .hg-pricing { padding: 76px 0; }\n  .hg-ledger-row { grid-template-columns: 1fr auto; gap: 7px 14px; }\n  .hg-ledger-when { grid-column: 1 / -1; }\n  .hg-ledger-what small { font-size: 12px; }\n  .hg-scan { grid-template-columns: 1fr; }\n  .hg-scan-visual { min-height: 210px; }\n  .hg-scan-visual::before { height: 168px; }\n  .hg-sheet-inner, .hg-transcript, .hg-evidence { padding: 25px; }\n  .hg-phase button { font-size: 10px; }\n  .hg-signal-key { grid-template-columns: repeat(2, 1fr); }\n  .hg-climax { min-height: auto; padding: 76px 0 84px; }\n  .hg-climax-sticky { min-height: auto; display: block; }\n  .hg-climax-grid { display: block; margin-top: 31px; }\n  .hg-records { margin-bottom: 27px; }\n  .hg-climax-canvas { min-height: 340px; }\n  .hg-body-view { min-height: 300px; margin-top: 12px; }\n  .hg-climax-bridge { margin-top: 12px; }\n  .hg-plan { min-height: auto; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .hg-page *, .hg-page *::before, .hg-page *::after { scroll-behavior: auto !important; animation: none !important; }\n}\n</style>\n<main class=\"hg-page\" data-kid=\"1\" id=\"top\">\n    <nav aria-label=\"Primary navigation\" class=\"hg-nav\" data-kid=\"1-1\">\n        <div class=\"hg-nav-inner wrap\" data-kid=\"1-1-1\">\n            <a aria-label=\"HealthGraph home\" class=\"hg-brand\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <span aria-hidden=\"true\" class=\"hg-mark\" data-kid=\"1-1-1-1-1\">\n                </span>\n                <span data-kid=\"1-1-1-1-2\">\n                    HealthGraph\n                </span>\n            </a>\n            <div class=\"hg-nav-links\" data-kid=\"1-1-1-2\">\n                <a data-kid=\"1-1-1-2-1\" href=\"#today\">\n                    Today\n                </a>\n                <a data-kid=\"1-1-1-2-2\" href=\"#dial\">\n                    Patterns\n                </a>\n                <a data-kid=\"1-1-1-2-3\" href=\"#details\">\n                    Details\n                </a>\n                <a data-kid=\"1-1-1-2-4\" href=\"#connection\">\n                    Connection\n                </a>\n                <a data-kid=\"1-1-1-2-5\" href=\"#pricing\">\n                    Pricing\n                </a>\n            </div>\n            <a class=\"hg-nav-cta\" data-kid=\"1-1-1-3\" href=\"#pricing\">\n                Get the app\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-1-1-3-1\">\n                </i>\n            </a>\n        </div>\n    </nav>\n    <aside aria-label=\"HealthGraph connection forming\" class=\"hg-system\" data-kid=\"1-2\" data-name=\"system connection display\">\n        <p class=\"hg-system-label\" data-kid=\"1-2-1\" data-name=\"system connection label\">\n            one connected record\n        </p>\n        <svg aria-hidden=\"true\" data-kid=\"1-2-2\" data-name=\"system connection visualization\" viewbox=\"0 0 150 365\">\n            <path class=\"hg-system-edge\" d=\"M34 56 C58 88 92 92 104 123\" data-edge-step=\"0\">\n            </path>\n            <path class=\"hg-system-edge\" d=\"M104 123 C88 152 60 169 48 202\" data-edge-step=\"1\">\n            </path>\n            <path class=\"hg-system-edge\" d=\"M52 74 C73 129 112 154 118 202\" data-edge-step=\"1\">\n            </path>\n            <path class=\"hg-system-edge\" d=\"M48 202 C76 221 91 240 94 272\" data-edge-step=\"2\">\n            </path>\n            <path class=\"hg-system-edge\" d=\"M118 202 C113 236 132 258 126 297\" data-edge-step=\"2\">\n            </path>\n            <path class=\"hg-system-edge\" d=\"M94 272 C68 286 50 313 63 342\" data-edge-step=\"3\">\n            </path>\n            <path class=\"hg-system-edge\" d=\"M126 297 C111 318 91 330 63 342\" data-edge-step=\"3\">\n            </path>\n            <path class=\"hg-system-edge\" d=\"M63 342 C80 350 105 350 132 329\" data-edge-step=\"4\">\n            </path>\n            <path class=\"hg-system-edge\" d=\"M132 329 C140 292 139 239 126 202\" data-edge-step=\"5\">\n            </path>\n            <g class=\"hg-system-node\" data-node-step=\"0\" transform=\"translate(30 52)\">\n                <circle class=\"hg-node-halo\" r=\"13\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"4.5\">\n                </circle>\n                <text x=\"13\" y=\"3\">\n                    sleep\n                </text>\n            </g>\n            <g class=\"hg-system-node\" data-node-step=\"0\" transform=\"translate(51 70)\">\n                <circle class=\"hg-node-halo\" r=\"13\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"4.5\">\n                </circle>\n                <text x=\"13\" y=\"3\">\n                    meals\n                </text>\n            </g>\n            <g class=\"hg-system-node\" data-node-step=\"0\" transform=\"translate(105 123)\">\n                <circle class=\"hg-node-halo\" r=\"13\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"4.5\">\n                </circle>\n                <text x=\"13\" y=\"3\">\n                    records\n                </text>\n            </g>\n            <g class=\"hg-system-node\" data-node-step=\"1\" transform=\"translate(48 202)\">\n                <circle class=\"hg-node-halo\" r=\"13\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"4.5\">\n                </circle>\n                <text x=\"13\" y=\"3\">\n                    meds\n                </text>\n            </g>\n            <g class=\"hg-system-node\" data-node-step=\"1\" transform=\"translate(118 202)\">\n                <circle class=\"hg-node-halo\" r=\"13\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"4.5\">\n                </circle>\n                <text x=\"13\" y=\"3\">\n                    pulse\n                </text>\n            </g>\n            <g class=\"hg-system-node\" data-node-step=\"1\" transform=\"translate(94 272)\">\n                <circle class=\"hg-node-halo\" r=\"13\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"4.5\">\n                </circle>\n                <text x=\"13\" y=\"3\">\n                    symptoms\n                </text>\n            </g>\n            <g class=\"hg-system-node\" data-node-step=\"2\" transform=\"translate(126 297)\">\n                <circle class=\"hg-node-halo\" r=\"13\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"4.5\">\n                </circle>\n                <text x=\"13\" y=\"3\">\n                    dial\n                </text>\n            </g>\n            <g class=\"hg-system-node\" data-node-step=\"2\" transform=\"translate(63 342)\">\n                <circle class=\"hg-node-halo\" r=\"13\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"4.5\">\n                </circle>\n                <text x=\"13\" y=\"3\">\n                    energy\n                </text>\n            </g>\n            <g class=\"hg-system-node\" data-node-step=\"3\" transform=\"translate(132 329)\">\n                <circle class=\"hg-node-halo\" r=\"13\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"4.5\">\n                </circle>\n                <text x=\"-46\" y=\"3\">\n                    chat\n                </text>\n            </g>\n            <g class=\"hg-system-node\" data-node-step=\"3\" transform=\"translate(94 272)\">\n                <circle class=\"hg-node-halo\" r=\"19\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"3\">\n                </circle>\n            </g>\n            <g class=\"hg-system-node\" data-node-step=\"4\" transform=\"translate(132 329)\">\n                <circle class=\"hg-node-halo\" r=\"19\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"3\">\n                </circle>\n            </g>\n            <g class=\"hg-system-node\" data-node-step=\"5\" transform=\"translate(126 202)\">\n                <circle class=\"hg-node-halo\" r=\"19\">\n                </circle>\n                <circle class=\"hg-node-core\" r=\"3\">\n                </circle>\n            </g>\n        </svg>\n    </aside>\n    <header class=\"hg-hero graph-chapter\" data-graph-step=\"0\" data-kid=\"1-3\" data-name=\"hero section\">\n        <div class=\"wrap hg-hero-copy\" data-kid=\"1-3-1\">\n            <div class=\"hg-caption\" data-kid=\"1-3-1-1\">\n                Sleep · Symptoms · Meds · Meals · Pulse · Records\n            </div>\n            <h1 data-kid=\"1-3-1-2\">\n                Your whole health\n                <br data-kid=\"1-3-1-2-1\"/>\n                in\n                <span class=\"serif\" data-kid=\"1-3-1-2-2\">\n                    one dial.\n                </span>\n            </h1>\n            <p data-kid=\"1-3-1-3\">\n                HealthGraph keeps your sleep, symptoms, medicines, meals, pulse readings, and medical records in one place, then shows what they add up to across ten spokes you can scrub back through thirty days.\n            </p>\n            <div class=\"hg-actions\" data-kid=\"1-3-1-4\">\n                <a class=\"hg-button hg-button-primary\" data-kid=\"1-3-1-4-1\" href=\"#pricing\">\n                    Get HealthGraph free\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-3-1-4-1-1\">\n                    </i>\n                </a>\n                <a class=\"hg-text-link\" data-kid=\"1-3-1-4-2\" href=\"#today\">\n                    Look inside first\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-down\" data-kid=\"1-3-1-4-2-1\">\n                    </i>\n                </a>\n            </div>\n            <div class=\"hg-hero-note\" data-kid=\"1-3-1-5\">\n                Free during early access. iOS and Android. Your data stays yours.\n            </div>\n        </div>\n        <div aria-label=\"HealthGraph app opening film\" class=\"hg-film\" data-kid=\"1-3-2\">\n            <img alt=\"A real kitchen table with a plated meal, photographed by Nour Alhoda on Pexels.\" data-kid=\"1-3-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/34590137/pexels-photo-34590137.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80\"/>\n            <video aria-label=\"HealthGraph app opening animation\" autoplay=\"\" data-kid=\"1-3-2-2\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/photos/34590137/pexels-photo-34590137.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80\" preload=\"metadata\">\n                <source data-kid=\"1-3-2-2-1\" src=\"../assets/app-load.mp4\" type=\"video/mp4\"/>\n                <source data-kid=\"1-3-2-2-2\" src=\"frontend/assets/app-load.mp4\" type=\"video/mp4\"/>\n            </video>\n            <div class=\"hg-film-shade\" data-kid=\"1-3-2-3\">\n            </div>\n            <div class=\"hg-film-meta\" data-kid=\"1-3-2-4\">\n                <strong data-kid=\"1-3-2-4-1\">\n                    00\n                </strong>\n                <span data-kid=\"1-3-2-4-2\">\n                </span>\n                <span data-kid=\"1-3-2-4-3\">\n                    The app opens with the record\n                </span>\n            </div>\n            <div class=\"hg-film-caption\" data-kid=\"1-3-2-5\">\n                HealthGraph / early access\n            </div>\n        </div>\n    </header>\n    <section class=\"hg-act hg-act-light graph-chapter\" data-graph-step=\"1\" data-kid=\"1-4\" data-name=\"act section today\" id=\"today\">\n        <div class=\"wrap\" data-kid=\"1-4-1\">\n            <div class=\"hg-act-head\" data-kid=\"1-4-1-1\">\n                <div class=\"hg-act-number\" data-kid=\"1-4-1-1-1\">\n                    <b data-kid=\"1-4-1-1-1-1\">\n                        01\n                    </b>\n                    / TODAY\n                </div>\n                <div data-kid=\"1-4-1-1-2\">\n                    <div class=\"eyebrow\" data-kid=\"1-4-1-1-2-1\">\n                        Daily log and timeline\n                    </div>\n                    <h2 data-kid=\"1-4-1-1-2-2\">\n                        Sixty seconds in,\n                        <span class=\"serif\" data-kid=\"1-4-1-1-2-2-1\">\n                            a lifetime ledger\n                        </span>\n                        out.\n                    </h2>\n                    <p data-kid=\"1-4-1-1-2-3\">\n                        Everything below lives in the app, and all of it reads from the same data. Log something once and it shows up everywhere it matters: the dial, the timeline, the chat answers, the correlations.\n                    </p>\n                </div>\n            </div>\n            <div class=\"hg-rail\" data-kid=\"1-4-1-2\">\n                <div aria-label=\"Today timeline entries\" class=\"hg-rail-list\" data-kid=\"1-4-1-2-1\" role=\"tablist\">\n                    <button aria-pressed=\"true\" data-kid=\"1-4-1-2-1-1\" data-row=\"row-today\" type=\"button\">\n                        <strong data-kid=\"1-4-1-2-1-1-1\">\n                            Today\n                        </strong>\n                        <span data-kid=\"1-4-1-2-1-1-2\">\n                            Evening log\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" data-kid=\"1-4-1-2-1-2\" data-row=\"row-yesterday\" type=\"button\">\n                        <strong data-kid=\"1-4-1-2-1-2-1\">\n                            Yesterday\n                        </strong>\n                        <span data-kid=\"1-4-1-2-1-2-2\">\n                            Morning dose\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" data-kid=\"1-4-1-2-1-3\" data-row=\"row-lipid\" type=\"button\">\n                        <strong data-kid=\"1-4-1-2-1-3-1\">\n                            Sep 14\n                        </strong>\n                        <span data-kid=\"1-4-1-2-1-3-2\">\n                            Uploaded PDF\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" data-kid=\"1-4-1-2-1-4\" data-row=\"row-pulse\" type=\"button\">\n                        <strong data-kid=\"1-4-1-2-1-4-1\">\n                            Sep 12\n                        </strong>\n                        <span data-kid=\"1-4-1-2-1-4-2\">\n                            Face pulse check\n                        </span>\n                    </button>\n                </div>\n                <div class=\"hg-day-sheet\" data-kid=\"1-4-1-2-2\">\n                    <div class=\"hg-side-note\" data-kid=\"1-4-1-2-2-1\">\n                        <span data-kid=\"1-4-1-2-2-1-1\">\n                            <b data-kid=\"1-4-1-2-2-1-1-1\">\n                                Today\n                            </b>\n                            · one ordinary day, kept together\n                        </span>\n                        <span data-kid=\"1-4-1-2-2-1-2\">\n                            These entries feed the same dial.\n                        </span>\n                    </div>\n                    <div aria-live=\"polite\" class=\"hg-ledger\" data-kid=\"1-4-1-2-2-2\">\n                        <div class=\"hg-ledger-row is-selected\" data-kid=\"1-4-1-2-2-2-1\" id=\"row-today\">\n                            <span class=\"hg-ledger-when\" data-kid=\"1-4-1-2-2-2-1-1\">\n                                Today\n                            </span>\n                            <span class=\"hg-ledger-what\" data-kid=\"1-4-1-2-2-2-1-2\">\n                                Evening log\n                                <small data-kid=\"1-4-1-2-2-2-1-2-1\">\n                                    Mood 4, pain 2, water 1.8 litres, notes about the headache after lunch.\n                                </small>\n                            </span>\n                            <span class=\"hg-ledger-val\" data-kid=\"1-4-1-2-2-2-1-3\">\n                                Saved\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-4-1-2-2-2-1-3-1\">\n                                </i>\n                            </span>\n                        </div>\n                        <div class=\"hg-ledger-row\" data-kid=\"1-4-1-2-2-2-2\" id=\"row-yesterday\">\n                            <span class=\"hg-ledger-when\" data-kid=\"1-4-1-2-2-2-2-1\">\n                                Yesterday\n                            </span>\n                            <span class=\"hg-ledger-what\" data-kid=\"1-4-1-2-2-2-2-2\">\n                                Amtiva 5g, morning dose\n                                <small data-kid=\"1-4-1-2-2-2-2-2-1\">\n                                    Taken at 8:04, four minutes after the reminder.\n                                </small>\n                            </span>\n                            <span class=\"hg-ledger-val\" data-kid=\"1-4-1-2-2-2-2-3\">\n                                Taken\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-4-1-2-2-2-2-3-1\">\n                                </i>\n                            </span>\n                        </div>\n                        <div class=\"hg-ledger-row\" data-kid=\"1-4-1-2-2-2-3\" id=\"row-lipid\">\n                            <span class=\"hg-ledger-when\" data-kid=\"1-4-1-2-2-2-3-1\">\n                                Sep 14\n                            </span>\n                            <span class=\"hg-ledger-what\" data-kid=\"1-4-1-2-2-2-3-2\">\n                                Lipid panel, uploaded PDF\n                                <small data-kid=\"1-4-1-2-2-2-3-2-1\">\n                                    Extraction finished overnight. Two values flagged in place.\n                                </small>\n                            </span>\n                            <span class=\"hg-ledger-val\" data-kid=\"1-4-1-2-2-2-3-3\">\n                                Ready\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-4-1-2-2-2-3-3-1\">\n                                </i>\n                            </span>\n                        </div>\n                        <div class=\"hg-ledger-row\" data-kid=\"1-4-1-2-2-2-4\" id=\"row-pulse\">\n                            <span class=\"hg-ledger-when\" data-kid=\"1-4-1-2-2-2-4-1\">\n                                Sep 12\n                            </span>\n                            <span class=\"hg-ledger-what\" data-kid=\"1-4-1-2-2-2-4-2\">\n                                Face pulse check\n                                <small data-kid=\"1-4-1-2-2-2-4-2-1\">\n                                    72 bpm, good quality, thirty second scan.\n                                </small>\n                            </span>\n                            <span class=\"hg-ledger-val\" data-kid=\"1-4-1-2-2-2-4-3\">\n                                72\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-4-1-2-2-2-4-3-1\">\n                                </i>\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"hg-capture-grid\" data-kid=\"1-4-1-3\">\n                <article class=\"hg-sheet\" data-kid=\"1-4-1-3-1\" id=\"food\">\n                    <div class=\"hg-scan\" data-kid=\"1-4-1-3-1-1\">\n                        <figure class=\"hg-photo\" data-kid=\"1-4-1-3-1-1-1\" style=\"margin:0\">\n                            <img alt=\"Hands serving a rice and stew meal at a kitchen table — Nour Alhoda on Pexels.\" data-kid=\"1-4-1-3-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/34590137/pexels-photo-34590137.jpeg?auto=compress&cs=tinysrgb&w=1100&q=80\"/>\n                            <figcaption data-kid=\"1-4-1-3-1-1-1-2\">\n                                Dinner first, arithmetic second.\n                            </figcaption>\n                        </figure>\n                        <div class=\"hg-sheet-inner\" data-kid=\"1-4-1-3-1-1-2\">\n                            <div class=\"eyebrow\" data-kid=\"1-4-1-3-1-1-2-1\">\n                                02 · Food scan\n                            </div>\n                            <h3 data-kid=\"1-4-1-3-1-1-2-2\">\n                                A photo becomes a meal in about forty seconds.\n                            </h3>\n                            <p data-kid=\"1-4-1-3-1-1-2-3\">\n                                Nobody keeps a food diary for long when every entry means typing ingredients into tiny boxes. You frame the plate, tap once, and the meal is sitting in your log with calories and macros attached, ready for you to correct.\n                            </p>\n                            <div class=\"hg-facts\" data-kid=\"1-4-1-3-1-1-2-4\">\n                                <div class=\"hg-fact\" data-kid=\"1-4-1-3-1-1-2-4-1\">\n                                    <span data-kid=\"1-4-1-3-1-1-2-4-1-1\">\n                                        Typical analysis time\n                                    </span>\n                                    <strong data-kid=\"1-4-1-3-1-1-2-4-1-2\">\n                                        About 40 seconds\n                                    </strong>\n                                </div>\n                                <div class=\"hg-fact\" data-kid=\"1-4-1-3-1-1-2-4-2\">\n                                    <span data-kid=\"1-4-1-3-1-1-2-4-2-1\">\n                                        Portion adjustment\n                                    </span>\n                                    <strong data-kid=\"1-4-1-3-1-1-2-4-2-2\">\n                                        10 gram steps\n                                    </strong>\n                                </div>\n                                <div class=\"hg-fact\" data-kid=\"1-4-1-3-1-1-2-4-3\">\n                                    <span data-kid=\"1-4-1-3-1-1-2-4-3-1\">\n                                        Nutrition source\n                                    </span>\n                                    <strong data-kid=\"1-4-1-3-1-1-2-4-3-2\">\n                                        USDA FoodData Central\n                                    </strong>\n                                </div>\n                                <div class=\"hg-fact\" data-kid=\"1-4-1-3-1-1-2-4-4\">\n                                    <span data-kid=\"1-4-1-3-1-1-2-4-4-1\">\n                                        When unsure\n                                    </span>\n                                    <strong data-kid=\"1-4-1-3-1-1-2-4-4-2\">\n                                        A range, never a fake exact figure\n                                    </strong>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n                <div class=\"hg-treatment\" data-kid=\"1-4-1-3-2\" id=\"treatment\">\n                    <article class=\"hg-mini-sheet\" data-kid=\"1-4-1-3-2-1\" id=\"meds\">\n                        <div class=\"eyebrow\" data-kid=\"1-4-1-3-2-1-1\">\n                            06 · Meds and symptom map\n                        </div>\n                        <h3 data-kid=\"1-4-1-3-2-1-2\">\n                            The treatment half of the record.\n                        </h3>\n                        <p data-kid=\"1-4-1-3-2-1-3\">\n                            You define each medicine once with its dose, times, and days. The day view reduces the rest to a single decision per row: taken or not.\n                        </p>\n                        <div aria-label=\"Medication schedule preview\" class=\"hg-phone\" data-kid=\"1-4-1-3-2-1-4\">\n                            <div class=\"hg-phone-row\" data-kid=\"1-4-1-3-2-1-4-1\">\n                                Amtiva 5g\n                                <small data-kid=\"1-4-1-3-2-1-4-1-1\">\n                                    8:00 AM, taken\n                                </small>\n                            </div>\n                            <div class=\"hg-phone-row\" data-kid=\"1-4-1-3-2-1-4-2\">\n                                Vitamin D\n                                <small data-kid=\"1-4-1-3-2-1-4-2-1\">\n                                    due 1:00 PM\n                                </small>\n                            </div>\n                            <div class=\"hg-phone-cta\" data-kid=\"1-4-1-3-2-1-4-3\">\n                                Mark taken\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"hg-mini-sheet\" data-kid=\"1-4-1-3-2-2\" id=\"symptoms\">\n                        <div class=\"eyebrow\" data-kid=\"1-4-1-3-2-2-1\">\n                            Tap what hurts\n                        </div>\n                        <h3 data-kid=\"1-4-1-3-2-2-2\">\n                            A body you can point at.\n                        </h3>\n                        <p data-kid=\"1-4-1-3-2-2-3\">\n                            Thirty seven regions across front and back views, each tappable, each with a severity slider for the days a spot flares.\n                        </p>\n                        <div aria-label=\"Symptom map preview\" class=\"hg-body-map\" data-kid=\"1-4-1-3-2-2-4\">\n                            <div class=\"hg-body-figure\" data-kid=\"1-4-1-3-2-2-4-1\">\n                                <i class=\"hg-body-spot one\" data-kid=\"1-4-1-3-2-2-4-1-1\">\n                                </i>\n                                <i class=\"hg-body-spot two\" data-kid=\"1-4-1-3-2-2-4-1-2\">\n                                </i>\n                            </div>\n                            <div class=\"hg-body-list\" data-kid=\"1-4-1-3-2-2-4-2\">\n                                <span data-kid=\"1-4-1-3-2-2-4-2-1\">\n                                    Shoulder · 4/10\n                                </span>\n                                <span data-kid=\"1-4-1-3-2-2-4-2-2\">\n                                    Lower back · 6/10\n                                </span>\n                                <span data-kid=\"1-4-1-3-2-2-4-2-3\">\n                                    Knee · 2/10\n                                </span>\n                            </div>\n                        </div>\n                    </article>\n                </div>\n            </div>\n            <article class=\"hg-sheet\" data-kid=\"1-4-1-4\" id=\"pulse\" style=\"margin-top:22px\">\n                <div class=\"hg-scan\" data-kid=\"1-4-1-4-1\" style=\"grid-template-columns:1.25fr .75fr\">\n                    <div class=\"hg-sheet-inner\" data-kid=\"1-4-1-4-1-1\">\n                        <div class=\"eyebrow\" data-kid=\"1-4-1-4-1-1-1\">\n                            05 · Pulse check\n                        </div>\n                        <h3 data-kid=\"1-4-1-4-1-1-2\">\n                            Two ways to take a pulse,\n                            <span class=\"serif\" data-kid=\"1-4-1-4-1-1-2-1\">\n                                zero wearables\n                            </span>\n                            required.\n                        </h3>\n                        <p data-kid=\"1-4-1-4-1-1-3\">\n                            The fingertip method is the classic one: cover the camera, hold still, and watch the live waveform draw itself while the quality meter decides whether the reading counts. The face method needs nothing but light. Both end in the same place: results carry a quality score and heart rate variability where the signal supports it.\n                        </p>\n                        <a class=\"hg-text-link\" data-kid=\"1-4-1-4-1-1-4\" href=\"#dial\" style=\"color:var(--ink);margin-top:19px\">\n                            See how it reaches the dial\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-4-1-4-1-1-4-1\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"hg-scan-visual\" data-kid=\"1-4-1-4-1-2\" style=\"min-height:260px\">\n                        <svg aria-label=\"Live pulse waveform\" data-kid=\"1-4-1-4-1-2-1\" role=\"img\" viewbox=\"0 0 300 90\" width=\"86%\">\n                            <path d=\"M0 45 H70 L85 45 L95 15 L108 72 L118 30 L126 45 H300\" fill=\"none\" id=\"pulsePath\" stroke=\"#4FD1C5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"4\">\n                            </path>\n                        </svg>\n                        <div class=\"hg-scan-tag\" data-kid=\"1-4-1-4-1-2-2\">\n                            Live trace · quality decides\n                        </div>\n                    </div>\n                </div>\n            </article>\n        </div>\n    </section>\n    <section class=\"hg-patterns graph-chapter\" data-graph-step=\"2\" data-kid=\"1-5\" data-name=\"patterns section\" id=\"dial\">\n        <div class=\"wrap hg-patterns-inner\" data-kid=\"1-5-1\">\n            <div class=\"hg-pattern-copy\" data-kid=\"1-5-1-1\">\n                <div class=\"eyebrow\" data-kid=\"1-5-1-1-1\">\n                    03 · PATTERNS\n                </div>\n                <h2 data-kid=\"1-5-1-1-2\">\n                    One ring. Ten signals.\n                    <span class=\"serif\" data-kid=\"1-5-1-1-2-1\">\n                        Your call\n                    </span>\n                    what it shows next.\n                </h2>\n                <p data-kid=\"1-5-1-1-3\" id=\"dialCopy\">\n                    Sleep, energy, water, stress, movement, wellbeing, pain, meals, heart, and doses each get a spoke, and each spoke sits inside its healthy band or steps outside it where you can see it happen.\n                </p>\n                <div aria-label=\"Dial explanation phases\" class=\"hg-phase\" data-kid=\"1-5-1-1-4\" role=\"tablist\">\n                    <button aria-pressed=\"true\" data-kid=\"1-5-1-1-4-1\" data-phase=\"0\" type=\"button\">\n                        signals\n                    </button>\n                    <button aria-pressed=\"false\" data-kid=\"1-5-1-1-4-2\" data-phase=\"1\" type=\"button\">\n                        current count\n                    </button>\n                    <button aria-pressed=\"false\" data-kid=\"1-5-1-1-4-3\" data-phase=\"2\" type=\"button\">\n                        thirty-day replay\n                    </button>\n                </div>\n            </div>\n            <div class=\"hg-dial-wrap\" data-kid=\"1-5-1-2\">\n                <svg aria-label=\"Interactive HealthGraph ten-signal dial\" class=\"hg-dial\" data-kid=\"1-5-1-2-1\" role=\"img\" viewbox=\"0 0 430 430\">\n                    <circle cx=\"215\" cy=\"215\" fill=\"none\" r=\"162\" stroke=\"rgba(255,255,255,.16)\" stroke-width=\"27\">\n                    </circle>\n                    <circle cx=\"215\" cy=\"215\" fill=\"none\" id=\"dialBand\" r=\"162\" stroke=\"#4FD1C5\" stroke-dasharray=\"1017.88\" stroke-dashoffset=\"255\" stroke-linecap=\"round\" stroke-width=\"27\" transform=\"rotate(-90 215 215)\">\n                    </circle>\n                    <circle cx=\"215\" cy=\"215\" fill=\"none\" r=\"113\" stroke=\"rgba(255,255,255,.17)\" stroke-width=\"1.5\">\n                    </circle>\n                    <circle cx=\"215\" cy=\"215\" fill=\"none\" r=\"67\" stroke=\"rgba(255,255,255,.17)\" stroke-width=\"1.5\">\n                    </circle>\n                    <g stroke=\"#4FD1C5\" stroke-linecap=\"round\" stroke-width=\"3\">\n                        <line x1=\"215\" x2=\"215\" y1=\"102\" y2=\"61\">\n                        </line>\n                        <line x1=\"281\" x2=\"307\" y1=\"123\" y2=\"91\">\n                        </line>\n                        <line x1=\"321\" x2=\"362\" y1=\"178\" y2=\"164\">\n                        </line>\n                        <line x1=\"321\" x2=\"359\" y1=\"252\" y2=\"268\">\n                        </line>\n                        <line x1=\"281\" x2=\"306\" y1=\"307\" y2=\"340\">\n                        </line>\n                        <line x1=\"215\" x2=\"215\" y1=\"328\" y2=\"370\">\n                        </line>\n                        <line x1=\"149\" x2=\"121\" y1=\"307\" y2=\"338\">\n                        </line>\n                        <line x1=\"109\" x2=\"68\" y1=\"252\" y2=\"267\">\n                        </line>\n                        <line x1=\"109\" x2=\"68\" y1=\"178\" y2=\"164\">\n                        </line>\n                        <line x1=\"149\" x2=\"121\" y1=\"123\" y2=\"91\">\n                        </line>\n                    </g>\n                    <g fill=\"#FFFFFF\">\n                        <circle cx=\"215\" cy=\"61\" r=\"6\">\n                        </circle>\n                        <circle cx=\"307\" cy=\"91\" r=\"6\">\n                        </circle>\n                        <circle cx=\"362\" cy=\"164\" r=\"6\">\n                        </circle>\n                        <circle cx=\"359\" cy=\"268\" r=\"6\">\n                        </circle>\n                        <circle cx=\"306\" cy=\"340\" r=\"6\">\n                        </circle>\n                        <circle cx=\"215\" cy=\"370\" r=\"6\">\n                        </circle>\n                        <circle cx=\"121\" cy=\"338\" r=\"6\">\n                        </circle>\n                        <circle cx=\"68\" cy=\"267\" r=\"6\">\n                        </circle>\n                        <circle cx=\"68\" cy=\"164\" r=\"6\">\n                        </circle>\n                        <circle cx=\"121\" cy=\"91\" r=\"6\">\n                        </circle>\n                    </g>\n                    <text class=\"hg-dial-center\" fill=\"#FFFFFF\" id=\"dialCenter\" text-anchor=\"middle\" x=\"215\" y=\"210\">\n                        8\n                    </text>\n                    <text class=\"hg-dial-caption\" fill=\"#A7B8B2\" text-anchor=\"middle\" x=\"215\" y=\"235\">\n                        steady\n                    </text>\n                </svg>\n                <div aria-label=\"Dial signals\" class=\"hg-signal-key\" data-kid=\"1-5-1-2-2\">\n                    <span data-kid=\"1-5-1-2-2-1\">\n                        sleep\n                    </span>\n                    <span data-kid=\"1-5-1-2-2-2\">\n                        energy\n                    </span>\n                    <span data-kid=\"1-5-1-2-2-3\">\n                        water\n                    </span>\n                    <span data-kid=\"1-5-1-2-2-4\">\n                        stress\n                    </span>\n                    <span data-kid=\"1-5-1-2-2-5\">\n                        movement\n                    </span>\n                    <span data-kid=\"1-5-1-2-2-6\">\n                        wellbeing\n                    </span>\n                    <span data-kid=\"1-5-1-2-2-7\">\n                        pain\n                    </span>\n                    <span data-kid=\"1-5-1-2-2-8\">\n                        meals\n                    </span>\n                    <span data-kid=\"1-5-1-2-2-9\">\n                        heart\n                    </span>\n                    <span data-kid=\"1-5-1-2-2-10\">\n                        doses\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"hg-details graph-chapter\" data-graph-step=\"3\" data-kid=\"1-6\" data-name=\"details section\" id=\"details\">\n        <div class=\"wrap\" data-kid=\"1-6-1\">\n            <div class=\"hg-act-head\" data-kid=\"1-6-1-1\">\n                <div class=\"hg-act-number\" data-kid=\"1-6-1-1-1\">\n                    <b data-kid=\"1-6-1-1-1-1\">\n                        04\n                    </b>\n                    / DETAILS\n                </div>\n                <div data-kid=\"1-6-1-1-2\">\n                    <div class=\"eyebrow\" data-kid=\"1-6-1-1-2-1\">\n                        Health chat · 3D body · graph · records\n                    </div>\n                    <h2 data-kid=\"1-6-1-1-2-2\">\n                        Ask the week\n                        <span class=\"serif\" data-kid=\"1-6-1-1-2-2-1\">\n                            what happened.\n                        </span>\n                    </h2>\n                    <p data-kid=\"1-6-1-1-2-3\">\n                        The assistant reads before it speaks. The record stays visible beside the answer, and the app knows what it should not do.\n                    </p>\n                </div>\n            </div>\n            <div class=\"hg-details-grid\" data-kid=\"1-6-1-2\">\n                <article class=\"hg-transcript\" data-kid=\"1-6-1-2-1\" id=\"chat\">\n                    <div class=\"eyebrow\" data-kid=\"1-6-1-2-1-1\">\n                        03 · Health chat\n                    </div>\n                    <h3 data-kid=\"1-6-1-2-1-2\">\n                        Built for the question after the question.\n                    </h3>\n                    <div class=\"hg-bubbles\" data-kid=\"1-6-1-2-1-3\">\n                        <div class=\"hg-bubble them\" data-kid=\"1-6-1-2-1-3-1\">\n                            Your sleep averaged 7h 10m this week, up from 6h 20m last week. Energy followed it upward on four of seven days.\n                        </div>\n                        <div class=\"hg-bubble me\" data-kid=\"1-6-1-2-1-3-2\">\n                            Has my stress changed too?\n                        </div>\n                        <div class=\"hg-bubble them\" data-kid=\"1-6-1-2-1-3-3\">\n                            Down a full point since Monday. The timeline has the daily entries if you want them.\n                        </div>\n                    </div>\n                </article>\n                <article class=\"hg-evidence\" data-kid=\"1-6-1-2-2\">\n                    <div class=\"eyebrow\" data-kid=\"1-6-1-2-2-1\">\n                        Read with receipts\n                    </div>\n                    <h3 data-kid=\"1-6-1-2-2-2\">\n                        The assistant reads before it speaks.\n                    </h3>\n                    <div class=\"hg-quote\" data-kid=\"1-6-1-2-2-3\">\n                        <b data-kid=\"1-6-1-2-2-3-1\">\n                            From your own records\n                        </b>\n                        “Sleep averaged 7h 10m this week.”\n                        <br data-kid=\"1-6-1-2-2-3-2\"/>\n                        “Energy followed it upward on four of seven days.”\n                    </div>\n                    <p data-kid=\"1-6-1-2-2-4\" style=\"margin:0;color:var(--body);font-size:13px;line-height:1.76\">\n                        Answers arrive with the sources attached. Doses and diagnoses are off limits, uncertainty is stated instead of smoothed over, and a stop control stays on screen while a reply generates.\n                    </p>\n                </article>\n            </div>\n            <article class=\"hg-graph-band\" data-kid=\"1-6-1-3\" id=\"evidence\">\n                <div data-kid=\"1-6-1-3-1\">\n                    <div class=\"eyebrow\" data-kid=\"1-6-1-3-1-1\">\n                        07 · 3D body, graph, records\n                    </div>\n                    <h3 data-kid=\"1-6-1-3-1-2\" style=\"margin:10px 0 0;font-size:29px;letter-spacing:-.05em\">\n                        Your body of evidence,\n                        <span class=\"serif\" data-kid=\"1-6-1-3-1-2-1\" style=\"color:var(--cta)\">\n                            walkable.\n                        </span>\n                    </h3>\n                    <p data-kid=\"1-6-1-3-1-3\">\n                        Metrics become a rotatable anatomical model and a living knowledge graph, and the chat links straight into whichever structure an answer is about. Records arrive as PDFs and photos you upload, then leave as extracted values filed into the timeline with the originals one tap away.\n                    </p>\n                </div>\n                <div aria-hidden=\"true\" class=\"hg-graph-motif\" data-kid=\"1-6-1-3-2\">\n                    <span class=\"hg-graph-line\" data-kid=\"1-6-1-3-2-1\">\n                    </span>\n                    <span class=\"hg-graph-dot a\" data-kid=\"1-6-1-3-2-2\">\n                    </span>\n                    <span class=\"hg-graph-dot b\" data-kid=\"1-6-1-3-2-3\">\n                    </span>\n                    <span class=\"hg-graph-dot c\" data-kid=\"1-6-1-3-2-4\">\n                    </span>\n                </div>\n            </article>\n        </div>\n    </section>\n    <section class=\"hg-promises graph-chapter\" data-graph-step=\"4\" data-kid=\"1-7\" data-name=\"promises section\" id=\"promises\">\n        <div class=\"wrap\" data-kid=\"1-7-1\">\n            <div class=\"hg-act-head\" data-kid=\"1-7-1-1\">\n                <div class=\"hg-act-number\" data-kid=\"1-7-1-1-1\">\n                    <b data-kid=\"1-7-1-1-1-1\">\n                        05\n                    </b>\n                    / PROMISES\n                </div>\n                <div data-kid=\"1-7-1-1-2\">\n                    <div class=\"eyebrow\" data-kid=\"1-7-1-1-2-1\">\n                        What we refuse to do.\n                    </div>\n                    <h2 data-kid=\"1-7-1-1-2-2\">\n                        Make the limits\n                        <span class=\"serif\" data-kid=\"1-7-1-1-2-2-1\">\n                            visible.\n                        </span>\n                    </h2>\n                    <p data-kid=\"1-7-1-1-2-3\">\n                        HealthGraph exists to make patterns visible and records organized. It does not diagnose, prescribe, or turn missing days into a plausible number.\n                    </p>\n                </div>\n            </div>\n            <div class=\"hg-register\" data-kid=\"1-7-1-2\">\n                <div class=\"hg-register-row\" data-kid=\"1-7-1-2-1\">\n                    <h3 data-kid=\"1-7-1-2-1-1\">\n                        No invented precision\n                    </h3>\n                    <p data-kid=\"1-7-1-2-1-2\">\n                        An estimate ships with its range and its confidence, or it does not ship. Missing days show as missing days. A blank is always more honest than a plausible number.\n                    </p>\n                </div>\n                <div class=\"hg-register-row safety\" data-kid=\"1-7-1-2-2\">\n                    <h3 data-kid=\"1-7-1-2-2-1\">\n                        No medical cosplay\n                    </h3>\n                    <p data-kid=\"1-7-1-2-2-2\">\n                        The app spots patterns and keeps records organized. It does not diagnose, does not prescribe, and says plainly when a question belongs with a clinician.\n                    </p>\n                </div>\n                <div class=\"hg-register-row\" data-kid=\"1-7-1-2-3\">\n                    <h3 data-kid=\"1-7-1-2-3-1\">\n                        No data market\n                    </h3>\n                    <p data-kid=\"1-7-1-2-3-2\">\n                        Your logs sync to your private account for backup and are never sold. Uploaded documents are processed only to build your timeline. Sign out keeps local data on the device.\n                    </p>\n                </div>\n                <div class=\"hg-register-row\" data-kid=\"1-7-1-2-4\">\n                    <h3 data-kid=\"1-7-1-2-4-1\">\n                        No dead ends offline\n                    </h3>\n                    <p data-kid=\"1-7-1-2-4-2\">\n                        Logging, meds, the dial, and history work without a connection and sync quietly when one returns. Anything needing the network says so instead of spinning.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"hg-questions graph-chapter\" data-graph-step=\"5\" data-kid=\"1-8\" data-name=\"questions section\" id=\"faq\">\n        <div class=\"wrap\" data-kid=\"1-8-1\">\n            <div class=\"hg-act-head\" data-kid=\"1-8-1-1\">\n                <div class=\"hg-act-number\" data-kid=\"1-8-1-1-1\">\n                    <b data-kid=\"1-8-1-1-1-1\">\n                        06\n                    </b>\n                    / QUESTIONS\n                </div>\n                <div data-kid=\"1-8-1-1-2\">\n                    <div class=\"eyebrow\" data-kid=\"1-8-1-1-2-1\">\n                        Asked often, answered plainly.\n                    </div>\n                    <h2 data-kid=\"1-8-1-1-2-2\">\n                        Questions without\n                        <span class=\"serif\" data-kid=\"1-8-1-1-2-2-1\">\n                            fog.\n                        </span>\n                    </h2>\n                    <p data-kid=\"1-8-1-1-2-3\">\n                        Most health questions are practical. Here are the answers, with the same plain boundaries as the product.\n                    </p>\n                </div>\n            </div>\n            <div class=\"hg-faq\" data-kid=\"1-8-1-2\">\n                <div class=\"hg-faq-item\" data-kid=\"1-8-1-2-1\">\n                    <button aria-expanded=\"false\" class=\"hg-faq-q\" data-kid=\"1-8-1-2-1-1\" type=\"button\">\n                        Is HealthGraph free?\n                        <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-8-1-2-1-1-1\">\n                        </i>\n                    </button>\n                    <div class=\"hg-faq-a\" data-kid=\"1-8-1-2-1-2\">\n                        Yes, the whole app is free during early access, including food scanning, both pulse methods, and the chat. A Premium tier with deeper history and family sharing is planned for later, and early users will keep a founding discount when it arrives.\n                    </div>\n                </div>\n                <div class=\"hg-faq-item\" data-kid=\"1-8-1-2-2\">\n                    <button aria-expanded=\"false\" class=\"hg-faq-q\" data-kid=\"1-8-1-2-2-1\" type=\"button\">\n                        How does the food scanner estimate portions from a flat photo?\n                        <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-8-1-2-2-1-1\">\n                        </i>\n                    </button>\n                    <div class=\"hg-faq-a\" data-kid=\"1-8-1-2-2-2\">\n                        It compares the food against the plate and utensils in the frame, using a standard plate size as the reference, then converts volume to grams with a density table. That is estimation, which is why every result carries a range and a confidence note.\n                    </div>\n                </div>\n                <div class=\"hg-faq-item\" data-kid=\"1-8-1-2-3\">\n                    <button aria-expanded=\"false\" class=\"hg-faq-q\" data-kid=\"1-8-1-2-3-1\" type=\"button\">\n                        Which phones can measure pulse?\n                        <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-8-1-2-3-1-1\">\n                        </i>\n                    </button>\n                    <div class=\"hg-faq-a\" data-kid=\"1-8-1-2-3-2\">\n                        Any phone with a camera and flash handles fingertip readings. The face scan needs only a front camera and decent light, and takes about thirty seconds. Both show a live quality meter, and a reading that fails it is discarded with an explanation instead of being saved.\n                    </div>\n                </div>\n                <div class=\"hg-faq-item\" data-kid=\"1-8-1-2-4\">\n                    <button aria-expanded=\"false\" class=\"hg-faq-q\" data-kid=\"1-8-1-2-4-1\" type=\"button\">\n                        What happens to my data if I stop using the app?\n                        <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-8-1-2-4-1-1\">\n                        </i>\n                    </button>\n                    <div class=\"hg-faq-a\" data-kid=\"1-8-1-2-4-2\">\n                        Signing out leaves your local data on the device, and uninstalling removes it. Your synced account keeps the backup until you ask for deletion from the account screen. Nothing is retained for advertising under any circumstance, because there is no advertising.\n                    </div>\n                </div>\n                <div class=\"hg-faq-item is-open\" data-kid=\"1-8-1-2-5\">\n                    <button aria-expanded=\"true\" class=\"hg-faq-q\" data-kid=\"1-8-1-2-5-1\" type=\"button\">\n                        Can it replace my doctor?\n                        <i aria-hidden=\"true\" class=\"ti ti-plus\" data-kid=\"1-8-1-2-5-1-1\">\n                        </i>\n                    </button>\n                    <div class=\"hg-faq-a\" data-kid=\"1-8-1-2-5-2\">\n                        No, and it will tell you so inside the app as well. HealthGraph exists to make the patterns visible and the records organized so your appointments go further. Diagnosis and treatment stay with qualified clinicians.\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section aria-label=\"Years of records becoming one connected picture\" class=\"hg-climax\" data-graph-step=\"6\" data-kid=\"1-9\" data-name=\"connection climax section\" id=\"connection\">\n        <div class=\"hg-climax-sticky\" data-kid=\"1-9-1\" data-name=\"climax sticky container\">\n            <div class=\"hg-climax-inner\" data-kid=\"1-9-1-1\" data-name=\"climax inner content\">\n                <div class=\"hg-climax-head\" data-kid=\"1-9-1-1-1\" data-name=\"climax header\">\n                    <div data-kid=\"1-9-1-1-1-1\">\n                        <div class=\"eyebrow\" data-kid=\"1-9-1-1-1-1-1\" data-name=\"climax eyebrow label\" style=\"color:var(--cta)\">\n                            07 · THE CONNECTION\n                        </div>\n                        <h2 data-kid=\"1-9-1-1-1-1-2\" data-name=\"climax headline\">\n                            Years of medical records\n                            <span class=\"serif\" data-kid=\"1-9-1-1-1-1-2-1\">\n                                become one picture.\n                            </span>\n                        </h2>\n                        <div class=\"hg-climax-phase\" data-dynamic=\"true\" data-kid=\"1-9-1-1-1-1-3\" data-name=\"climax phase label\" data-reason=\"text content updated on scroll\" id=\"climaxPhase\">\n                            records / connections / body\n                        </div>\n                    </div>\n                    <p data-kid=\"1-9-1-1-1-2\" data-name=\"climax description\">\n                        Not another graph to inspect. A living thread that carries the things you already keep toward the places they matter.\n                    </p>\n                </div>\n                <div class=\"hg-climax-grid\" data-kid=\"1-9-1-1-2\" data-name=\"climax main content grid\">\n                    <div class=\"hg-records\" data-kid=\"1-9-1-1-2-1\" data-name=\"records history list container\">\n                        <div class=\"hg-records-label\" data-kid=\"1-9-1-1-2-1-1\" data-name=\"records label\">\n                            Years of medical records\n                        </div>\n                        <div class=\"hg-records-line\" data-kid=\"1-9-1-1-2-1-2\" data-name=\"records timeline line\">\n                        </div>\n                        <div class=\"hg-record-row\" data-kid=\"1-9-1-1-2-1-3\" data-name=\"record entry row 2018\">\n                            <time data-kid=\"1-9-1-1-2-1-3-1\" data-name=\"record date\">\n                                2018\n                            </time>\n                            <div class=\"hg-record-copy\" data-kid=\"1-9-1-1-2-1-3-2\" data-name=\"record content\">\n                                Record imported\n                                <small data-kid=\"1-9-1-1-2-1-3-2-1\" data-name=\"record description\">\n                                    document saved to your history\n                                </small>\n                            </div>\n                            <i class=\"hg-record-dot\" data-kid=\"1-9-1-1-2-1-3-3\" data-name=\"record dot icon\">\n                            </i>\n                        </div>\n                        <div class=\"hg-record-row\" data-kid=\"1-9-1-1-2-1-4\" data-name=\"record entry row 2021\">\n                            <time data-kid=\"1-9-1-1-2-1-4-1\" data-name=\"record date\">\n                                2021\n                            </time>\n                            <div class=\"hg-record-copy\" data-kid=\"1-9-1-1-2-1-4-2\" data-name=\"record content\">\n                                Lipid panel\n                                <small data-kid=\"1-9-1-1-2-1-4-2-1\" data-name=\"record description\">\n                                    uploaded PDF, extracted values\n                                </small>\n                            </div>\n                            <i class=\"hg-record-dot\" data-kid=\"1-9-1-1-2-1-4-3\" data-name=\"record dot icon\">\n                            </i>\n                        </div>\n                        <div class=\"hg-record-row\" data-kid=\"1-9-1-1-2-1-5\" data-name=\"record entry row 2024\">\n                            <time data-kid=\"1-9-1-1-2-1-5-1\" data-name=\"record date\">\n                                2024\n                            </time>\n                            <div class=\"hg-record-copy\" data-kid=\"1-9-1-1-2-1-5-2\" data-name=\"record content\">\n                                Face pulse check\n                                <small data-kid=\"1-9-1-1-2-1-5-2-1\" data-name=\"record description\">\n                                    72 bpm, quality visible\n                                </small>\n                            </div>\n                            <i class=\"hg-record-dot\" data-kid=\"1-9-1-1-2-1-5-3\" data-name=\"record dot icon\">\n                            </i>\n                        </div>\n                        <div class=\"hg-record-row\" data-kid=\"1-9-1-1-2-1-6\" data-name=\"record entry row 2026\">\n                            <time data-kid=\"1-9-1-1-2-1-6-1\" data-name=\"record date\">\n                                2026\n                            </time>\n                            <div class=\"hg-record-copy\" data-kid=\"1-9-1-1-2-1-6-2\" data-name=\"record content\">\n                                Evening log\n                                <small data-kid=\"1-9-1-1-2-1-6-2-1\" data-name=\"record description\">\n                                    mood, pain, water, notes\n                                </small>\n                            </div>\n                            <i class=\"hg-record-dot\" data-kid=\"1-9-1-1-2-1-6-3\" data-name=\"record dot icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"hg-climax-canvas\" data-kid=\"1-9-1-1-2-2\" data-name=\"climax canvas\">\n                        <div class=\"hg-depth-a\" data-kid=\"1-9-1-1-2-2-1\" data-name=\"climax depth layer a\">\n                        </div>\n                        <div class=\"hg-depth-b\" data-kid=\"1-9-1-1-2-2-2\" data-name=\"climax depth layer b\">\n                        </div>\n                        <svg aria-label=\"Medical records connecting into HealthGraph\" class=\"hg-climax-graph\" data-kid=\"1-9-1-1-2-2-3\" data-name=\"climax graph visualization\" role=\"img\" viewbox=\"0 0 420 405\">\n                            <g id=\"climaxGraphGroup\">\n                                <path class=\"hg-climax-edge\" d=\"M46 76 C108 76 126 122 181 142\">\n                                </path>\n                                <path class=\"hg-climax-edge\" d=\"M48 210 C102 197 125 165 181 142\">\n                                </path>\n                                <path class=\"hg-climax-edge\" d=\"M47 318 C110 315 133 242 181 218\">\n                                </path>\n                                <path class=\"hg-climax-edge\" d=\"M181 142 C228 133 253 152 297 185\">\n                                </path>\n                                <path class=\"hg-climax-edge\" d=\"M181 218 C231 219 250 199 297 185\">\n                                </path>\n                                <path class=\"hg-climax-edge\" d=\"M297 185 C325 191 340 222 367 245\">\n                                </path>\n                                <path class=\"hg-climax-edge\" d=\"M297 185 C325 165 338 133 362 109\">\n                                </path>\n                                <g class=\"hg-climax-node\" transform=\"translate(46 76)\">\n                                    <circle class=\"node-halo\" r=\"17\">\n                                    </circle>\n                                    <circle class=\"node-core\" r=\"5\">\n                                    </circle>\n                                    <text class=\"node-date\" x=\"-8\" y=\"-15\">\n                                        2018\n                                    </text>\n                                    <text x=\"12\" y=\"4\">\n                                        record\n                                    </text>\n                                </g>\n                                <g class=\"hg-climax-node\" transform=\"translate(48 210)\">\n                                    <circle class=\"node-halo\" r=\"17\">\n                                    </circle>\n                                    <circle class=\"node-core\" r=\"5\">\n                                    </circle>\n                                    <text class=\"node-date\" x=\"-8\" y=\"-15\">\n                                        2021\n                                    </text>\n                                    <text x=\"12\" y=\"4\">\n                                        panel\n                                    </text>\n                                </g>\n                                <g class=\"hg-climax-node\" transform=\"translate(47 318)\">\n                                    <circle class=\"node-halo\" r=\"17\">\n                                    </circle>\n                                    <circle class=\"node-core\" r=\"5\">\n                                    </circle>\n                                    <text class=\"node-date\" x=\"-8\" y=\"-15\">\n                                        2024\n                                    </text>\n                                    <text x=\"12\" y=\"4\">\n                                        pulse\n                                    </text>\n                                </g>\n                                <g class=\"hg-climax-node\" transform=\"translate(181 142)\">\n                                    <circle class=\"node-halo\" r=\"18\">\n                                    </circle>\n                                    <circle class=\"node-core\" r=\"6\">\n                                    </circle>\n                                    <text x=\"11\" y=\"4\">\n                                        timeline\n                                    </text>\n                                </g>\n                                <g class=\"hg-climax-node\" transform=\"translate(181 218)\">\n                                    <circle class=\"node-halo\" r=\"18\">\n                                    </circle>\n                                    <circle class=\"node-core\" r=\"6\">\n                                    </circle>\n                                    <text x=\"11\" y=\"4\">\n                                        daily log\n                                    </text>\n                                </g>\n                                <g class=\"hg-climax-node\" transform=\"translate(297 185)\">\n                                    <circle class=\"node-halo\" r=\"23\">\n                                    </circle>\n                                    <circle class=\"node-core\" r=\"7\">\n                                    </circle>\n                                    <text x=\"-27\" y=\"-31\">\n                                        HealthGraph\n                                    </text>\n                                </g>\n                                <g class=\"hg-climax-node\" transform=\"translate(367 245)\">\n                                    <circle class=\"node-halo\" r=\"17\">\n                                    </circle>\n                                    <circle class=\"node-core\" r=\"5\">\n                                    </circle>\n                                    <text x=\"-21\" y=\"-15\">\n                                        heart\n                                    </text>\n                                </g>\n                                <g class=\"hg-climax-node\" transform=\"translate(362 109)\">\n                                    <circle class=\"node-halo\" r=\"17\">\n                                    </circle>\n                                    <circle class=\"node-core\" r=\"5\">\n                                    </circle>\n                                    <text x=\"-26\" y=\"-15\">\n                                        sleep\n                                    </text>\n                                </g>\n                            </g>\n                        </svg>\n                    </div>\n                    <div class=\"hg-body-view\" data-kid=\"1-9-1-1-2-3\" data-name=\"body view container\">\n                        <div class=\"hg-body-visual\" data-kid=\"1-9-1-1-2-3-1\" data-name=\"body visual content\">\n                            <div class=\"hg-body-shadow\" data-kid=\"1-9-1-1-2-3-1-1\" data-name=\"body visual shadow\">\n                                <svg data-kid=\"1-9-1-1-2-3-1-1-1\" height=\"392\" viewbox=\"0 0 210 392\" width=\"210\">\n                                    <path class=\"hg-body-outline\" d=\"M105 28 C87 28 76 42 77 60 C78 77 88 88 105 88 C122 88 132 77 133 60 C134 42 123 28 105 28 Z M73 101 C58 112 52 139 54 177 L65 244 L80 244 L84 183 L87 270 L69 357 L90 357 L105 281 L120 357 L141 357 L123 270 L126 183 L130 244 L145 244 L156 177 C158 139 152 112 137 101 C128 95 119 91 105 91 C91 91 82 95 73 101 Z\" transform=\"translate(9 0)\">\n                                    </path>\n                                </svg>\n                            </div>\n                            <svg aria-label=\"Stylized 3D human body with connected regions\" class=\"hg-body-svg\" data-kid=\"1-9-1-1-2-3-1-2\" data-name=\"body visualization svg\" role=\"img\" viewbox=\"0 0 210 392\">\n                                <defs>\n                                    <filter height=\"340%\" id=\"hgBodyGlow\" width=\"340%\" x=\"-120%\" y=\"-120%\">\n                                        <fegaussianblur result=\"blur\" stddeviation=\"4\">\n                                        </fegaussianblur>\n                                        <femerge>\n                                            <femergenode in=\"blur\">\n                                            </femergenode>\n                                            <femergenode in=\"SourceGraphic\">\n                                            </femergenode>\n                                        </femerge>\n                                    </filter>\n                                </defs>\n                                <circle class=\"hg-body-ring\" cx=\"105\" cy=\"196\" r=\"155\">\n                                </circle>\n                                <circle class=\"hg-body-ring\" cx=\"105\" cy=\"196\" r=\"132\">\n                                </circle>\n                                <path class=\"hg-body-outline\" d=\"M105 28 C87 28 76 42 77 60 C78 77 88 88 105 88 C122 88 132 77 133 60 C134 42 123 28 105 28 Z M73 101 C58 112 52 139 54 177 L65 244 L80 244 L84 183 L87 270 L69 357 L90 357 L105 281 L120 357 L141 357 L123 270 L126 183 L130 244 L145 244 L156 177 C158 139 152 112 137 101 C128 95 119 91 105 91 C91 91 82 95 73 101 Z\">\n                                </path>\n                                <path class=\"hg-body-highlight\" d=\"M87 106 C96 116 114 116 123 106 M105 115 L105 267 M78 150 C92 161 118 161 132 150 M88 211 C97 218 113 218 122 211\">\n                                </path>\n                                <circle class=\"hg-body-region\" cx=\"105\" cy=\"59\" data-region=\"head\" r=\"12\">\n                                </circle>\n                                <circle class=\"hg-body-region alert\" cx=\"105\" cy=\"153\" data-region=\"heart\" r=\"13\">\n                                </circle>\n                                <circle class=\"hg-body-region\" cx=\"105\" cy=\"208\" data-region=\"abdomen\" r=\"15\">\n                                </circle>\n                                <circle class=\"hg-body-region\" cx=\"87\" cy=\"271\" data-region=\"knee\" r=\"10\">\n                                </circle>\n                            </svg>\n                            <div class=\"hg-body-caption\" data-kid=\"1-9-1-1-2-3-1-3\" data-name=\"body caption text\">\n                                The graph enters the body as a set of connected places, not a diagnosis.\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"hg-climax-bridge\" data-kid=\"1-9-1-1-3\" data-name=\"climax bridge message\">\n                    <strong data-kid=\"1-9-1-1-3-1\">\n                        Your medical history isn't scattered records. It's one connected picture of your health.\n                    </strong>\n                    <span data-kid=\"1-9-1-1-3-2\">\n                        Records → relationships → the body you can walk through.\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"hg-pricing\" data-graph-step=\"7\" data-kid=\"1-10\" data-name=\"pricing section\" id=\"pricing\">\n        <div class=\"wrap\" data-kid=\"1-10-1\" data-name=\"pricing wrap\">\n            <div class=\"hg-pricing-head\" data-kid=\"1-10-1-1\" data-name=\"pricing head section\">\n                <div class=\"hg-act-number\" data-kid=\"1-10-1-1-1\" style=\"color:var(--fog)\">\n                    <b data-kid=\"1-10-1-1-1-1\" style=\"color:var(--teal)\">\n                        08\n                    </b>\n                    / PRICING\n                </div>\n                <div data-kid=\"1-10-1-1-2\">\n                    <div class=\"eyebrow\" data-kid=\"1-10-1-1-2-1\">\n                        One connected picture\n                    </div>\n                    <h2 data-kid=\"1-10-1-1-2-2\">\n                        Start with the record.\n                        <span class=\"serif\" data-kid=\"1-10-1-1-2-2-1\">\n                            Keep it yours.\n                        </span>\n                    </h2>\n                    <p data-kid=\"1-10-1-1-2-3\">\n                        Early access is free across iOS and Android. A Premium tier with deeper history and family sharing is planned for later, and early users will keep a founding discount when it arrives.\n                    </p>\n                </div>\n            </div>\n            <div class=\"hg-plan-grid\" data-kid=\"1-10-1-2\" data-name=\"pricing plan grid\">\n                <article class=\"hg-plan primary\" data-kid=\"1-10-1-2-1\" data-name=\"early access plan card\">\n                    <div class=\"hg-plan-label\" data-kid=\"1-10-1-2-1-1\">\n                        Early access\n                    </div>\n                    <h3 data-kid=\"1-10-1-2-1-2\">\n                        HealthGraph, while it is free.\n                    </h3>\n                    <div class=\"hg-plan-price\" data-kid=\"1-10-1-2-1-3\">\n                        Free\n                    </div>\n                    <p data-kid=\"1-10-1-2-1-4\">\n                        Food scanning, both pulse methods, health chat, the dial, and your connected history. One email opens, addressed and ready; we reply with your invite link.\n                    </p>\n                    <a class=\"hg-button\" data-kid=\"1-10-1-2-1-5\" href=\"mailto:hello@healthgraph.app?subject=HealthGraph%20early%20access\" style=\"background:var(--cta);color:var(--paper)!important\">\n                        Get HealthGraph free\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-10-1-2-1-5-1\">\n                        </i>\n                    </a>\n                </article>\n                <article class=\"hg-plan secondary\" data-kid=\"1-10-1-2-2\" data-name=\"premium plan card\">\n                    <div class=\"hg-plan-label\" data-kid=\"1-10-1-2-2-1\">\n                        Later\n                    </div>\n                    <h3 data-kid=\"1-10-1-2-2-2\">\n                        Premium\n                    </h3>\n                    <div class=\"hg-plan-price\" data-kid=\"1-10-1-2-2-3\">\n                        Planned later\n                    </div>\n                    <p data-kid=\"1-10-1-2-2-4\">\n                        Deeper history and family sharing are planned. No price is being invented before the product is ready.\n                    </p>\n                </article>\n            </div>\n        </div>\n    </section>\n    <footer class=\"hg-footer\" data-kid=\"1-11\">\n        <div class=\"wrap\" data-kid=\"1-11-1\">\n            <div class=\"hg-footer-top\" data-kid=\"1-11-1-1\">\n                <a class=\"hg-brand\" data-kid=\"1-11-1-1-1\" href=\"#top\">\n                    <span aria-hidden=\"true\" class=\"hg-mark\" data-kid=\"1-11-1-1-1-1\">\n                    </span>\n                    <span data-kid=\"1-11-1-1-1-2\">\n                        HealthGraph\n                    </span>\n                </a>\n                <div class=\"hg-colophon\" data-kid=\"1-11-1-1-2\">\n                    Set in Poppins, with an italic serif for emphasis. One HTML file, no trackers, no cookies.\n                    <br data-kid=\"1-11-1-1-2-1\"/>\n                    © 2026 HealthGraph.\n                </div>\n            </div>\n            <p class=\"hg-disclaimer\" data-kid=\"1-11-1-2\">\n                HealthGraph is a wellness companion, not a medical device. Everything on this page and in the app is informational only and never medical advice, diagnosis, or treatment. Consult a qualified clinician about any health concern.\n            </p>\n        </div>\n    </footer>\n</main>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n</script>\n<script>\n    (function () {\n  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  var page = document.querySelector('.hg-page');\n  if (!page) return;\n\n  var systemNodes = Array.prototype.slice.call(document.querySelectorAll('.hg-system-node'));\n  var systemEdges = Array.prototype.slice.call(document.querySelectorAll('.hg-system-edge'));\n  var revealedNodes = [];\n  var revealedEdges = [];\n  systemEdges.forEach(function (path) {\n    if (path.getTotalLength) {\n      var length = path.getTotalLength();\n      path.style.strokeDasharray = length;\n      path.style.strokeDashoffset = length;\n      path.dataset.length = length;\n    }\n  });\n\n  function revealTo(stage) {\n    systemEdges.forEach(function (edge) {\n      if (Number(edge.dataset.edgeStep) <= stage && revealedEdges.indexOf(edge) === -1) {\n        revealedEdges.push(edge);\n        gsap.to(edge, { strokeDashoffset: 0, duration: reduceMotion ? 0 : .72, ease: 'power2.out' });\n      }\n    });\n    systemNodes.forEach(function (node) {\n      if (Number(node.dataset.nodeStep) <= stage && revealedNodes.indexOf(node) === -1) {\n        revealedNodes.push(node);\n        if (reduceMotion) {\n          gsap.set(node, { autoAlpha: 1, scale: 1 });\n          return;\n        }\n        gsap.fromTo(node, { autoAlpha: 0, scale: .05 }, { autoAlpha: 1, scale: 1, duration: .68, ease: 'back.out(1.55)' });\n        var halo = node.querySelector('.hg-node-halo');\n        if (halo) gsap.fromTo(halo, { scale: .2, autoAlpha: 0 }, { scale: 1.45, autoAlpha: .75, duration: .4, yoyo: true, repeat: 1, ease: 'sine.out' });\n      }\n    });\n  }\n  revealTo(0);\n\n  if (!reduceMotion) {\n    document.querySelectorAll('.graph-chapter').forEach(function (chapter) {\n      var step = Number(chapter.dataset.graphStep || 0);\n      if (step > 0) {\n        ScrollTrigger.create({ trigger: chapter, start: 'top 72%', onEnter: function () { revealTo(step); }, onEnterBack: function () { revealTo(step); } });\n      }\n    });\n  } else {\n    revealTo(7);\n  }\n\n  var systemX = gsap.quickTo('.hg-system', 'x', { duration: .9, ease: 'power3.out' });\n  var systemY = gsap.quickTo('.hg-system', 'y', { duration: .9, ease: 'power3.out' });\n  var bodyRotate = gsap.quickTo('.hg-body-visual', 'rotationY', { duration: 1.1, ease: 'power3.out' });\n  var depthX = gsap.quickTo('.hg-depth-a', 'x', { duration: 1.2, ease: 'power3.out' });\n  var depthY = gsap.quickTo('.hg-depth-b', 'y', { duration: 1.2, ease: 'power3.out' });\n  if (!reduceMotion) {\n    window.addEventListener('pointermove', function (event) {\n      var x = (event.clientX / window.innerWidth - .5);\n      var y = (event.clientY / window.innerHeight - .5);\n      systemX(x * 10);\n      systemY(y * 8);\n      bodyRotate(x * 3);\n      depthX(x * -14);\n      depthY(y * 10);\n    }, { passive: true });\n  }\n\n  var railButtons = document.querySelectorAll('.hg-rail button');\n  var ledgerRows = document.querySelectorAll('.hg-ledger-row');\n  railButtons.forEach(function (button) {\n    button.addEventListener('click', function () {\n      var id = button.getAttribute('data-row');\n      railButtons.forEach(function (item) { item.setAttribute('aria-pressed', item === button ? 'true' : 'false'); });\n      ledgerRows.forEach(function (row) { row.classList.toggle('is-selected', row.id === id); });\n      var target = document.getElementById(id);\n      if (target) target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });\n    });\n  });\n\n  var phaseCopy = [\n    'Sleep, energy, water, stress, movement, wellbeing, pain, meals, heart, and doses each get a spoke, and each spoke sits inside its healthy band or steps outside it where you can see it happen.',\n    'Every spoke lands where the latest logs would put it. The count in the middle is simply how many spokes sit inside their bands right now.',\n    'This is the same dial that lives in the app, replaying any of the last thirty days from the slider under it. The chapters below walk through everything feeding it.'\n  ];\n  var phaseButtons = document.querySelectorAll('.hg-phase button');\n  var dialCopy = document.getElementById('dialCopy');\n  var dialCenter = document.getElementById('dialCenter');\n  var dialBand = document.getElementById('dialBand');\n  phaseButtons.forEach(function (button) {\n    button.addEventListener('click', function () {\n      var phase = Number(button.getAttribute('data-phase'));\n      phaseButtons.forEach(function (item) { item.setAttribute('aria-pressed', item === button ? 'true' : 'false'); });\n      dialCopy.textContent = phaseCopy[phase];\n      dialCenter.textContent = phase === 0 ? '8' : phase === 1 ? '7' : '6';\n      dialBand.style.strokeDashoffset = phase === 0 ? '255' : phase === 1 ? '340' : '440';\n    });\n  });\n\n  var pulse = document.getElementById('pulsePath');\n  if (pulse && pulse.getTotalLength) {\n    var pulseLength = pulse.getTotalLength();\n    gsap.set(pulse, { strokeDasharray: pulseLength, strokeDashoffset: reduceMotion ? 0 : pulseLength });\n    if (reduceMotion) {\n      gsap.set(pulse, { strokeDashoffset: 0 });\n    } else {\n      ScrollTrigger.create({ trigger: pulse, start: 'top 80%', once: true, onEnter: function () { gsap.to(pulse, { strokeDashoffset: 0, duration: 1.25, ease: 'power2.out' }); } });\n    }\n  }\n\n  document.querySelectorAll('.hg-faq-q').forEach(function (button) {\n    button.addEventListener('click', function () {\n      var item = button.parentElement;\n      var open = item.classList.contains('is-open');\n      document.querySelectorAll('.hg-faq-item.is-open').forEach(function (other) {\n        other.classList.remove('is-open');\n        other.querySelector('.hg-faq-q').setAttribute('aria-expanded', 'false');\n      });\n      if (!open) { item.classList.add('is-open'); button.setAttribute('aria-expanded', 'true'); }\n    });\n  });\n\n  var climax = document.querySelector('.hg-climax');\n  var climaxRecords = document.querySelectorAll('.hg-record-row');\n  var climaxNodes = document.querySelectorAll('.hg-climax-node');\n  var climaxEdges = document.querySelectorAll('.hg-climax-edge');\n  var bodyConnectors = document.querySelectorAll('.hg-body-connector');\n  var recordsLine = document.querySelector('.hg-records-line');\n  var bridge = document.querySelector('.hg-climax-bridge');\n  var climaxPhase = document.getElementById('climaxPhase');\n  climaxEdges.forEach(function (path) {\n    if (path.getTotalLength) {\n      var length = path.getTotalLength();\n      path.style.strokeDasharray = length;\n      path.style.strokeDashoffset = length;\n    }\n  });\n\n  function showClimaxStatic() {\n    gsap.set(climaxRecords, { autoAlpha: 1, x: 0 });\n    gsap.set(recordsLine, { scaleY: 1 });\n    gsap.set(climaxEdges, { strokeDashoffset: 0 });\n    gsap.set(climaxNodes, { autoAlpha: 1, scale: 1 });\n    gsap.set('.hg-body-region', { autoAlpha: .95, scale: 1.1 });\n    gsap.set(bridge, { autoAlpha: 1, y: 0 });\n    if (climaxPhase) climaxPhase.textContent = 'records / connections / body';\n  }\n\n  if (climax) {\n    if (reduceMotion || window.matchMedia('(max-width: 759px)').matches) {\n      ScrollTrigger.create({ trigger: climax, start: 'top 75%', once: true, onEnter: showClimaxStatic });\n    } else {\n      var climaxTimeline = gsap.timeline({\n        scrollTrigger: { trigger: climax, start: 'top top', end: '+=1900', pin: true, scrub: 1, anticipatePin: 1, invalidateOnRefresh: true, onUpdate: function (self) { if (!climaxPhase) return; climaxPhase.textContent = self.progress < .28 ? 'records / being gathered' : self.progress < .68 ? 'connections / taking shape' : 'body / one connected picture'; } }\n      });\n      climaxTimeline\n        .fromTo(climaxRecords, { autoAlpha: 0, x: -22 }, { autoAlpha: 1, x: 0, stagger: .15, duration: .55, ease: 'power2.out' }, 0)\n        .to(recordsLine, { scaleY: 1, duration: 1.1, ease: 'none' }, .05)\n        .to(climaxEdges, { strokeDashoffset: 0, stagger: .14, duration: .62, ease: 'none' }, .55)\n        .fromTo(climaxNodes, { autoAlpha: 0, scale: .04 }, { autoAlpha: 1, scale: 1, stagger: .13, duration: .62, ease: 'back.out(1.7)' }, 1.0)\n        .to('#climaxGraphGroup', { x: 83, y: 6, scale: .84, duration: 1.25, ease: 'power2.inOut' }, 2.45)\n        .to('.hg-body-region', { autoAlpha: .95, scale: 1.15, stagger: .18, duration: .56, ease: 'back.out(1.4)' }, 2.9)\n        .fromTo(bridge, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: .62, ease: 'power2.out' }, 3.55);\n    }\n  }\n\n  window.addEventListener('load', function () { ScrollTrigger.refresh(); });\n})();\n</script>\n",
