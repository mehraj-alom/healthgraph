# Frontend environment (Expo public vars — safe to embed in the client).
# Copy to `.env` next to this file for local dev. EAS builds take these
# from EAS secrets / build env instead.

# Backend API base URL.
EXPO_PUBLIC_API_URL="https://api-47b3.getvoroa.com"

# Static runtime-asset host (public .glb + .onnx, no auth, no health data).
# Default (no var needed): the public GitHub Release
#   https://github.com/mehraj-alom/healthgraph-assets/releases/tag/healthgraph-assets-v1
# To migrate hosts later (R2/CDN), set either var to the new base — asset
# paths stay identical, no code change required.
# EXPO_PUBLIC_ASSET_CDN_URL="https://your-cdn.example.com/healthgraph-assets-v1"
# EXPO_PUBLIC_ANATOMY_CDN_URL="https://your-cdn.example.com/healthgraph-assets-v1"

# rPPG Inference Backend (optional — enables cloud inference instead of on-device)
# Set to "true" to route rPPG inference to backend service.
# EXPO_PUBLIC_RPPG_USE_BACKEND="true"
# Base URL of the rPPG inference API (FastAPI + ONNX Runtime).
# EXPO_PUBLIC_RPPG_BACKEND_URL="http://localhost:8080"
