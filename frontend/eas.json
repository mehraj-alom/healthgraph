{
  "cli": {
    "version": ">= 23.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ASSET_CDN_URL": "https://github.com/mehraj-alom/healthgraph-assets/releases/download/healthgraph-assets-v1",
        "EXPO_PUBLIC_ANATOMY_CDN_URL": "https://github.com/mehraj-alom/healthgraph-assets/releases/download/healthgraph-assets-v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.healthgraph.shop",
        "EXPO_PUBLIC_ASSET_CDN_URL": "https://github.com/mehraj-alom/healthgraph-assets/releases/download/healthgraph-assets-v1",
        "EXPO_PUBLIC_ANATOMY_CDN_URL": "https://github.com/mehraj-alom/healthgraph-assets/releases/download/healthgraph-assets-v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.healthgraph.shop",
        "EXPO_PUBLIC_ASSET_CDN_URL": "https://github.com/mehraj-alom/healthgraph-assets/releases/download/healthgraph-assets-v1",
        "EXPO_PUBLIC_ANATOMY_CDN_URL": "https://github.com/mehraj-alom/healthgraph-assets/releases/download/healthgraph-assets-v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
