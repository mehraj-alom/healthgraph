{
  "expo": {
    "name": "HealthGraph",
    "description": "Gesundheit, verbunden: Puls per Kamera, Schlaf, Medikamente, Ernährung, Zyklus – ein Graph. Health, connected.",
    "slug": "medgraph",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/app-load.mp4",
      "assets/audio/*",
      "assets/voices/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medgraph.app",
      "infoPlist": {
        "CFBundleDisplayName": "HealthGraph",
        "NSCameraUsageDescription": "Puls per Kamera messen und Dokumente scannen. Face pulse is computed on-device, frames never stored. / Kamera-Puls und Dokumenten-Scan, direkt am Gerät.",
        "NSMicrophoneUsageDescription": "Voice check-ins und Sprach-Alarme. / Voice check-ins and spoken alarms.",
        "NSHealthUpdateUsageDescription": "HealthGraph liest Trainings- und Schlafdaten nur mit deiner Erlaubnis. / Reads workouts and sleep only with permission.",
        "NSHealthShareUsageDescription": "HealthGraph schreibt Messwerte nur mit deiner Erlaubnis. / Writes vitals only with permission.",
        "CFBundleLocalizations": ["en", "de"],
        "CFBundleDevelopmentRegion": "de"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.medgraph.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "./modules/healthgraph-ppg/app.plugin.js",
      "./modules/healthgraph-rppg/app.plugin.js",
      "onnxruntime-react-native",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      [
        "expo-dev-client",
        {
          "urlScheme": "medgraph"
        }
      ],
      "expo-video",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withArm64Abi.js",
      "expo-sharing",
      "expo-audio",
      "react-native-health-connect"
    ],
    "extra": {
      "eas": {
        "projectId": "b2d437a4-b219-488c-bc93-25bc41ab6445"
      }
    }
  }
}
