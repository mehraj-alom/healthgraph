

# Firebase Admin SDK credentials file path
FIREBASE_CREDENTIALS_PATH="firebase_credentials.json"

# PostgreSQL database connection
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/medgraph_db"
ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/medgraph_db"

# Firebase Web API Key (for frontend)
FIREBASE_WEB_API_KEY="YOUR_FIREBASE_WEB_API_KEY"

# LandingAI document extraction
LANDINGAI_API_KEY="YOUR_LANDINGAI_API_KEY"

# AI Credits / OpenAI-compatible API
AICREDITS_API_KEY="YOUR_AICREDITS_API_KEY"
OPENAI_API_BASE="https://api.aicredits.in/v1"

# Neo4j Graph Database
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="YOUR_NEO4J_PASSWORD"
NEO4J_DATABASE="healthgraph"

# Qdrant Vector Database
QDRANT_API_KEY="YOUR_QDRANT_API_KEY"
QDRANT_URL="https://YOUR_QDRANT_URL"

# OpenRouter LLM API
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="z-ai/glm-5.2:free"

# Application
secret_key="YOUR_SECRET_KEY"
GOOGLE_CLOUD_PROJECT="YOUR_GCP_PROJECT_ID"

# CORS origins (comma-separated, for browser-based access only)
# React Native/Expo does not need CORS configuration.
# Example: CORS_ORIGINS="http://localhost:3000,https://admin.example.com"
CORS_ORIGINS=""
