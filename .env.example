# ==============================================================================
# HealthGraph/MedGraph backend — environment variables (example file)
# ==============================================================================
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#
# Voroa deployment notes:
#   * The API service listens on the port injected as $PORT (see Dockerfile).
#   * The Celery worker and beat run as separate Voroa background services
#     using the same Docker image (override CMD in the service config).
#   * The per-container filesystem is wiped on every deploy and is NOT shared
#     between the API and worker containers. Uploaded documents are therefore
#     stored in PostgreSQL (document_blobs table), not on disk.
# ==============================================================================

# --- Application ---
# Runtime environment: local | preview | production. Local is the default;
# preview/production must be set explicitly. Production enables hard
# startup gates (secret, Firebase, non-local DB, real USDA key).
APP_ENV="local"
# Web API key for the Firebase client SDK (used by the frontend / auth flows).
FIREBASE_WEB_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
# GCP project id. MUST match the `project_id` in the Firebase service account.
GOOGLE_CLOUD_PROJECT="YOUR_GCP_PROJECT_ID"
# AES key seed used for de-identification of extracted text. Keep it secret.
secret_key="YOUR_SECRET_KEY"
# Optional dedicated at-rest document-encryption key (base64 of 32 bytes).
# When empty, derived from secret_key. Production SHOULD set it so document
# ciphertext survives a secret_key rotation.
DOC_ENCRYPTION_KEY=""
# Trust X-Forwarded-For for rate-limit IPs ONLY behind a trusted proxy that
# strips client-supplied values. Default False (peer address, unspoofable).
RATE_LIMIT_TRUST_PROXY_HEADERS="False"

# --- Firebase Admin SDK ---
# Two options (at least one must be provided for auth to work):
#   1) File path to a service-account JSON (mounted secret).
FIREBASE_CREDENTIALS_PATH="/run/secrets/firebase_credentials.json"
#   2) The serialized service-account JSON inline (Voroa env-var secret).
#      Starts with "{". Preferred when a file cannot be mounted.
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"..."}'
#
# If neither is set, startup FAILS FAST with a clear error (there is no
# silent ADC fallback — default credentials do not exist on Voroa).

# --- PostgreSQL (managed database) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require"
ASYNC_DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require"

# --- Celery (broker + result backend; same Redis is used for pipeline logs) ---
CELERY_BROKER_URL="rediss://user:token@HOST:6379/0"
CELERY_RESULT_BACKEND="rediss://user:token@HOST:6379/0"
# Local-dev fallback only (used when CELERY_BROKER_URL is unset):
REDIS_HOST="redis"
REDIS_PORT="6379"

# --- Neo4j (Aura graph database) ---
NEO4J_URI="neo4j+s://HOST.databases.neo4j.io:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="YOUR_NEO4J_PASSWORD"
NEO4J_DATABASE="healthgraph"

# --- Qdrant (vector database; cloud or self-hosted) ---
QDRANT_URL="https://YOUR_QDRANT_CLOUD_URL:6333"
QDRANT_API_KEY="YOUR_QDRANT_API_KEY"
QDRANT_COLLECTION_NAME="healthgraph-collection"
# Self-hosted fallback (used when QDRANT_URL/QDRANT_API_KEY are unset):
QDRANT_HOST="localhost"
QDRANT_PORT="6333"

# --- LLMs ---
# OpenRouter (agent orchestrator / chat)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="z-ai/glm-5.2:free"
# OpenAI-compatible embeddings (evidence retrieval / vector indexing)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_API_BASE="https://api.aicredits.in/v1"
EMBEDDING_BASE_URL="https://api.aicredits.in/v1"
# Food-scan nutrition (AICredits gateway → GPT-4o vision; same wallet as above)
AICREDITS_API_KEY="YOUR_AICREDITS_API_KEY"
AICREDITS_BASE_URL="https://api.aicredits.in/v1"
AICREDITS_MODEL="openai/gpt-4o"
# USDA FoodData Central (free key) for calorie/nutrient lookup
USDA_API_KEY="YOUR_USDA_API_KEY"

# --- Document OCR / extraction ---
VISION_AGENT_API_KEY="YOUR_VISION_AGENT_API_KEY"
# LandingAI ADE API key for document classification (and OCR extraction).
# ADE keys are "user:password" pairs; the API authenticates the base64-encoded
# pair as the Authorization Bearer token. Either the raw "user:password" or the
# base64-encoded value works (the code normalizes it).
LANDINGAI_API_KEY="YOUR_LANDINGAI_API_KEY"
# Classification model version for the landingai ADE Classify API.
# Defaults to "classify-latest"; pin a dated version in production.
ADE_CLASSIFY_MODEL="classify-latest"
# Extraction model + prompt hash recorded per raw_extraction row (P0 pipeline
# versioning). Pin both in production so extractions stay reproducible.
ADE_EXTRACTION_MODEL="dpt-3-pro-latest"
EXTRACTION_PROMPT_HASH=""
# P0 Concept-lite: project (Event)-[:HAS_CODE]->(Concept) edges into Neo4j.
# Default off until terminology coverage is validated. Concept nodes are
# shared reference data and TERMINAL for traversal (never cross-patient).
GRAPH_CONCEPT_EDGES_ENABLED="false"

# --- CORS ---
# Comma-separated allowed origins, for browser-based clients only.
# React Native/Expo does not enforce CORS. Empty = most restrictive.
CORS_ORIGINS=""

# --- Storage (optional) ---
# Only used as a scratch directory to materialize documents temporarily
# during OCR. Durable document bytes live in PostgreSQL; nothing durable
# should ever be written here.
STORAGE_DIR="./storage/documents"

# --- Play billing (optional until launch) ---
# Android package name must match the Play Console app + the EAS build.
# The service-account JSON (Android Publisher scope) backs POST
# /api/v1/billing/verify. Without both, the endpoint answers 503 and the
# app stays on Free — never grant entitlement unverified.
ANDROID_PACKAGE_NAME=""
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""