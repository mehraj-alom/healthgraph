  "cards": [
    {
      "dot": "emerald",
      "title": "High level",
      "items": [
        "Browser -> API -> Redis is attempted first on every read",
        "PostgreSQL is touched only after a Redis miss"
      ]
    },
    {
      "dot": "rose",
      "title": "Function by function",
      "items": [
        "getResource() owns the whole fallback: get, miss, query, set, return",
        "The SET carries a TTL so the next identical read is a cache hit",
        "Return messages stay quieter than forward calls"
      ]
